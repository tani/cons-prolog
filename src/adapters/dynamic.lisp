(defpackage #:sprolog/src/adapters/dynamic (:use #:cl #:sprolog/src/adapters/adapter))
(in-package #:sprolog)

;;; Dynamic predicates use immutable clause/code snapshots (logical update view).
(defun iso-clause-parts (term)
  (let ((term (iso-required term)))
    (multiple-value-bind (f fields) (if (and (consp term) t)
                                     (values (car term) (cdr term)) (iso-parts term))
      (if (and (iso-rule-functor-p f) (= (length fields) 2))
          (values (iso-goal (first fields)) (second fields))
          (values (iso-goal term) (iso-atom "true"))))))
(defun iso-body-list (body)
  (let ((work (list body)) (result nil))
    (loop while work do
      (let* ((x (pop work)) (g (iso-goal x)))
        (if (and (string= (iso-predicate-name (car g) (length (cdr g))) ",") (= (length (cdr g)) 2))
            (progn (push (third g) work) (push (second g) work)) (push g result))))
    (nreverse result)))
(defun iso-body-term (body)
  (if (null body) (iso-atom "true")
      (reduce (lambda (a b) (iso-compound (iso-atom ",") a b))
              (mapcar (lambda (g) (if (host-goal-p g)
                                    (iso-error "permission_error" (iso-atom "access") (iso-atom "private_procedure") g)
                                    (cond ((symbolp g) g)
                                          ((null (cdr g)) (car g))
                                          (t g))))
                      body) :from-end t)))
(defun iso-publish (db key clauses)
  (incf (database-generation db))
  (setf (gethash key (database-predicates db))
        (make-predicate :clauses clauses :code (compile-predicate clauses))) t)
(defun iso-indicator (term)
  (let ((term (iso-required term)))
    (multiple-value-bind (f args) (if (and (consp term) t)
                                    (values (car term) (cdr term)) (iso-parts term))
      (unless (and (symbolp f) (string= (iso-text f) "/") (= (length args) 2))
        (iso-error "type_error" (iso-atom "predicate_indicator") term))
      (iso-text (first args)) (cons (first args) (iso-integer (second args) t)))))
(defun iso-check-modifiable (db key)
  (when (iso-builtin-p (car key) (cdr key))
    (iso-error "permission_error" (iso-atom "modify") (iso-atom "static_procedure")
               (iso-compound (iso-atom "/") (car key) (cdr key))))
  ;; Lisp-defined predicates remain writable, consistent with <- / <--.
  (setf (gethash key (iso-state-dynamic (iso-state-for db))) t))
(defun iso-modify (vm name term)
  (let ((db (machine-database vm)))
    (cond
      ((string= name "ABOLISH")
       (let* ((key (iso-indicator term)) (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key))))
         (iso-check-modifiable db key) (incf (database-generation db))
         (remhash key (database-predicates db)) (remhash key (database-tabled db)) t))
      ((string= name "%ENSURE_DYNAMIC")
       (let* ((head (iso-goal term)) (key (predicate-key head))
              (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key))))
         (iso-check-modifiable db key)
         (unless (gethash key (database-predicates db)) (iso-publish db key nil))
         t))
      (t (multiple-value-bind (head body) (iso-clause-parts term)
           ;; Reify stored variables with a single naming map across head and body.
           (let* ((clause (reify (cons head (iso-body-list body)))) (key (predicate-key head))
                  (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key)))
                  (p (gethash key (database-predicates db))))
             (iso-check-modifiable db key) (setf (caar clause) (car key))
             (iso-publish db key (if (string= name "ASSERTA")
                                    (cons clause (and p (predicate-clauses p)))
                                    (append (and p (predicate-clauses p)) (list clause))))))))))
(defun iso-clause-alternatives (vm name args)
  (let* ((db (machine-database vm)) (term (first args)) (head nil) (body nil))
    (if (member name '("CLAUSE" "%RETRACT_HEAD") :test #'string=)
        (setf head (iso-goal term)
              body (if (string= name "%RETRACT_HEAD") (iso-atom "true") (second args)))
        (multiple-value-setq (head body) (iso-clause-parts term)))
    (let* ((key (predicate-key head)) (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key)))
           (p (gethash key (database-predicates db))) (results nil))
      (when (iso-builtin-p (car key) (cdr key))
        (iso-error "permission_error" (iso-atom "access") (iso-atom "private_procedure") term))
      (dolist (clause (and p (copy-list (predicate-clauses p))))
        (let* ((copy (term-template
                      (cons (cdr (car clause))
                            (if (string= name "%RETRACT_HEAD") (iso-atom "true")
                                (iso-body-term (cdr clause))))
                      (make-hash-table :test 'eq) (list 0)))
               (max-index -1))
          (map-term copy (lambda (x) (when (slot-ref-p x) (setf max-index (max max-index (slot-ref-index x)))) x))
          (let* ((slots (make-array (1+ max-index))) (candidate nil))
            (dotimes (i (length slots)) (let ((v (%make-var i))) (setf (logic-var-binding v) v (aref slots i) v)))
            (setf candidate (instantiate copy slots))
            (when (iso-unifiable-p (cons (cdr head)
                                         (if (logic-var-p (deref body)) body (iso-body-term (iso-body-list body)))) candidate)
              (let ((h (cons (car head) (car candidate)))
                    (b (cdr candidate)))
                (push (iso-result
                       (cond ((string= name "CLAUSE") (list h b))
                             ((string= name "%RETRACT_HEAD") (list h))
                             (t
                           (list (multiple-value-bind (f aa) (values (car (deref term)) (cdr (deref term)))
                                   (if (and (iso-rule-functor-p f) (= (length aa) 2))
                                       (list f h b)
                                       h)))))
                       (when (member name '("RETRACT" "%RETRACT_HEAD") :test #'string=)
                         (let ((selected clause))
                           (lambda ()
                             (let ((current (gethash key (database-predicates db))))
                               (when (member selected (and current (predicate-clauses current)) :test #'eq)
                                 (iso-publish db key (remove selected (predicate-clauses current) :test #'eq :count 1))))))))
                      results))))))
      (nreverse results))))
