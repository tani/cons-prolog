(uiop:define-package #:sprolog/src/adapters/term-relations
  (:use #:cl)
  (:import-from #:sprolog/src/adapters/adapter #:iso-state-for #:iso-output-list #:iso-output-integer)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom #:iso-bind #:iso-error #:iso-required #:iso-integer #:iso-list #:iso-text #:iso-acyclic-p)
  (:import-from #:sprolog/src/kernel/engine #:deref #:unify #:fresh-var #:fresh-cons)
  (:import-from #:sprolog/src/kernel/model #:logic-var-p #:logic-var-id #:machine-database #:iso-state-order-ids)
  (:export #:iso-term-operation #:iso-term-compare))
(in-package #:sprolog/src/adapters/term-relations)

(defun order-id (vm x)
  (let ((ids (iso-state-order-ids (iso-state-for (machine-database vm)))))
    (or (gethash x ids) (setf (gethash x ids) (1+ (hash-table-count ids))))))
(defun term-rank (x)
  (cond ((logic-var-p x) 0) ((numberp x) 1) ((symbolp x) 2) ((consp x) 4) (t 3)))
(defun scalar-order (a b)
  (cond ((equal a b) 0) ((and (realp a) (realp b)) (cond ((= a b) 0) ((< a b) -1) (t 1)))
        ((string< a b) -1) (t 1)))
(defun number-kind (x)
  (cond ((integerp x) "integer") ((rationalp x) "ratio")
        ((floatp x) (symbol-name (type-of x))) (t "complex")))
(defun atomic-order (vm a b rank)
  (when (eql a b) (return-from atomic-order 0))
  (case rank
    (0 (let ((c (scalar-order (logic-var-id a) (logic-var-id b))))
         (if (zerop c) (scalar-order (order-id vm a) (order-id vm b)) c)))
    (1 (dolist (pair (list (cons (realpart a) (realpart b)) (cons (imagpart a) (imagpart b))))
         (let ((c (scalar-order (car pair) (cdr pair))))
           (unless (zerop c) (return-from atomic-order c))))
       (let ((c (scalar-order (number-kind a) (number-kind b))))
         (if (zerop c) (scalar-order (order-id vm a) (order-id vm b)) c)))
    (2 (dolist (pair (list (cons (symbol-name a) (symbol-name b))
                          (cons (if (symbol-package a) (package-name (symbol-package a)) "")
                                (if (symbol-package b) (package-name (symbol-package b)) ""))))
         (let ((c (scalar-order (car pair) (cdr pair))))
           (unless (zerop c) (return-from atomic-order c))))
       (scalar-order (order-id vm a) (order-id vm b)))
    (otherwise (scalar-order (order-id vm a) (order-id vm b)))))
(defun iso-term-compare (vm a b)
  "Iterative lexicographic order of acyclic, dereferenced cons graphs."
  (unless (and (iso-acyclic-p a) (iso-acyclic-p b))
    (iso-error "representation_error" (iso-atom "acyclic_term")))
  (let ((work (list (cons a b))) (seen (make-hash-table :test 'eq)))
    (loop while work do
      (let* ((pair (pop work)) (x (deref (car pair))) (y (deref (cdr pair)))
             (rx (term-rank x)) (ry (term-rank y)))
        (unless (eq x y)
          (unless (= rx ry) (return-from iso-term-compare (if (< rx ry) -1 1)))
          (if (consp x)
              (let ((partners (or (gethash x seen) (setf (gethash x seen) (make-hash-table :test 'eq)))))
                (unless (gethash y partners)
                  (setf (gethash y partners) t)
                  (push (cons (cdr x) (cdr y)) work) (push (cons (car x) (car y)) work)))
              (let ((c (atomic-order vm x y rx)))
                (unless (zerop c) (return-from iso-term-compare c))))))) 0))
(defun iso-term-operation (vm name args)
  (let ((a (first args)) (b (second args)) (c (third args)))
    (cond
      ((string= name "FUNCTOR")
       (iso-output-integer c t)
       (let ((x (deref a)))
         (if (logic-var-p x)
             (let ((n (iso-integer c t)) (f (iso-required b)))
               (cond ((zerop n)
                      (when (consp f) (iso-error "type_error" (iso-atom "atomic") f))
                      (unify vm a f))
                     ((and (= n 2) (symbolp f) (string= (iso-text f) "cons"))
                      (unify vm a (fresh-cons vm (fresh-var vm) (fresh-var vm))))
                     (t (iso-error "domain_error" (iso-atom "cons_functor") (list f n)))))
             (and (if (consp x) (iso-bind vm b (iso-atom "cons")) (unify vm b x))
                  (unify vm c (if (consp x) 2 0))))))
      ((string= name "ARG")
       (let ((n (iso-integer a t)) (x (iso-required b)))
         (unless (consp x) (iso-error "type_error" (iso-atom "compound") x))
         (case n (1 (unify vm c (car x))) (2 (unify vm c (cdr x))) (otherwise nil))))
      ((string= name "=..")
       (iso-output-list b)
       (let ((x (deref a)))
         (if (logic-var-p x)
             (let ((parts (iso-list b)))
               (cond ((= (length parts) 1)
                      (let ((f (iso-required (first parts))))
                        (when (consp f) (iso-error "type_error" (iso-atom "atomic") f))
                        (unify vm a f)))
                     ((and (= (length parts) 3) (string= (iso-text (first parts)) "cons"))
                      (unify vm a (fresh-cons vm (second parts) (third parts))))
                     (t (iso-error "domain_error" (iso-atom "cons_univ") b))))
             (unify vm b (if (consp x) (list (iso-atom "cons") (car x) (cdr x)) (list x))))))
      ((string= name "COMPARE")
       (unless (logic-var-p (deref a))
         (unless (member (iso-text a) '("<" "=" ">") :test #'string=)
           (iso-error "domain_error" (iso-atom "order") a)))
       (iso-bind vm a (iso-atom (case (iso-term-compare vm b c) (-1 "<") (0 "=") (t ">")))))
      ((member name '("SORT" "KEYSORT") :test #'string=)
       (iso-output-list b)
       (let* ((keyp (string= name "KEYSORT")) (items (iso-list a)))
         (dolist (item items)
           (let ((item (if keyp (iso-required item) (deref item))))
             (when (and keyp (not (consp item))) (iso-error "type_error" (iso-atom "pair") item))
             (iso-term-compare vm (if keyp (car item) item) (if keyp (car item) item))))
         (setf items (stable-sort items (lambda (x y) (< (iso-term-compare vm (if keyp (car (deref x)) x) (if keyp (car (deref y)) y)) 0))))
         (unless keyp
           (let ((result nil) (previous nil) (firstp t))
             (dolist (item items)
               (when (or firstp (not (zerop (iso-term-compare vm previous item))))
                 (push item result) (setf previous item firstp nil)))
             (setf items (nreverse result))))
         (unify vm b items)))
      (t (error "Unknown term operation ~A" name)))))
