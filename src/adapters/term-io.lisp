(uiop:define-package #:sprolog/src/adapters/term-io
  (:use #:cl)
  (:import-from #:sprolog/src/adapters/adapter #:iso-state-for #:iso-character #:iso-output-list #:iso-flag-value)
  (:import-from #:sprolog/src/adapters/streams #:iso-stream-for #:iso-options #:iso-option #:iso-boolean)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom #:iso-atom-name #:iso-compound #:iso-error #:iso-text #:iso-integer #:iso-list #:iso-required #:iso-list-from-host #:iso-empty-list #:iso-null-p)
  (:import-from #:sprolog/src/prolog/reader #:read-prolog-term)
  (:import-from #:sprolog/src/prolog/writer #:write-prolog-term)
  (:import-from #:sprolog/src/syntax/compiler #:variable-symbol-p)
  (:import-from #:sprolog/src/kernel/engine #:deref #:unify #:fresh-var #:fresh-cons #:map-term)
  (:import-from #:sprolog/src/kernel/model #:*term-model* #:$cons #:$nil #:logic-var-p #:machine-database #:iso-state-operators #:iso-state-conversions #:iso-stream-past-end #:iso-stream-eof-action)
  (:import-from #:sprolog/src/kernel/runtime #:iso-result)
  (:export #:iso-term-io #:iso-reader-state-results))
(in-package #:sprolog/src/adapters/term-io)

;; The textual reader's temporary package never escapes the stream adapter.
(uiop:define-package #:sprolog/prolog-io-atoms (:use))
(uiop:define-package #:sprolog/lisp-io-atoms (:use))

(defun lisp-input-atom (x)
  (cond ((and (eq *term-model* :iso) (symbolp x)
              (eq (symbol-package x) (find-package :sprolog/lisp-io-atoms)))
         (cond ((string-equal (symbol-name x) "$cons") '$cons)
               ((string-equal (symbol-name x) "$nil") '$nil)
               ((string-equal (symbol-name x) "nil") nil)
               (t (iso-atom (symbol-name x)))))
        ((and (symbolp x) (eq (symbol-package x) (find-package :sprolog/atoms)))
         (iso-atom (symbol-name x)))
        (t x)))
(defun lisp-output-atom (x)
  (if (and (eq *term-model* :iso) x (symbolp x))
      (cond ((eq x '$cons) (intern "$CONS" :sprolog/lisp-io-atoms))
            ((eq x '$nil) (intern "$NIL" :sprolog/lisp-io-atoms))
            (t (let ((name (iso-atom-name x)))
                 (intern name (if (member name '("$cons" "$nil") :test #'string-equal)
                                  :sprolog/atoms :sprolog/lisp-io-atoms)))))
      x))

(defun iso-reader-state-results (vm name args)
  (let ((state (iso-state-for (machine-database vm))) (results nil))
    (cond
      ((string= name "CURRENT_OP")
       (unless (logic-var-p (deref (first args)))
         (when (> (iso-integer (first args) t) 1200)
           (iso-error "domain_error" (iso-atom "operator_priority") (first args))))
       (unless (logic-var-p (deref (second args))) (operator-specifier (second args)))
       (unless (logic-var-p (deref (third args))) (iso-text (third args)))
       (maphash (lambda (key priority)
                  (push (iso-result (list priority (iso-atom (cdr key)) (iso-atom (car key)))) results))
                (iso-state-operators state)))
      (t
       (let ((input (deref (first args))) (output (deref (second args))))
         (unless (logic-var-p output) (iso-character output))
         (if (logic-var-p input)
             ;; Enumerate configured mappings, including explicitly stored identities.
             (maphash (lambda (a b) (push (iso-result (list (iso-atom (string a)) (iso-atom (string b)))) results))
                      (iso-state-conversions state))
             (let ((ch (iso-character input)))
               (push (iso-result (list input (iso-atom (string (gethash ch (iso-state-conversions state) ch))))) results))))))
    (nreverse results)))
(defun operator-specifier (term)
  (let ((text (iso-text term)))
    (unless (member text '("fx" "fy" "xf" "yf" "xfx" "xfy" "yfx") :test #'string=)
      (iso-error "domain_error" (iso-atom "operator_specifier") term)) text))
(defun operator-specifier-group (specifier)
  (cond ((member specifier '("fx" "fy") :test #'string=) '("fx" "fy"))
        ((member specifier '("xf" "yf") :test #'string=) '("xf" "yf"))
        (t '("xfx" "xfy" "yfx"))))
(defun read-lisp-term (vm stream target options)
  (let ((opts (iso-options options '("variables" "variable_names" "singletons")))
        (names (make-hash-table :test 'equal)) (counts (make-hash-table :test 'equal)) (order nil) (variables nil))
    (dolist (option opts) (iso-output-list (cdr option)))
    (multiple-value-bind (s meta) (iso-stream-for vm stream :input "text")
      (when (and (iso-stream-past-end meta) (string= (iso-stream-eof-action meta) "error"))
        (iso-error "permission_error" (iso-atom "input") (iso-atom "past_end_of_stream") stream))
      (let* ((*read-eval* nil) (*readtable* (let ((table (copy-readtable nil)))
                              (setf (readtable-case table) :preserve) table))
             (*package* (find-package (if (eq *term-model* :iso) :sprolog/lisp-io-atoms :sprolog/atoms)))
             (eof (gensym))
             (raw (handler-case (read s nil eof)
                    (error () (iso-error "syntax_error" (iso-atom "s_expression")))))
             (value
               (if (eq raw eof) (iso-atom "end_of_file")
                   (map-term raw
                    (lambda (x)
                      (if (and (symbolp x) (plusp (length (symbol-name x)))
                               (char= (char (symbol-name x) 0) #\?))
                          (let ((name (symbol-name x)))
                            (if (string= name "?") (let ((v (fresh-var vm))) (push v variables) v)
                                (progn (incf (gethash name counts 0))
                                       (or (gethash name names)
                                           (progn (push name order) (let ((v (fresh-var vm))) (push v variables) (setf (gethash name names) v)))))))
                          (lisp-input-atom x)))
                    (lambda () (fresh-cons vm nil nil))))))
        (setf (iso-stream-past-end meta) (eq raw eof) order (nreverse order))
        (and (unify vm target value)
             (every (lambda (option)
                      (unify vm (cdr option)
                       (cond ((string= (car option) "variables") (iso-list-from-host (reverse variables)))
                             (t (iso-list-from-host
                                  (loop for n in order
                                    when (or (string= (car option) "variable_names") (= (gethash n counts) 1))
                                    collect (if (eq *term-model* :iso)
                                                (iso-compound (iso-atom "=") (iso-atom n) (gethash n names))
                                                (cons (iso-atom n) (gethash n names))))))))) opts))))))
(defun read-prolog-stream-term (vm stream target options)
  (let ((opts (iso-options options '("variables" "variable_names" "singletons")))
        (names (make-hash-table :test 'eq)) (counts (make-hash-table :test 'eq))
        (order nil) (variables nil))
    (dolist (option opts) (iso-output-list (cdr option)))
    (multiple-value-bind (s meta) (iso-stream-for vm stream :input "text")
      (when (and (iso-stream-past-end meta) (string= (iso-stream-eof-action meta) "error"))
        (iso-error "permission_error" (iso-atom "input") (iso-atom "past_end_of_stream") stream))
      (multiple-value-bind (raw present)
          (read-prolog-term s :database (machine-database vm) :package :sprolog/prolog-io-atoms)
        (setf (iso-stream-past-end meta) (not present))
        (let ((value
                (if present
                    (map-term raw
                      (lambda (x)
                        (cond
                          ((variable-symbol-p x)
                           (incf (gethash x counts 0))
                           (or (gethash x names)
                               (let ((v (fresh-var vm)))
                                 (setf (gethash x names) v)
                                 (push v variables) (push x order) v)))
                          ((and (symbolp x) (eq (symbol-package x) (find-package :sprolog/prolog-io-atoms)))
                           (iso-atom (iso-atom-name x)))
                          (t x)))
                      (lambda () (fresh-cons vm nil nil)))
                    (iso-atom "end_of_file"))))
          (setf order (nreverse order))
          (and (unify vm target value)
               (every
                 (lambda (option)
                   (unify vm (cdr option)
                     (if (string= (car option) "variables") (iso-list-from-host (reverse variables))
                         (iso-list-from-host (loop for name in order
                               unless (string= (symbol-name name) "?")
                                 when (or (string= (car option) "variable_names")
                                          (= (gethash name counts) 1))
                                   collect (iso-compound (iso-atom "=")
                                             (iso-atom (subseq (symbol-name name) 1))
                                             (gethash name names)))))))
                 opts)))))))
(defun write-lisp-term (vm stream term options)
  (let* ((opts (iso-options options '("quoted" "ignore_ops" "numbervars" "variable_names")))
         (quoted (iso-boolean (iso-option opts "quoted" (iso-atom "false"))))
         (names (make-hash-table :test 'eq))
         (used-names (make-hash-table :test 'equal)) (serial 0))
    (dolist (name '("ignore_ops" "numbervars"))
      (iso-boolean (iso-option opts name (iso-atom "false"))))
    (dolist (pair (iso-list (iso-option opts "variable_names" (iso-empty-list))))
      (let* ((pair (iso-required pair))
             (strict (eq *term-model* :iso))
             (valid (and (consp pair)
                         (if strict
                             (and (symbolp (car pair)) (string= (iso-text (car pair)) "=")
                                  (consp (cdr pair)) (consp (cddr pair)) (null (cdddr pair)))
                             t)))
             (var (and valid (deref (if strict (third pair) (cdr pair)))))
             (name (and valid (iso-text (if strict (second pair) (car pair))))))
        (unless (and valid (logic-var-p var) (plusp (length name)) (char= (char name 0) #\?))
          (iso-error "domain_error" (iso-atom "variable_name") pair))
        (when (or (string= name "?")
                  (and (gethash name used-names) (not (eq (gethash name used-names) var))))
          (iso-error "domain_error" (iso-atom "variable_name") pair))
        (setf (gethash name used-names) var (gethash var names) (make-symbol name))))
    (let ((value (map-term term (lambda (x)
                   (let ((x (deref x)))
                     (if (logic-var-p x)
                         (or (gethash x names)
                             (loop for name = (format nil "?G~D" serial)
                                   do (incf serial)
                                   unless (gethash name used-names)
                                     do (setf (gethash name used-names) x)
                                        (return (setf (gethash x names) (make-symbol name))))) (lisp-output-atom x))))))
          (*print-circle* t) (*print-readably* nil) (*print-level* nil) (*print-length* nil)
          (*print-case* :upcase) (*print-pretty* nil)
          (*print-base* 10) (*print-radix* nil) (*print-gensym* nil)
          (*readtable* (if (eq *term-model* :iso)
                           (let ((table (copy-readtable nil)))
                             (setf (readtable-case table) :preserve) table)
                           *readtable*))
          (*package* (find-package (if (eq *term-model* :iso) :sprolog/lisp-io-atoms :sprolog/atoms))))
      (write value :stream (iso-stream-for vm stream :output "text") :escape quoted)
      t)))
(defun write-prolog-stream-term (vm stream term options)
  (let* ((opts (iso-options options '("quoted" "ignore_ops" "numbervars" "variable_names")))
         (quoted (iso-boolean (iso-option opts "quoted" (iso-atom "false"))))
         (ignore-ops (iso-boolean (iso-option opts "ignore_ops" (iso-atom "false"))))
         (numbervars (iso-boolean (iso-option opts "numbervars" (iso-atom "false"))))
         (names (iso-option opts "variable_names" (iso-empty-list))))
    (write-prolog-term (iso-stream-for vm stream :output "text") term (machine-database vm)
                       :quoted quoted :ignore-ops ignore-ops :numbervars numbervars :variable-names names)))
(defun iso-term-io (vm name args)
  (let ((a (first args)) (b (second args)) (c (third args))
        (state (iso-state-for (machine-database vm))))
    (cond
      ((string= name "READ_TERM")
       (if (eq (iso-flag-value (machine-database vm) "read_syntax") :prolog)
           (read-prolog-stream-term vm a b c) (read-lisp-term vm a b c)))
      ((string= name "WRITE_TERM")
       (if (eq (iso-flag-value (machine-database vm) "write_syntax") :prolog)
           (write-prolog-stream-term vm a b c) (write-lisp-term vm a b c)))
      ((string= name "OP")
       (let ((priority (iso-integer a)) (specifier (operator-specifier b)) (names (iso-required c)))
         (unless (<= 0 priority 1200) (iso-error "domain_error" (iso-atom "operator_priority") a))
         (unless (or (symbolp names) (consp names))
           (iso-error "type_error" (iso-atom "list") names))
         (let* ((texts (mapcar (lambda (name)
                                ;; The textual empty-list atom is native NIL. Keep
                                ;; its representation, but enforce OP's restriction.
                                (let ((value (iso-required name)))
                                  (when (iso-null-p value)
                                    (iso-error "permission_error" (iso-atom "create")
                                               (iso-atom "operator") value))
                                  (iso-text value)))
                              (if (consp names) (iso-list names) (list names))))
                (group (operator-specifier-group specifier))
                (opposite (cond ((= (length specifier) 3) '("xf" "yf"))
                                ((member specifier '("xf" "yf") :test #'string=) '("xfx" "xfy" "yfx")))))
           ;; Check every name before publishing any changes.
           (dolist (text texts)
             (when (string= text ",")
               (iso-error "permission_error" (iso-atom "modify") (iso-atom "operator") (iso-atom text)))
             (when (or (member text '("[]" "{}") :test #'string=)
                       (and (plusp priority)
                            (some (lambda (kind) (gethash (cons text kind) (iso-state-operators state))) opposite))
                       (and (string= text "|")
                            (not (and (member specifier '("xfx" "xfy" "yfx") :test #'string=)
                                      (or (zerop priority) (> priority 1000))))))
               (iso-error "permission_error" (iso-atom "create") (iso-atom "operator") (iso-atom text))))
           (dolist (text texts)
             ;; OP changes/removes a definition by fixity group, including when
             ;; the supplied associativity differs from the previous definition.
             (dolist (kind group) (remhash (cons text kind) (iso-state-operators state)))
             (when (plusp priority)
               (setf (gethash (cons text specifier) (iso-state-operators state)) priority)))) t))
      ((string= name "CHAR_CONVERSION")
       (setf (gethash (iso-character a) (iso-state-conversions state)) (iso-character b)) t)
      (t (error "Unknown reader operation ~A" name)))))
