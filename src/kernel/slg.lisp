;; ASDF infers load order from this dependency package. Implementation symbols
;; stay in SPROLOG so the public API and internal symbol identities are stable.
(defpackage #:sprolog/src/kernel/slg (:use #:cl #:sprolog/src/syntax/wam-compiler))
(in-package #:sprolog)

;; Copying SLG: each consumer owns an isolated WAM continuation. The work queue
;; propagates each new (possibly conditional) answer exactly once to each consumer.
;; Dynamic SCCs complete independently, before external waiters consume answers.
(defstruct slg-context
  database generation (tables (make-hash-table :test 'equal))
  (atoms (make-hash-table :test 'eql))
  (constants (make-array 16 :adjustable t :fill-pointer 0))
  queue tail (running nil) (closed nil) (suspensions 0) (resumptions 0)
  (steps 0) (answers 0) (copies 0) (scope-serial 0)
  (guards (make-hash-table)) (components-completed 0) (max-component-size 0)
  (local-waits 0))
(defstruct slg-table id name arity tokens
  (answers nil) (index (make-hash-table :test 'equal)) consumers complete falsep dependencies waiters)
(defstruct slg-answer tokens delays)
(defstruct slg-consumer vm tailp)
(defstruct slg-waiter vm tailp negativep)

(defun table (name arity &optional (database *database*))
  "Enable variant tabling for NAME/ARITY (DCG declarations use expanded arity)."
  (unless (and (symbolp name) (integerp arity) (>= arity 0))
    (error "Invalid table declaration: ~S/~S" name arity))
  (incf (database-generation database))
  (setf (gethash (cons name arity) (database-tabled database)) t))
(defun untable (name arity &optional (database *database*))
  (incf (database-generation database))
  (remhash (cons name arity) (database-tabled database)))
(defun slg-check-database (vm)
  (let ((context (machine-slg vm)))
    (unless (= (slg-context-generation context)
               (database-generation (machine-database vm)))
      (error "Database changed during an active SLG query; start a new query"))))
(defun slg-context-for (vm)
  (or (machine-slg vm)
      (setf (machine-slg vm)
            (make-slg-context :database (machine-database vm)
                              :generation (database-generation (machine-database vm))))))

(defun slg-freeze (context term &optional groundp)
  "Flat variant key, preserving variable aliasing and EQL atom semantics.
Cons sharing is immaterial; rational cycles are explicitly rejected."
  (let ((variables (make-hash-table :test 'eq))
        (active (make-hash-table :test 'eq))
        (work (list (cons :visit term))) (tokens nil))
    (loop while work do
      (let* ((item (pop work)) (value (deref (cdr item))))
          (cond
            ((eq (car item) :leave) (remhash value active))
            ((logic-var-p value)
             (when groundp (error "Floundering: TNOT requires a ground goal"))
             (push (list :var (or (gethash value variables)
                                 (setf (gethash value variables) (hash-table-count variables)))) tokens))
            ((consp value)
             (when (gethash value active) (error "Cyclic terms are unsupported in SLG tables"))
             (setf (gethash value active) t)
             (push :pair tokens)
             (push (cons :leave value) work)
             (push (cons :visit (cdr value)) work)
             (push (cons :visit (car value)) work))
            (t
             (multiple-value-bind (id found) (gethash value (slg-context-atoms context))
               (unless found
                 (setf id (length (slg-context-constants context))
                       (gethash value (slg-context-atoms context)) id)
                 (vector-push-extend value (slg-context-constants context)))
               (push (list :atom id) tokens))))))
    (nreverse tokens)))
(defun slg-thaw (context tokens vm)
  (let ((variables (make-hash-table)) (stack nil))
    (dolist (token (reverse tokens))
      (push (cond ((eq token :pair)
                   (let ((a (pop stack)) (d (pop stack))) (fresh-cons vm a d)))
                  ((eq (car token) :var)
                   (or (gethash (second token) variables)
                       (setf (gethash (second token) variables) (fresh-var vm))))
                  (t (aref (slg-context-constants context) (second token)))) stack))
    (car stack)))

(defun slg-copy-machine (vm)
  "Iterative graph copy of bindings, roots, choice points and continuations.
Code, table entries and host functions are immutable and shared."
  (let ((copy (copy-machine vm)) (seen (make-hash-table :test 'eq))
        (containers (make-hash-table :test 'eq)) (work nil))
    (labels ((container (x)
               (when x (setf (gethash x containers) t)) (clone x))
             (clone (x)
               (if (or (consp x) (logic-var-p x) (gethash x containers)
                       (continuation-p x) (choice-p x) (iso-handler-p x))
                   (or (gethash x seen)
                       (let ((new (cond ((consp x) (cons nil nil))
                                        ((logic-var-p x) (%make-var (logic-var-id x)))
                                        ((continuation-p x) (copy-continuation x))
                                        ((choice-p x) (copy-choice x))
                                        ((iso-handler-p x) (copy-iso-handler x))
                                        (t (make-array (max 1 (length x)) :adjustable t
                                                       :fill-pointer (length x))))))
                         (setf (gethash x seen) new) (push x work) new)) x)))
      (setf (machine-iso-handlers copy) (clone (machine-iso-handlers vm))
            (machine-args copy) (container (machine-args vm))
            (machine-slots copy) (container (machine-slots vm))
            (machine-variables copy) (clone (machine-variables vm))
            (machine-heap copy) (container (machine-heap vm))
            (machine-trail copy) (container (machine-trail vm))
            (machine-choices copy) (container (machine-choices vm))
            (machine-continuation copy) (clone (machine-continuation vm))
            (machine-slg-root copy) (clone (machine-slg-root vm))
            (machine-scopes copy) (clone (machine-scopes vm))
            (machine-scan copy) (clone (machine-scan vm)))
      (loop while work do
        (let* ((x (pop work)) (new (gethash x seen)))
          (cond ((consp x) (setf (car new) (clone (car x)) (cdr new) (clone (cdr x))))
                ((logic-var-p x) (setf (logic-var-binding new) (clone (logic-var-binding x))))
                ((iso-handler-p x)
                 (setf (iso-handler-snapshot new) (clone (iso-handler-snapshot x))
                       (iso-handler-catcher new) (clone (iso-handler-catcher x))
                       (iso-handler-recovery new) (clone (iso-handler-recovery x))
                       (iso-handler-parent new) (clone (iso-handler-parent x))))
                ((continuation-p x)
                 (setf (continuation-handlers new) (clone (continuation-handlers x)) (continuation-slots new) (container (continuation-slots x))
                       (continuation-scopes new) (clone (continuation-scopes x))
                       (continuation-parent new) (clone (continuation-parent x))))
                ((choice-p x)
                 (setf (choice-handlers new) (clone (choice-handlers x)) (choice-args new) (container (choice-args x))
                       (choice-slots new) (container (choice-slots x))
                       (choice-scopes new) (clone (choice-scopes x))
                       (choice-continuation new) (clone (choice-continuation x))))
                (t (dotimes (i (length x)) (setf (aref new i) (clone (aref x i)))))))))
    (incf (slg-context-copies (machine-slg vm)))
    copy))
(defun slg-enqueue (context task)
  (let ((cell (list task)))
    (if (slg-context-tail context) (setf (cdr (slg-context-tail context)) cell)
        (setf (slg-context-queue context) cell))
    (setf (slg-context-tail context) cell)))
(defun slg-dequeue (context)
  (prog1 (pop (slg-context-queue context))
    (unless (slg-context-queue context) (setf (slg-context-tail context) nil))))
(defun slg-get-table (vm name arity args)
  (let* ((context (slg-context-for vm)) (tokens (slg-freeze context args))
         (key (list name arity tokens)))
    (or (gethash key (slg-context-tables context))
        (let* ((table (make-slg-table :id (hash-table-count (slg-context-tables context))
                                      :name name :arity arity :tokens tokens))
               (worker (%make-machine :database (machine-database vm)
                                      :slg context :slg-worker t :slg-owner table :slg-bypass t
                                      :gc-floor (machine-gc-floor vm) :gc-limit (machine-gc-floor vm)
                                      :code (vector (list 'call name arity) '(yield)))))
          (setf (gethash key (slg-context-tables context)) table)
          (let ((arguments (slg-thaw context tokens worker)))
            (setf (machine-args worker) (coerce arguments 'vector)
                  (machine-slg-root worker) arguments))
          (slg-enqueue context worker)
          table))))
(defun slg-delays (delays)
  (sort (remove-duplicates (copy-list delays) :test #'eq) #'< :key #'slg-table-id))
(defun slg-answer-key (answer)
  (list (slg-answer-tokens answer) (mapcar #'slg-table-id (slg-answer-delays answer))))
(defun slg-add-answer (context table tokens delays)
  ;; Ground true/false knowledge is monotone. Do not reinsert a stale
  ;; conditional answer delivered by a previously queued consumer.
  (when (some #'slg-unconditional-p delays) (return-from slg-add-answer nil))
  (setf delays (remove-if #'slg-table-falsep delays))
  (when (and delays
             (some (lambda (a) (and (null (slg-answer-delays a))
                                   (equal tokens (slg-answer-tokens a))))
                   (slg-table-answers table)))
    (return-from slg-add-answer nil))
  (let* ((answer (make-slg-answer :tokens tokens :delays (slg-delays delays)))
         (key (slg-answer-key answer)))
    (unless (gethash key (slg-table-index table))
      (setf (gethash key (slg-table-index table)) answer)
      (push answer (slg-table-answers table))
      (incf (slg-context-answers context))
      (dolist (consumer (slg-table-consumers table))
        (slg-enqueue context (list consumer answer)))
      answer)))
(defun slg-unconditional-p (table)
  (some (lambda (answer) (null (slg-answer-delays answer))) (slg-table-answers table)))
(defun slg-simplify (context tables)
  "Simplify delay lists using true and false ground tables. Return change flag."
  (let ((changed nil) (promotions nil) (truth (make-hash-table :test 'eq)))
    ;; Snapshot truth before modifying any answer lists: a pending promotion
    ;; must never make its source table temporarily appear false.
    (maphash (lambda (key table)
               (declare (ignore key))
               (when (and (member table tables :test #'eq) (null (slg-table-answers table)))
                 (setf (slg-table-falsep table) t))
               (setf (gethash table truth)
                     (cond ((slg-unconditional-p table) :true)
                           ((slg-table-falsep table) :false)
                           (t :undefined))))
             (slg-context-tables context))
    (dolist (table tables)
       (let ((survivors nil))
         (dolist (answer (slg-table-answers table))
           (let ((delays (slg-answer-delays answer)))
             (cond
               ((some (lambda (dep) (eq (gethash dep truth) :true)) delays) (setf changed t))
               (t
                (let ((remaining (remove-if (lambda (dep) (eq (gethash dep truth) :false)) delays)))
                  (if (= (length remaining) (length delays)) (push answer survivors)
                      (progn (setf changed t)
                             (push (list table (slg-answer-tokens answer) remaining) promotions))))))))
         (setf (slg-table-answers table) (nreverse survivors))
         (clrhash (slg-table-index table))
         (dolist (answer survivors) (setf (gethash (slg-answer-key answer) (slg-table-index table)) answer))))
    (dolist (promotion promotions) (apply #'slg-add-answer context promotion))
    changed))
(defun slg-resume (context consumer answer)
  (let* ((vm (slg-copy-machine (slg-consumer-vm consumer)))
         (arguments (slg-thaw context (slg-answer-tokens answer) vm)))
    (incf (slg-context-resumptions context))
    (if (loop for arg in arguments for i from 0 always (unify vm (aref (machine-args vm) i) arg))
        (progn
          (setf (machine-delays vm) (slg-delays (append (machine-delays vm) (slg-answer-delays answer))))
          (when (slg-consumer-tailp consumer) (restore-continuation vm)) vm)
        (progn (close-query vm) nil))))
(defun slg-dispatch (vm table tailp)
  (let ((answers (reverse (slg-table-answers table)))
        (return-to (cons (machine-code vm) (machine-pc vm))))
    (if (null answers) (backtrack vm)
        (progn
          (setf (machine-code vm)
                (coerce (loop for remaining on answers collect
                          (list 'table-answer (car remaining) (not (null (cdr remaining))) tailp return-to)) 'vector)
                (machine-pc vm) 0) t))))
(defun slg-call (vm name arity tailp)
  (slg-check-database-if-present vm)
  (let* ((context (slg-context-for vm))
         (table (slg-get-table vm name arity (coerce (subseq (machine-args vm) 0 arity) 'list))))
    (if (machine-slg-worker vm)
        (if (slg-table-complete table) (slg-dispatch vm table tailp)
            (slg-wait vm table tailp nil))
        (progn
          (unless (slg-table-complete table) (slg-evaluate context))
          (slg-dispatch vm table tailp)))))
(defun slg-check-database-if-present (vm)
  (when (machine-slg vm) (slg-check-database vm)))
(defun slg-return-answer (vm answer more tailp return-to)
  (when more (push-choice vm (machine-pc vm) t))
  (let ((arguments (slg-thaw (machine-slg vm) (slg-answer-tokens answer) vm)))
    (if (loop for arg in arguments for i from 0 always (unify vm (aref (machine-args vm) i) arg))
        (progn
          (setf (machine-delays vm) (slg-delays (append (machine-delays vm) (slg-answer-delays answer))))
          (if tailp (restore-continuation vm)
              (setf (machine-code vm) (car return-to) (machine-pc vm) (cdr return-to)))
          (maybe-collect vm))
        (backtrack vm))))
(defun slg-negative-result (vm table)
  (cond ((slg-unconditional-p table) (backtrack vm))
        ((and (slg-table-complete table) (null (slg-table-answers table))) t)
        (t
         (unless (slg-table-complete table) (slg-register-guard vm table))
         (setf (machine-delays vm) (slg-delays (cons table (machine-delays vm)))) t)))
(defun slg-negative (vm template)
  (slg-check-database-if-present vm)
  (let* ((context (slg-context-for vm))
         (goal (instantiate template (machine-slots vm) vm)))
    (slg-freeze context goal t)
    (let ((key (predicate-key goal)))
      (unless (gethash key (database-tabled (machine-database vm)))
        (error "TNOT target must be tabled: ~S/~D" (car key) (cdr key)))
      (let ((table (slg-get-table vm (car key) (cdr key) (cdr goal))))
        (cond ((slg-table-complete table) (slg-negative-result vm table))
              ((machine-slg-worker vm) (slg-wait vm table nil t))
              (t (slg-evaluate context) (slg-negative-result vm table)))))))
(defun slg-table-goal (context table)
  (let ((vm (%make-machine)))
    (cons (slg-table-name table) (reify (slg-thaw context (slg-table-tokens table) vm)))))
(defun slg-statistics (context)
  (list :tables (hash-table-count (slg-context-tables context))
        :answers (loop for table being the hash-values of (slg-context-tables context)
                       sum (length (slg-table-answers table)))
        :completed-components (slg-context-components-completed context)
        :max-component-size (slg-context-max-component-size context)
        :local-waits (slg-context-local-waits context)
        :answer-insertions (slg-context-answers context)
        :suspensions (slg-context-suspensions context) :resumptions (slg-context-resumptions context)
        :continuation-copies (slg-context-copies context) :instructions (slg-context-steps context)))
(defun slg-close (context)
  (unless (slg-context-closed context)
    (maphash (lambda (key table)
               (declare (ignore key))
               (dolist (consumer (slg-table-consumers table)) (close-query (slg-consumer-vm consumer)))
               (dolist (waiter (slg-table-waiters table)) (close-query (slg-waiter-vm waiter)))
               (setf (slg-table-waiters table) nil (slg-table-dependencies table) nil
                     (slg-table-consumers table) nil (slg-table-answers table) nil)
               (clrhash (slg-table-index table))) (slg-context-tables context))
    (dolist (task (slg-context-queue context)) (when (machine-p task) (close-query task)))
    (clrhash (slg-context-tables context)) (clrhash (slg-context-atoms context))
    (clrhash (slg-context-guards context))
    (setf (slg-context-constants context) #() (slg-context-queue context) nil
          (slg-context-tail context) nil (slg-context-closed context) t)))

(define-condition slg-incomplete-cut (error)
  ((table :initarg :table :reader slg-incomplete-cut-table))
  (:report (lambda (condition stream)
             (let ((table (slg-incomplete-cut-table condition)))
               (format stream "Illegal CUT over incomplete tabled subgoal ~S/~D"
                       (slg-table-name table) (slg-table-arity table))))))
(defun slg-enter-cut-frame (vm)
  (push (incf (slg-context-scope-serial (machine-slg vm))) (machine-slg-lineage vm)))
(defun slg-register-guard (vm table)
  ;; Scope identities survive graph copies and physical choice-stack rebasing.
  ;; Keep guards for frozen alternatives as well as the currently resumed path.
  (dolist (scope (machine-slg-lineage vm))
    (pushnew table (gethash scope (slg-context-guards (machine-slg vm))) :test #'eq)))
(defun slg-check-cut (vm)
  (when (machine-slg-worker vm)
    (dolist (table (gethash (car (machine-slg-lineage vm))
                          (slg-context-guards (machine-slg vm))))
      (unless (slg-table-complete table)
        (error 'slg-incomplete-cut :table table)))))
(defun slg-wait (vm table tailp negativep)
  (pushnew table (slg-table-dependencies (machine-slg-owner vm)) :test #'eq)
  (push (make-slg-waiter :vm vm :tailp tailp :negativep negativep) (slg-table-waiters table))
  (incf (slg-context-local-waits (machine-slg vm)))
  (setf (machine-slg-paused vm) t)
  t)
(defun slg-components (context)
  "Iterative Kosaraju on the reached, still incomplete dependency graph."
  (let ((nodes nil) (seen (make-hash-table :test 'eq)) (order nil)
        (reverse-edges (make-hash-table :test 'eq))
        (membership (make-hash-table :test 'eq)) (components nil))
    (maphash (lambda (key table)
               (declare (ignore key))
               (unless (slg-table-complete table) (push table nodes)))
             (slg-context-tables context))
    (dolist (node nodes)
      (dolist (dep (slg-table-dependencies node))
        (unless (slg-table-complete dep) (push node (gethash dep reverse-edges))))
      (let ((work (list (cons node nil))))
        (loop while work do
          (let* ((item (pop work)) (table (car item)))
              (cond ((cdr item) (push table order))
                    ((not (gethash table seen))
                     (setf (gethash table seen) t)
                     (push (cons table t) work)
                     (dolist (dep (slg-table-dependencies table))
                       (unless (slg-table-complete dep) (push (cons dep nil) work)))))))))
    (clrhash seen)
    (dolist (node order)
      (unless (gethash node seen)
        (let ((work (list node)) (component nil))
          (loop while work do
            (let* ((table (pop work)))
              (unless (gethash table seen)
                (setf (gethash table seen) t)
                (push table component)
                (dolist (dep (gethash table reverse-edges)) (push dep work)))))
          (dolist (table component) (setf (gethash table membership) component))
          (push component components))))
    (values components membership)))
(defun slg-rebase-consumer (snapshot)
  ;; Previous alternatives are owned by the original worker, not the consumer.
  ;; All surviving numeric cut boundaries must be remapped, including ancestors
  ;; and PHRASE's opaque cut scopes. Logical scope identities remain unchanged.
  (truncate-vector (machine-choices snapshot) 0)
  (truncate-vector (machine-trail snapshot) 0)
  (setf (machine-cut snapshot) 0)
  (dolist (scope (machine-scopes snapshot)) (setf (car scope) 0))
  (loop for frame = (machine-continuation snapshot) then (continuation-parent frame)
        while frame do
          (setf (continuation-cut frame) 0)
          (dolist (scope (continuation-scopes frame)) (setf (car scope) 0)))
  (maybe-collect snapshot))
(defun slg-cycle-consumer (context table waiter)
  (let ((vm (slg-waiter-vm waiter)))
    (setf (machine-slg-paused vm) nil)
    (if (slg-waiter-negativep waiter)
        (progn
          (slg-negative-result vm table)
          (unless (machine-closed vm) (slg-enqueue context vm)))
        (progn
          (slg-register-guard vm table)
          (let* ((snapshot (slg-copy-machine vm))
                 (consumer (make-slg-consumer :vm snapshot :tailp (slg-waiter-tailp waiter))))
            (slg-rebase-consumer snapshot)
            (push consumer (slg-table-consumers table))
            (incf (slg-context-suspensions context))
            (dolist (answer (reverse (slg-table-answers table)))
              (slg-enqueue context (list consumer answer))))
          (when (backtrack vm) (slg-enqueue context vm))))))
(defun slg-release-cycles (context membership)
  (let ((changed nil))
    (maphash
     (lambda (key table)
       (declare (ignore key))
       (unless (slg-table-complete table)
         (let ((keep nil))
           (dolist (waiter (reverse (slg-table-waiters table)))
             (if (eq (gethash table membership)
                     (gethash (machine-slg-owner (slg-waiter-vm waiter)) membership))
                 (progn (slg-cycle-consumer context table waiter) (setf changed t))
                 (push waiter keep)))
           (setf (slg-table-waiters table) keep))))
     (slg-context-tables context))
    changed))
(defun slg-task-owner (task)
  (machine-slg-owner (if (machine-p task) task (slg-consumer-vm (first task)))))
(defun slg-component-idle-p (context component membership)
  (let ((id component))
    (and
     (notany (lambda (task) (eq (gethash (slg-task-owner task) membership) id))
             (slg-context-queue context))
     (every (lambda (table)
              (every (lambda (dep) (or (slg-table-complete dep)
                                      (eq (gethash dep membership) id)))
                     (slg-table-dependencies table))) component)
     ;; Every internal waiter should already have become a cycle consumer.
     (loop for table being the hash-values of (slg-context-tables context)
           always (notany (lambda (waiter)
                            (eq (gethash (machine-slg-owner (slg-waiter-vm waiter)) membership) id))
                          (slg-table-waiters table))))))
(defun slg-complete-component (context component)
  (incf (slg-context-components-completed context))
  (setf (slg-context-max-component-size context)
        (max (slg-context-max-component-size context) (length component)))
  ;; Mark the whole SCC first; no external waiter sees partial completion.
  (dolist (table component)
    (let ((true (make-hash-table :test 'equal)))
      (dolist (answer (slg-table-answers table))
        (unless (slg-answer-delays answer) (setf (gethash (slg-answer-tokens answer) true) t)))
      (setf (slg-table-answers table)
            (remove-if (lambda (a) (and (slg-answer-delays a) (gethash (slg-answer-tokens a) true)))
                       (slg-table-answers table))
            (slg-table-complete table) t)
      (clrhash (slg-table-index table))
      (dolist (answer (slg-table-answers table))
        (setf (gethash (slg-answer-key answer) (slg-table-index table)) answer))))
  (dolist (table component)
    (dolist (consumer (slg-table-consumers table)) (close-query (slg-consumer-vm consumer)))
    (setf (slg-table-consumers table) nil)
    (dolist (waiter (reverse (slg-table-waiters table)))
      (let ((vm (slg-waiter-vm waiter)))
        (setf (machine-slg-paused vm) nil)
        (if (slg-waiter-negativep waiter) (slg-negative-result vm table)
            (slg-dispatch vm table (slg-waiter-tailp waiter)))
        (unless (machine-closed vm) (slg-enqueue context vm))))
    (setf (slg-table-waiters table) nil))
  (let ((remove nil))
    (maphash (lambda (scope tables)
               (let ((remaining (remove-if #'slg-table-complete tables)))
                 (if remaining (setf (gethash scope (slg-context-guards context)) remaining)
                     (push scope remove)))) (slg-context-guards context))
    (dolist (scope remove) (remhash scope (slg-context-guards context)))))
(defun slg-settle (context)
  (multiple-value-bind (components membership) (slg-components context)
    (unless (slg-release-cycles context membership)
      (dolist (component components)
        (when (slg-component-idle-p context component membership)
          (unless (slg-simplify context component)
            (slg-complete-component context component)))))))
(defun slg-evaluate (context)
  (when (slg-context-running context) (error "Recursive SLG scheduler entry"))
  (setf (slg-context-running context) t)
  (unwind-protect
       (loop
         (slg-settle context)
         (cond
           ((slg-context-queue context)
            (let* ((task (slg-dequeue context))
                   (vm (if (machine-p task) task (slg-resume context (first task) (second task)))))
              (when vm
                (let ((before (machine-steps vm)))
                  (when (run-machine vm)
                    (slg-add-answer context (machine-slg-owner vm)
                                    (slg-freeze context (machine-slg-root vm)) (machine-delays vm))
                    (setf (machine-ready vm) nil)
                    (when (backtrack vm) (slg-enqueue context vm)))
                  (incf (slg-context-steps context) (- (machine-steps vm) before))))))
           ((loop for table being the hash-values of (slg-context-tables context)
                  always (slg-table-complete table)) (return))
           ;; Simplification may need another round without runnable work.
           (t nil)))
    (setf (slg-context-running context) nil)))
