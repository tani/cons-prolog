(uiop:define-package #:sprolog/src/prolog/loader
  (:use #:cl)
  (:import-from #:sprolog/src/prolog/lexer #:make-lexer)
  (:import-from #:sprolog/src/prolog/reader #:read-prolog-term #:parse-prolog-string)
  (:import-from #:sprolog/src/adapters/adapter #:iso-state-for)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom #:iso-error #:iso-text)
  (:import-from #:sprolog/src/adapters/dynamic #:iso-indicator #:iso-check-modifiable)
  (:import-from #:sprolog/src/kernel/engine #:*database* #:predicate-key #:map-term)
  (:import-from #:sprolog/src/kernel/model #:disjunction-goal-p #:iso-state-loaded-files #:iso-state-declarations #:database-predicates)
  (:import-from #:sprolog/src/kernel/runtime #:iso-goal)
  (:import-from #:sprolog/src/syntax/compiler #:add-clause #:query #:variable-symbol-p)
  (:import-from #:sprolog/src/syntax/dcg #:dcg-expand)
  (:export #:load-prolog #:load-prolog-string #:load-prolog-file))
(in-package #:sprolog/src/prolog/loader)
(defvar *loading-files* nil)
(defvar *initializations* nil)
(defvar *load-depth* 0)
(defvar *seen-predicates* nil)
(defvar *include-mode* nil)
(defun named-form-p (term name arity)
  (and (consp term) (symbolp (car term)) (= (length (cdr term)) arity)
       (string-equal (symbol-name (car term)) name)))
(defun source-goal (term)
  (if (or (variable-symbol-p term) (disjunction-goal-p term)) term (iso-goal term)))
(defun comma-items (term)
  (let ((work (list term)) (items nil))
    (loop while work do
      (let ((item (pop work)))
        (if (named-form-p item "," 2)
            (progn (push (third item) work) (push (second item) work))
            (push item items)))) (nreverse items)))
(defun grammar-form (term marks)
  (cond ((or (null term) (gethash term marks)) (list 'quote term))
        ((named-form-p term "{}" 1) (list :goal (source-goal (second term))))
        ((named-form-p term "," 2) (list :seq (grammar-form (second term) marks) (grammar-form (third term) marks)))
        ((named-form-p term ";" 2) (list :or (grammar-form (second term) marks) (grammar-form (third term) marks)))
        (t term)))
(defun load-prolog (stream &key (database *database*) (package *package*) (source "<stream>") (base-directory *default-pathname-defaults*))
  "Load full-stop-terminated Prolog terms from STREAM. Return the clause count."
  (let ((*initializations* (if (zerop *load-depth*) (list nil) *initializations*))
        (*load-depth* (1+ *load-depth*)) (*seen-predicates* (if *include-mode* *seen-predicates* (make-hash-table :test 'equal)))
        (count 0) (state (iso-state-for database)) (lexer (make-lexer :stream stream :source source)))
    (labels ((run (goal)
               (unless (query (list (source-goal goal)) :database database :limit 1)
                 (iso-error "load_error" (iso-atom "directive_failed") goal)))
             (declare-predicates (name term)
               (dolist (indicator (comma-items term))
                 (map-term indicator (lambda (x)
                                       (when (variable-symbol-p x) (iso-error "instantiation_error")) x))
                 (let* ((key (iso-indicator indicator))
                        (canonical (cons (string-downcase (symbol-name (car key))) (cdr key))))
                   (iso-check-modifiable database key)
                   (pushnew name (gethash canonical (iso-state-declarations state)) :test #'string=)
                   (when (string= name "dynamic")
                     (unless (gethash key (database-predicates database))
                       (run (list (intern "%ENSURE_DYNAMIC" package)
                                  (cons (car key) (loop repeat (cdr key) collect (make-symbol "?"))))))))))
             (load-path (term once)
               (when (variable-symbol-p term) (iso-error "instantiation_error"))
               (let* ((file (merge-pathnames (iso-text term) base-directory))
                      (path (handler-case (truename file)
                              (file-error () (iso-error "existence_error" (iso-atom "source_sink") term))))
                      (key (namestring path)))
                 (when (and once (or (gethash key (iso-state-loaded-files state)) (member key *loading-files* :test #'string=)))
                   (return-from load-path 0))
                 (when (member key *loading-files* :test #'string=)
                   (iso-error "permission_error" (iso-atom "load") (iso-atom "recursive_include") term))
                 (let ((*include-mode* (not once)))
                   (prog1 (load-prolog-file path :database database :package package)
                     (setf (gethash key (iso-state-loaded-files state)) t)))))
             (directive (goal)
               (cond
                 ((named-form-p goal "," 2) (directive (second goal)) (directive (third goal)))
                 ((or (named-form-p goal "DYNAMIC" 1) (named-form-p goal "MULTIFILE" 1)
                      (named-form-p goal "DISCONTIGUOUS" 1))
                  (declare-predicates (string-downcase (symbol-name (car goal))) (second goal)))
                 ((named-form-p goal "INITIALIZATION" 1)
                  (setf (car *initializations*) (nconc (car *initializations*) (list (second goal)))))
                 ((named-form-p goal "INCLUDE" 1) (incf count (load-path (second goal) nil)))
                 ((named-form-p goal "ENSURE_LOADED" 1) (incf count (load-path (second goal) t)))
                 (t (run goal))))
             (publish (head body)
               (let* ((head (iso-goal head)) (key (predicate-key head))
                      (canonical (cons (string-downcase (symbol-name (car key))) (cdr key)))
                      (replace (and (not (gethash canonical *seen-predicates*))
                                    (not (member "multifile" (gethash canonical (iso-state-declarations state)) :test #'string=)))))
                 (add-clause head (mapcar #'source-goal body) replace database)
                 (setf (gethash canonical *seen-predicates*) t) (incf count))))
      (loop
        (multiple-value-bind (term present marks)
            (read-prolog-term stream :database database :package package :source source :lexer lexer)
          (unless present (return))
          (cond ((or (named-form-p term ":-" 1) (named-form-p term "?-" 1)) (directive (second term)))
                ((named-form-p term ":-" 2) (publish (second term) (list (third term))))
                ((named-form-p term "-->" 2)
                 (multiple-value-bind (head body) (dcg-expand (iso-goal (second term)) (list (grammar-form (third term) marks)))
                   (publish head body)))
                (t (publish term nil)))))
      (when (= *load-depth* 1) (dolist (goal (car *initializations*)) (run goal)))
      count)))
(defun load-prolog-string (string &key (database *database*) (package *package*) (base-directory *default-pathname-defaults*))
  (with-input-from-string (stream string)
    (load-prolog stream :database database :package package :source "<string>" :base-directory base-directory)))
(defun load-prolog-file (file &key (database *database*) (package *package*))
  (let ((path (handler-case (truename file)
                (file-error () (iso-error "existence_error" (iso-atom "source_sink") (namestring (pathname file)))))))
    (when (member (namestring path) *loading-files* :test #'string=)
      (iso-error "permission_error" (iso-atom "load") (iso-atom "recursive_include") (namestring path)))
    (let ((*loading-files* (cons (namestring path) *loading-files*)))
      (with-open-file (stream path :direction :input :external-format uiop:*utf-8-external-format*)
      (prog1 (load-prolog stream :database database :package package :source (namestring path)
                         :base-directory (make-pathname :name nil :type nil :defaults path))
        (setf (gethash (namestring path) (iso-state-loaded-files (iso-state-for database))) t))))))
