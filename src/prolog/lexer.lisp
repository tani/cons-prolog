(uiop:define-package #:sprolog/src/prolog/lexer
  (:use #:cl)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom #:iso-error)
  (:import-from #:sprolog/src/api/state #:*iso-context*)
  (:export #:make-lexer #:lexer-stream #:lexer-line #:lexer-column #:lexer-source
           #:flush-lookahead #:lexer-conversions #:lexer-look #:peek-token #:take-token #:expect-token #:prolog-syntax-error))
(in-package #:sprolog/src/prolog/lexer)
(defstruct lexer stream (line 1) (column 0) (source "<stream>") look conversions buffer
  last-raw (last-line 1) (last-column 0))
(defun prolog-syntax-error (lexer message)
  (let ((*iso-context* (list (iso-atom "read_prolog_term") (lexer-source lexer)
                            (lexer-line lexer) (lexer-column lexer))))
    (iso-error "syntax_error" (iso-atom message))))
(defun converted (lexer c raw)
  (if (and c (not raw) (lexer-conversions lexer))
      (gethash c (lexer-conversions lexer) c) c))
(defun lc (lexer &optional raw)
  (unless (lexer-buffer lexer)
    (setf (lexer-buffer lexer) (list (read-char (lexer-stream lexer) nil nil))))
  (converted lexer (car (lexer-buffer lexer)) raw))
(defun rc (lexer &optional raw)
  (let ((c (if (lexer-buffer lexer) (pop (lexer-buffer lexer))
               (read-char (lexer-stream lexer) nil nil))))
    (setf (lexer-last-raw lexer) c (lexer-last-line lexer) (lexer-line lexer)
          (lexer-last-column lexer) (lexer-column lexer))
    (when c (if (char= c #\Newline) (setf (lexer-column lexer) 0 (lexer-line lexer) (1+ (lexer-line lexer)))
                (incf (lexer-column lexer))))
    (converted lexer c raw)))
(defun unread-last (lexer)
  ;; Local pushback avoids nonportable UNREAD-CHAR after PEEK-CHAR.
  (push (lexer-last-raw lexer) (lexer-buffer lexer))
  (setf (lexer-line lexer) (lexer-last-line lexer) (lexer-column lexer) (lexer-last-column lexer)))
(defun flush-lookahead (lexer)
  ;; A successful top-level read leaves at most one physical lookahead character.
  (when (and (lexer-buffer lexer) (null (cdr (lexer-buffer lexer))) (car (lexer-buffer lexer)))
    (unread-char (car (lexer-buffer lexer)) (lexer-stream lexer)))
  (setf (lexer-buffer lexer) nil))
(defun whitespace-p (c) (and c (find c '(#\Space #\Tab #\Newline #\Return #\Page))))
(defun graphic-p (c) (and c (find c "#$&*+-./:<=>?@\\^~")))
(defun identifier-p (c) (and c (or (alphanumericp c) (char= c #\_))))
(defun skip-layout (lexer)
  (loop for c = (lc lexer) do
    (cond ((whitespace-p c) (rc lexer))
          ((and c (char= c #\%)) (loop for x = (rc lexer) while (and x (not (char= x #\Newline)))))
          ((and c (char= c #\/))
           (rc lexer)
           (if (eql (lc lexer) #\*)
               (progn (rc lexer)
                      (loop with star = nil for x = (rc lexer) do
                        (unless x (prolog-syntax-error lexer "unterminated_comment"))
                        (when (and star (char= x #\/)) (return))
                        (setf star (char= x #\*))))
               (progn (unread-last lexer) (return))))
          (t (return)))))
(defun quoted-text (lexer quote)
  (with-output-to-string (out)
    (loop for c = (rc lexer t) do
      (unless c (prolog-syntax-error lexer "unterminated_quote"))
      (cond ((char= c quote)
             (if (eql (lc lexer t) quote) (progn (rc lexer t) (write-char quote out)) (return)))
            ((char= c #\\)
             (let ((x (rc lexer t)))
               (unless x (prolog-syntax-error lexer "unterminated_escape"))
               (unless (char= x #\Newline)
                 (write-char (case x (#\n #\Newline) (#\r #\Return) (#\t #\Tab)
                               ((#\' #\" #\\) x)
                               (otherwise (prolog-syntax-error lexer "unsupported_escape"))) out))))
            (t (write-char c out))))))
(defun numeric-token (lexer first)
  (let* ((text (with-output-to-string (out)
                 (write-char first out)
                 (loop while (and (lc lexer) (digit-char-p (lc lexer))) do (write-char (rc lexer) out))
                 (when (eql (lc lexer) #\.)
                   (rc lexer)
                   (if (and (lc lexer) (digit-char-p (lc lexer)))
                       (progn (write-char #\. out)
                              (loop while (and (lc lexer) (digit-char-p (lc lexer))) do (write-char (rc lexer) out)))
                       (progn (unread-last lexer))))
                 (when (and (lc lexer) (find (lc lexer) "eE"))
                   (write-char (rc lexer) out)
                   (when (and (lc lexer) (find (lc lexer) "+-")) (write-char (rc lexer) out))
                   (unless (and (lc lexer) (digit-char-p (lc lexer))) (prolog-syntax-error lexer "numeric_exponent"))
                   (loop while (and (lc lexer) (digit-char-p (lc lexer))) do (write-char (rc lexer) out)))))
         (*read-eval* nil) (*read-base* 10) (*readtable* (copy-readtable nil)) (*read-default-float-format* 'double-float))
    (cons :number (handler-case (read-from-string text)
                    (error () (prolog-syntax-error lexer "number"))))))
(defun next-token (lexer)
  (skip-layout lexer)
  (let ((c (rc lexer)))
    (cond ((null c) (cons :eof nil))
          ((digit-char-p c) (numeric-token lexer c))
          ((or (alpha-char-p c) (char= c #\_))
           (cons (if (or (upper-case-p c) (char= c #\_)) :variable :atom)
                 (with-output-to-string (out) (write-char c out)
                   (loop while (identifier-p (lc lexer)) do (write-char (rc lexer) out)))))
          ((char= c #\') (cons :quoted (quoted-text lexer c)))
          ((char= c #\") (cons :string (quoted-text lexer c)))
          ((find c "()[]{},;|!") (cons :punctuation (string c)))
          ((and (char= c #\.)
                (or (null (lc lexer)) (whitespace-p (lc lexer))
                    (eql (lc lexer) #\%) (eql (lc lexer) #\/)))
           (cons :atom "."))
          ((graphic-p c)
           (let ((text (with-output-to-string (out) (write-char c out)
                         (loop while (graphic-p (lc lexer)) do (write-char (rc lexer) out)))))
             (when (and (string= text ".") (lc lexer)
                        (not (or (whitespace-p (lc lexer)) (eql (lc lexer) #\%) (eql (lc lexer) #\/))))
               (prolog-syntax-error lexer "full_stop_layout"))
             (cons :atom text)))
          (t (prolog-syntax-error lexer "unexpected_character")))))
(defun peek-token (lexer) (or (lexer-look lexer) (setf (lexer-look lexer) (next-token lexer))))
(defun take-token (lexer) (prog1 (peek-token lexer) (setf (lexer-look lexer) nil)))
(defun expect-token (lexer text)
  (let ((token (take-token lexer)))
    (unless (and (stringp (cdr token)) (string= text (cdr token)))
      (prolog-syntax-error lexer (concatenate 'string "expected_" text))) token))
