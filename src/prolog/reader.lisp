(uiop:define-package #:cons-prolog/src/prolog/reader
  (:use #:cl)
  (:import-from #:cons-prolog/src/prolog/lexer #:flush-lookahead #:lexer-conversions #:make-lexer #:peek-token #:take-token #:expect-token #:prolog-syntax-error
    #:lexer-line #:lexer-column #:lexer-token-line #:lexer-token-column)
  (:import-from #:cons-prolog/src/kernel/engine #:*database*)
  (:import-from #:cons-prolog/src/kernel/model #:*term-model* #:database-term-model #:iso-state-operators #:iso-state-reader-initialized #:iso-state-conversions #:iso-state-flags)
  (:import-from #:cons-prolog/src/adapters/adapter #:iso-state-for)
  (:import-from #:cons-prolog/src/adapters/term-ops #:iso-atom #:iso-empty-list #:iso-list-from-host #:iso-compound)
  (:export #:read-prolog-term #:parse-prolog-string #:initialize-reader-operators))
(in-package #:cons-prolog/src/prolog/reader)
(defun initialize-reader-operators (database)
  (let ((state (iso-state-for database)))
    (unless (iso-state-reader-initialized state)
      (dolist (entry '((1200 "xfx" ":-" "-->") (1200 "fx" ":-" "?-")
                       (1150 "fx" "dynamic" "multifile" "discontiguous" "initialization")
                       (1100 "xfy" ";") (1050 "xfy" "->") (1000 "xfy" ",")
                       (900 "fy" "\\+")
                       (700 "xfx" "=" "\\=" "==" "\\==" "@<" "@=<" "@>" "@>=" "=.." "is" "=:=" "=\\=" "<" "=<" ">" ">=")
                       (500 "yfx" "+" "-" "/\\" "\\/" "xor")
                       (400 "yfx" "*" "/" "//" "div" "rem" "mod" "<<" ">>")
                       (200 "xfx" "**") (200 "xfy" "^") (200 "fy" "+" "-" "\\")))
        (dolist (name (cddr entry))
          (let ((key (cons name (second entry))))
            (unless (gethash key (iso-state-operators state))
              (setf (gethash key (iso-state-operators state)) (first entry))))))
      (unless (nth-value 1 (gethash "char_conversion" (iso-state-flags state)))
        (setf (gethash "char_conversion" (iso-state-flags state)) :on))
      (unless (nth-value 1 (gethash "double_quotes" (iso-state-flags state)))
        (setf (gethash "double_quotes" (iso-state-flags state)) :codes))
      (setf (iso-state-reader-initialized state) t))
    (iso-state-operators state)))
(defun read-prolog-term (stream &key (database *database*) (package *package*) (source "<stream>") ((:lexer supplied-lexer) nil))
  "Read one full-stop-terminated term. Return TERM, PRESENT-P and transient DCG syntax marks."
  (let ((*term-model* (database-term-model database)))
  (let ((lexer (or supplied-lexer (make-lexer :stream stream :source source)))
        (operators (initialize-reader-operators database))
        (variables (make-hash-table :test 'equal)) (marks (make-hash-table :test 'eq))
        (depth 0) (package (find-package package)))
    (setf (lexer-conversions lexer)
          (let ((state (iso-state-for database)))
            (and (eq (gethash "char_conversion" (iso-state-flags state)) :on)
                 (iso-state-conversions state))))
    (unless package (error "Unknown Prolog target package"))
    (labels ((atom-symbol (text &optional quoted)
               (if (or (and (eq *term-model* :iso) (member text '("nil" "[]" "." "$cons" "$nil") :test #'string=))
                       (and quoted (not (string= text (string-downcase text))))
                       (and (plusp (length text)) (char= (char text 0) #\?)))
                   (iso-atom text) (intern (string-upcase text) package)))
             (token-is (text)
               (let ((token (peek-token lexer)))
                 (and (not (eq (car token) :quoted))
                      (stringp (cdr token)) (string= text (cdr token)))))
             (operator (text kinds maximum left)
               (loop for kind in kinds for p = (gethash (cons text kind) operators)
                     when (and p (<= p maximum)
                               (or (null left) (if (char= (char kind 0) #\x) (< left p) (<= left p))))
                     return (cons p kind)))
             (expression (maximum &optional stop)
               (incf depth)
               (when (> depth 64) (prolog-syntax-error lexer "reader_nesting_limit"))
               (unwind-protect
                    (multiple-value-bind (value priority) (primary maximum)
                      (loop for token = (peek-token lexer)
                            for text = (and (member (car token) '(:atom :punctuation)) (cdr token))
                            for op = (and text (operator text '("xfx" "xfy" "yfx" "xf" "yf") maximum priority))
                            while (and op (not (equal (cons text op) stop))) do
                              (take-token lexer)
                              (let ((p (car op)) (kind (cdr op)))
                                (cond
                                  ((= (length kind) 2) (setf value (list (atom-symbol text) value)))
                                  ((string= kind "xfy")
                                   ;; A flat right-associative chain consumes no parser
                                   ;; frames per operator; nested subterms retain the limit.
                                   (let ((items (list value)) (stop (cons text op)))
                                     (loop
                                       (multiple-value-bind (right right-priority) (expression p stop)
                                         (push right items)
                                         (let* ((next (peek-token lexer))
                                                (next-text (and (member (car next) '(:atom :punctuation)) (cdr next)))
                                                (next-op (and next-text (operator next-text '("xfx" "xfy" "yfx" "xf" "yf") p right-priority))))
                                           (unless (equal (cons next-text next-op) stop) (return))
                                           (take-token lexer))))
                                     (setf value (car items))
                                     (dolist (left (cdr items)) (setf value (list (atom-symbol text) left value)))))
                                  (t (setf value (list (atom-symbol text) value (expression (1- p))))))
                                (setf priority p))
                            finally (return (values value priority))))
                 (decf depth)))
             (list-term ()
               (if (token-is "]") (progn (take-token lexer) (iso-empty-list))
                   (let ((items nil) (tail (iso-empty-list)))
                     (loop (push (expression 999) items)
                       (cond ((token-is ",") (take-token lexer))
                             ((token-is "|") (take-token lexer) (setf tail (expression 999))
                              (expect-token lexer "]") (return))
                             (t (expect-token lexer "]") (return))))
                     (setf tail (iso-list-from-host (nreverse items) tail))
                     (setf (gethash tail marks) :terminals) tail)))
             (primary (maximum)
               (let* ((token (take-token lexer)) (kind (car token)) (text (cdr token))
                      (end-line (lexer-line lexer)) (end-column (lexer-column lexer)))
                 (cond
                   ((eq kind :number) (values text 0))
                   ((eq kind :variable)
                    (values (if (string= text "_") (make-symbol "?")
                                (or (gethash text variables)
                                    (setf (gethash text variables) (make-symbol (concatenate 'string "?" text))))) 0))
                   ((eq kind :string)
                    (values (case (gethash "double_quotes" (iso-state-flags (iso-state-for database)))
                              (:atom (atom-symbol text t))
                              (:chars (iso-list-from-host (map 'list (lambda (c) (atom-symbol (string c) t)) text)))
                              (otherwise (iso-list-from-host (map 'list #'char-code text)))) 0))
                   ((and (eq kind :punctuation) (string= text "("))
                    (let ((value (expression 1200))) (expect-token lexer ")") (values value 0)))
                   ((and (eq kind :punctuation) (string= text "[")) (values (list-term) 0))
                   ((and (eq kind :punctuation) (string= text "{"))
                    (let ((value (expression 1200))) (expect-token lexer "}")
                      (values (list (atom-symbol "{}") value) 0)))
                   ((or (member kind '(:atom :quoted))
                        (and (eq kind :punctuation) (member text '("!" ";") :test #'string=)))
                    (let ((name (atom-symbol text (eq kind :quoted))))
                      (cond
                        ((and (token-is "(")
                              (or (eq kind :quoted)
                                  (and (= end-line (lexer-token-line lexer))
                                       (= end-column (lexer-token-column lexer)))
                                  (null (operator text '("fx" "fy") maximum nil))))
                         (take-token lexer)
                         (let ((arguments nil))
                           (unless (token-is ")")
                             (loop (push (expression 999) arguments)
                               (unless (token-is ",") (return)) (take-token lexer)))
                           (expect-token lexer ")")
                           (let ((arguments (nreverse arguments)))
                             (values (if (eq *term-model* :iso)
                                         (apply #'iso-compound name arguments)
                                         (cons name arguments)) 0))))
                        (t
                         (let ((op (and (not (eq kind :quoted)) (operator text '("fx" "fy") maximum nil))))
                           (if (and op (not (some #'token-is '("," ")" "]" "|" "}" "." ";"))))
                               (let ((value (expression (if (string= (cdr op) "fx") (1- (car op)) (car op)))))
                                 (values (cond ((and (numberp value) (string= text "-")) (- value))
                                               ((and (numberp value) (string= text "+")) value)
                                               (t (list name value))) (car op)))
                               (values name 0)))))))
                   (t (prolog-syntax-error lexer "expected_term"))))))
      (unwind-protect
           (progn
             (when (eq (car (peek-token lexer)) :eof)
               (return-from read-prolog-term (values nil nil marks)))
             (let ((term (expression 1200)))
               (expect-token lexer ".") (values term t marks)))
        (unless supplied-lexer (flush-lookahead lexer)))))))
(defun parse-prolog-string (string &key (database *database*) (package *package*))
  "Parse terms without registering clauses or executing directives."
  (with-input-from-string (stream string)
    (loop for (term present) = (multiple-value-list (read-prolog-term stream :database database :package package :source "<string>"))
          while present collect term)))
