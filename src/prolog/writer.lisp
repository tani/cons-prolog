(uiop:define-package #:sprolog/src/prolog/writer
  (:use #:cl)
  (:import-from #:sprolog/src/kernel/engine #:deref)
  (:import-from #:sprolog/src/kernel/model #:*term-model* #:database-term-model #:logic-var-p)
  (:import-from #:sprolog/src/adapters/term-ops
    #:iso-acyclic-p #:iso-atom #:iso-atom-name #:iso-error #:iso-list #:iso-required #:iso-text #:iso-empty-list #:iso-null-p #:iso-list-cell-p #:iso-list-head #:iso-list-tail)
  (:import-from #:sprolog/src/adapters/adapter #:iso-number-string)
  (:import-from #:sprolog/src/prolog/reader #:initialize-reader-operators)
  (:export #:write-prolog-term))
(in-package #:sprolog/src/prolog/writer)

(defun identifier-atom-p (text)
  (and (plusp (length text)) (alpha-char-p (char text 0))
       (not (upper-case-p (char text 0)))
       (every (lambda (c) (or (alphanumericp c) (char= c #\_))) text)))
(defun graphic-atom-p (text)
  (and (plusp (length text))
       (every (lambda (c) (find c "#$&*+-./:<=>?@\\^~")) text)
       (not (string= text "."))
       (not (uiop:string-prefix-p "/*" text))))
(defun bare-atom-p (text)
  (or (identifier-atom-p text) (graphic-atom-p text)
      (member text '("!" ";") :test #'string=)))
(defun prolog-variable-name-p (text)
  (and (plusp (length text))
       (or (upper-case-p (char text 0)) (char= (char text 0) #\_))
       (not (string= text "_"))
       (every (lambda (c) (or (alphanumericp c) (char= c #\_))) text)))
(defun write-quoted-atom (text out)
  (write-char #\' out)
  (loop for c across text for code = (char-code c) do
    (cond ((char= c #\') (write-string "''" out))
          ((char= c #\\) (write-string "\\\\" out))
          ((assoc code '((7 . "a") (8 . "b") (9 . "t") (10 . "n")
                         (11 . "v") (12 . "f") (13 . "r")))
           (write-char #\\ out)
           (write-string (cdr (assoc code '((7 . "a") (8 . "b") (9 . "t") (10 . "n")
                                          (11 . "v") (12 . "f") (13 . "r")))) out))
          ((or (< code 32) (= code 127)) (format out "\\x~X\\" code))
          ((or (> code #x10ffff) (<= #xd800 code #xdfff))
           (iso-error "representation_error" (iso-atom "character_code")))
          (t (write-char c out))))
  (write-char #\' out))

(defun write-prolog-term (stream term database &key quoted ignore-ops numbervars (variable-names nil names-supplied-p))
  (let ((*term-model* (database-term-model database)))
    (unless names-supplied-p (setf variable-names (iso-empty-list)))
  ;; Native applications retain their original interpretation. Strict list
  ;; cells have an explicit functor and can print as brackets or canonical dot/2.
  ;; Use an explicit task stack even for deeply nested and long flat terms.
  (unless (iso-acyclic-p term)
    (iso-error "representation_error" (iso-atom "acyclic_term")))
  (let ((operators (initialize-reader-operators database))
        (names (make-hash-table :test 'eq)) (used (make-hash-table :test 'equal))
        (serial 0))
    (dolist (pair (iso-list variable-names))
      (let* ((pair (iso-required pair)) (parts (and (consp pair) (if (eq *term-model* :iso) pair (iso-list pair)))))
        (unless (and (consp parts) (consp (cdr parts)) (consp (cddr parts))
                     (null (cdddr parts)) (symbolp (first parts))
                     (string= (iso-atom-name (first parts)) "="))
          (iso-error "domain_error" (iso-atom "variable_name") pair))
        (let ((name (iso-text (second parts))) (var (deref (third parts))))
          (unless (prolog-variable-name-p name)
            (iso-error "domain_error" (iso-atom "variable_name") pair))
          (when (logic-var-p var)
            (when (and (gethash name used) (not (eq var (gethash name used))))
              (iso-error "domain_error" (iso-atom "variable_name") pair))
            (setf (gethash name used) var)
            (unless (gethash var names) (setf (gethash var names) name))))))
    (write-string
      (with-output-to-string (out)
        (let ((work (list (list :term term 1200))))
          (labels ((emit-atom (symbol &optional functor)
                     (let ((text (iso-atom-name symbol)))
                       (if (and quoted
                                (or (not (bare-atom-p text))
                                    (and (not functor)
                                         (loop for kind in '("fx" "fy" "xf" "yf" "xfx" "xfy" "yfx")
                                               thereis (gethash (cons text kind) operators)))))
                           (write-quoted-atom text out) (write-string text out))))
                   (variable-name (var)
                     (or (gethash var names)
                         (loop for name = (format nil "_G~D" serial) do (incf serial)
                               unless (gethash name used)
                                 return (setf (gethash name used) var (gethash var names) name))))
                   (push-terms (items)
                     (loop for rest on (reverse items) do
                       (push (list :term (car rest) 999) work)
                       (when (cdr rest) (push (list :text ",") work))))
                   (operator (name args)
                     (when (and (not ignore-ops) (or (bare-atom-p name) (member name '("," "|") :test #'string=))
                                ;; Prefix numeric +/- would be read back as a number.
                                (not (and (= (length args) 1) (member name '("+" "-") :test #'string=)
                                          (numberp (deref (first args))))))
                       (loop for kind in (case (length args) (1 '("fx" "fy" "xf" "yf"))
                                                               (2 '("xfx" "xfy" "yfx")))
                             for p = (gethash (cons name kind) operators)
                             when p return (cons p kind)))))
            (loop while work do
              (let* ((task (pop work)) (x (second task)) (maximum (third task)))
                (if (eq (first task) :text) (write-string x out)
                    (let ((x (deref x)))
                      (cond
                        ((logic-var-p x) (write-string (variable-name x) out))
                        ((iso-null-p x) (write-string "[]" out))
                        ((symbolp x) (emit-atom x))
                        ((or (integerp x) (floatp x))
                         (let ((text (iso-number-string x)))
                           (unless (every (lambda (c) (or (digit-char-p c) (find c "+-eE."))) text)
                             (iso-error "representation_error" (iso-atom "prolog_number")))
                           ;; A negative literal is parsed through prefix minus.
                           ;; Parentheses prevent a surrounding operator absorbing it.
                           (let ((parenthesize (and (char= (char text 0) #\-)
                                                    (< maximum 1200))))
                             (when parenthesize (write-char #\( out))
                             (write-string text out)
                             (when parenthesize (write-char #\) out)))))
                        ((and (eq *term-model* :iso) (not ignore-ops) (iso-list-cell-p x))
                         (let ((items nil) (tail x))
                           (loop while (iso-list-cell-p tail) do
                             (push (iso-list-head tail) items)
                             (setf tail (deref (iso-list-tail tail))))
                           (write-char #\[ out) (push (list :text "]") work)
                           (unless (iso-null-p tail)
                             (push (list :term tail 999) work) (push (list :text "|") work))
                           (push-terms (nreverse items))))
                        ((consp x)
                         (let ((items nil) (tail x))
                           (loop while (consp tail) do (push (car tail) items) (setf tail (deref (cdr tail))))
                           (setf items (nreverse items))
                           (if (and (null tail) (symbolp (deref (first items))))
                               (let* ((head (deref (first items))) (args (rest items))
                                      (name (iso-atom-name head)) (op (operator name args)))
                                 (cond
                                   ((and numbervars (string= name "$VAR") (= (length args) 1)
                                         (integerp (deref (first args))) (>= (deref (first args)) 0))
                                    (multiple-value-bind (suffix letter) (floor (deref (first args)) 26)
                                      (write-char (code-char (+ (char-code #\A) letter)) out)
                                      (when (plusp suffix) (format out "~D" suffix))))
                                   (op
                                    (let* ((p (car op)) (kind (cdr op)) (parens (> p maximum)))
                                      (when parens (write-char #\( out) (push (list :text ")") work))
                                      (cond
                                        ((= (length kind) 3)
                                         (push (list :term (second args) (if (char= (char kind 2) #\x) (1- p) p)) work)
                                         (push (list :text (concatenate 'string " " name " ")) work)
                                         (push (list :term (first args) (if (char= (char kind 0) #\x) (1- p) p)) work))
                                        ((char= (char kind 0) #\f)
                                         (write-string name out) (write-char #\Space out)
                                         (push (list :term (first args) (if (char= (char kind 1) #\x) (1- p) p)) work))
                                        (t
                                         (push (list :text (concatenate 'string " " name)) work)
                                         (push (list :term (first args) (if (char= (char kind 0) #\x) (1- p) p)) work)))))
                                   (t (emit-atom head t) (write-char #\( out)
                                      (push (list :text ")") work) (push-terms args))))
                               (progn
                                 (write-char #\[ out) (push (list :text "]") work)
                                 (when tail (push (list :term tail 999) work) (push (list :text "|") work))
                                 (push-terms items)))))
                        (t (iso-error "type_error" (iso-atom "prolog_term") x))))))))))
      stream)
    t)))
