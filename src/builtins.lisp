(in-package #:sprolog)

;;; Builtins for a Lisp-native cons term model. ISO conformance is not a goal.
;;; This file is an independent implementation, not a translation of SWI code.

(defpackage #:sprolog/atoms (:use))
(defvar *iso-builtins* (make-hash-table :test 'equal))
(defvar *iso-aliases* (make-hash-table :test 'equal))
(defvar *iso-context* nil)
(defvar *iso-halt-function* (lambda (status) (sb-ext:exit :code status)))
(defun iso-register (name arities)
  (dolist (arity arities) (setf (gethash (cons (string-upcase name) arity) *iso-builtins*) t)))
(defun iso-builtin-p (name arity)
  (and (symbolp name)
       (let ((key (cons (string-upcase (symbol-name name)) arity)))
         (or (gethash key *iso-builtins*) (gethash key *iso-aliases*)))))
(defun builtin-predicate-inventory ()
  "Return the supported core predicate indicators, sorted by name then arity."
  (sort (loop for key being the hash-keys of *iso-builtins* collect (copy-tree key))
        (lambda (a b) (or (string< (car a) (car b))
                         (and (string= (car a) (car b)) (< (cdr a) (cdr b)))))))
(defun iso-atom (name) (if (string-equal name "nil") nil (intern name :sprolog/atoms)))
(defun iso-atom-name (x)
  (cond ((symbolp x) (if (eq (symbol-package x) (find-package :sprolog/atoms))
                         (symbol-name x) (string-downcase (symbol-name x))))
        (t (iso-error "type_error" (iso-atom "atom") x))))
(defun iso-atomic-equal (a b)
  ;; Lisp symbol identity is preserved; generated builtin atoms bridge by name.
  (or (eql a b)
      (and (symbolp a) (symbolp b) 
           (or (eq (symbol-package a) (find-package :sprolog/atoms))
               (eq (symbol-package b) (find-package :sprolog/atoms)))
           (string= (iso-atom-name a) (iso-atom-name b)))))
(defun iso-atom-p (x) (symbolp (deref x)))
(defun iso-compound (name &rest args) (if args (cons name args) name))
(defun iso-parts (term)
  (let ((term (deref term)))
    (if (consp term) (values (car term) (cdr term)) (values term nil))))
(defun iso-error (name &rest args)
  (error 'iso-exception :term
         (iso-compound (iso-atom "error")
                       (apply #'iso-compound (iso-atom name) args)
                       (or *iso-context* (iso-atom "sprolog")))))
(defun iso-required (x)
  (let ((x (deref x)))
    (when (logic-var-p x) (iso-error "instantiation_error")) x))
(defun iso-integer (x &optional nonnegative)
  (let ((x (iso-required x)))
    (unless (integerp x) (iso-error "type_error" (iso-atom "integer") x))
    (when (and nonnegative (minusp x)) (iso-error "domain_error" (iso-atom "not_less_than_zero") x)) x))
(defun iso-text (x) (iso-atom-name (iso-required x)))
(defun iso-list (root)
  (let ((root (deref root)) (seen (make-hash-table :test 'eq)) (result nil))
    (loop while (consp root) do
      (when (gethash root seen)
        (iso-error "type_error" (iso-atom "list") root))
      (setf (gethash root seen) t) (push (car root) result) (setf root (deref (cdr root))))
    (when (logic-var-p root) (iso-error "instantiation_error"))
    (when root (iso-error "type_error" (iso-atom "list") root))
    (nreverse result)))
(defun iso-variables (root)
  (let ((seen (make-hash-table :test 'eq)) (vars nil) (work (list root)))
    (loop while work for x = (deref (pop work)) do
      (unless (gethash x seen)
        (setf (gethash x seen) t)
        (cond ((logic-var-p x) (push x vars))
              ((consp x) (push (cdr x) work) (push (car x) work)))))
    (nreverse vars)))
(defun iso-acyclic-p (root)
  (let ((colors (make-hash-table :test 'eq)) (work (list (cons :enter root))))
    (loop while work for item = (pop work) for x = (deref (cdr item)) do
      (when (consp x)
        (if (eq (car item) :leave) (setf (gethash x colors) :done)
            (case (gethash x colors)
              (:active (return-from iso-acyclic-p nil))
              (:done nil)
              (otherwise (setf (gethash x colors) :active)
                         (push (cons :leave x) work) (push (cons :enter (cdr x)) work)
                         (push (cons :enter (car x)) work)))))) t))
(defun iso-copy (root &optional vm)
  (let ((vars (make-hash-table :test 'eq)))
    (map-term root (lambda (x) (let ((x (deref x)))
                                (if (logic-var-p x)
                                    (or (gethash x vars)
                                        (setf (gethash x vars)
                                              (if vm (fresh-var vm)
                                                  (let ((v (%make-var (hash-table-count vars))))
                                                    (setf (logic-var-binding v) v) v)))) x)))
              (and vm (lambda () (fresh-cons vm nil nil))))))
(defun iso-occurs-p (var term)
  (member var (iso-variables term) :test #'eq))
(defun iso-checked-unify (vm a b)
  (let ((work (list (cons a b))) (seen (make-hash-table :test 'eq)))
    (loop while work for pair = (pop work) for a = (deref (car pair)) for b = (deref (cdr pair)) do
      (cond ((eq a b))
            ((logic-var-p a) (when (iso-occurs-p a b) (return-from iso-checked-unify nil)) (bind-var vm a b))
            ((logic-var-p b) (when (iso-occurs-p b a) (return-from iso-checked-unify nil)) (bind-var vm b a))
            ((and (consp a) (consp b))
             (let ((partners (or (gethash a seen) (setf (gethash a seen) (make-hash-table :test 'eq)))))
               (unless (gethash b partners) (setf (gethash b partners) t)
                 (push (cons (cdr a) (cdr b)) work) (push (cons (car a) (car b)) work))))
            ((not (iso-atomic-equal a b)) (return-from iso-checked-unify nil)))) t))
(defun iso-unifiable-p (a b &optional subsumes)
  (let* ((vm (%make-machine)) (copy (iso-copy (list a b) vm))
         (fixed (and subsumes (iso-variables (second copy)))))
    (and (if subsumes (iso-checked-unify vm (first copy) (second copy))
             (unify vm (first copy) (second copy)))
         (or (not subsumes) (every (lambda (v) (eq v (deref v))) fixed)))))

(defun iso-identical-p (a b)
  ;; EQL atom identity remains the legacy interface's atom convention.
  (let ((work (list (cons a b))) (seen (make-hash-table :test 'eq)))
    (loop while work for pair = (pop work) for a = (deref (car pair)) for b = (deref (cdr pair)) do
      (cond ((iso-atomic-equal a b)) ((or (logic-var-p a) (logic-var-p b)) (return-from iso-identical-p nil))
            ((and (consp a) (consp b))
             (let ((key (cons a b)))
               ;; EQ nested maps avoid EQUAL traversing cyclic terms.
               (declare (ignore key))
               (let ((partners (gethash a seen)))
                 (unless partners (setf partners (make-hash-table :test 'eq) (gethash a seen) partners))
                 (unless (gethash b partners) (setf (gethash b partners) t)
                   (push (cons (cdr a) (cdr b)) work) (push (cons (car a) (car b)) work)))))
            (t (return-from iso-identical-p nil)))) t))
(defun iso-bind (vm target value)
  (let ((target (deref target)))
    (if (and (symbolp target) (symbolp value))
        (string= (iso-atom-name target) (iso-atom-name value)) (unify vm target value))))

;;; Runtime goal compilation uses existing logic variables as Y-register roots.
(defun iso-goal (term)
  (let ((term (iso-required term)))
    (cond ((and (consp term) (finite-list-p term) (symbolp (car term))) term)
          ((symbolp term) (list term))
          (t (iso-error "type_error" (iso-atom "callable") term)))))
(defun iso-predicate-name (symbol arity)
  (let ((name (string-upcase (symbol-name symbol))))
    (or (gethash (cons name arity) *iso-aliases*) name)))
(defun iso-rule-functor-p (symbol)
  (and (symbolp symbol)
       (member (string-upcase (symbol-name symbol)) '(":-" "RULE") :test #'string=)))
(defun iso-control-form-p (goal)
  (or (logic-var-p goal) (variable-symbol-p goal)
      (and (consp goal) (symbolp (car goal))
           (member (iso-predicate-name (car goal) (length (cdr goal))) '(";" "," "->" "\\+" "ONCE" "FALSE") :test #'string=))))
(defun iso-control-instructions (goal table counter tailp)
  (declare (ignore tailp))
  (labels ((compile-one (g) (goal-instructions
                                (if (or (logic-var-p g) (variable-symbol-p g)
                                        (host-goal-p g) (sequence-goals-p g)
                                        (scoped-goals-p g) (disjunction-goal-p g)) g (iso-goal g))
                                table counter nil))
           (scope (instructions) (list (list 'scoped-body instructions)))
           (cut-ir () '((cut))))
    (cond ((or (logic-var-p goal) (variable-symbol-p goal))
           (goal-instructions (list 'call goal) table counter nil))
          (t (let ((name (iso-predicate-name (car goal) (length (cdr goal)))) (args (cdr goal)))
               (unless (= (length args) (if (member name '(";" "," "->") :test #'string=) 2
                                          (if (string= name "FALSE") 0 1)))
                 (iso-error "type_error" (iso-atom "callable") goal))
               (cond ((string= name "FALSE") '((fail)))
                     ((string= name ",") (append (compile-one (first args)) (compile-one (second args))))
                     ((string= name "->") (list (list 'iso-if (compile-one (first args))
                                                       (compile-one (second args)) '((fail)))))
                     ((string= name ";")
                      (let ((left (first args)))
                        (if (and (consp left) (symbolp (car left)) (string= (iso-predicate-name (car left) (length (cdr left))) "->"))
                            (list (list 'iso-if (compile-one (second left)) (compile-one (third left))
                                        (compile-one (second args))))
                            (list (list 'or-branches (list (compile-one left) (compile-one (second args))))))))
                     ((string= name "ONCE") (scope (append (compile-one (first args)) (cut-ir))))
                     (t (scope (list (list 'or-branches
                                         (list (append (scope (compile-one (first args))) (cut-ir) '((fail))) nil)))))))))))
(defun iso-save-continuation (vm)
  (let ((depth (1+ (if (machine-continuation vm) (continuation-depth (machine-continuation vm)) 0))))
    (setf (machine-continuation vm)
          (make-continuation :code (machine-code vm) :pc (machine-pc vm) :slots (machine-slots vm)
                            :cut (machine-cut vm) :scopes (machine-scopes vm) :lineage (machine-slg-lineage vm)
                            :handlers (machine-iso-handlers vm) :parent (machine-continuation vm) :depth depth)
          (machine-max-depth vm) (max depth (machine-max-depth vm)))))
(defun iso-enter (vm goal &optional tailp suffix)
  (let* ((table (make-hash-table :test 'eq)) (counter (list 0))
         (ir (goal-instructions (iso-goal goal) table counter (null suffix)))
         (code (lower-wam-code ir (car counter) t))
         (slots (make-array (car counter))))
    (maphash (lambda (var index) (setf (aref slots index) (if (logic-var-p var) var (fresh-var vm)))) table)
    (unless tailp (iso-save-continuation vm))
    (when (machine-slg-worker vm) (slg-enter-cut-frame vm))
    (setf (machine-code vm) (coerce (append code suffix '((proceed))) 'vector)
          (machine-pc vm) 0 (machine-slots vm) slots (machine-scopes vm) nil
          (machine-cut vm) (length (machine-choices vm))) t))
(defun iso-unknown (vm name arity)
  (case (iso-flag-value (machine-database vm) "unknown")
    (:fail (backtrack vm))
    (:warning (warn "Undefined Prolog predicate ~S/~D" name arity) (backtrack vm))
    (otherwise (iso-error "existence_error" (iso-atom "procedure")
                          (iso-compound (iso-atom "/") name arity)))))
(defun iso-resolve-name (database name arity)
  (or (and (gethash (cons name arity) (database-predicates database)) name)
      (loop for key being the hash-keys of (database-predicates database)
            when (and (= arity (cdr key)) (string= (iso-atom-name name) (iso-atom-name (car key)))) return (car key))
      name))
(defun iso-alternatives (vm alternatives tailp)
  "Install finite alternatives on the WAM choice stack, never on the Lisp stack."
  (unless alternatives (return-from iso-alternatives (backtrack vm)))
  (unless tailp (iso-save-continuation vm))
  (let ((code (make-array 0 :adjustable t :fill-pointer 0)))
    (loop for rest on alternatives do
      (let ((branch (and (cdr rest) (list 'try-branch nil))))
        (when branch (vector-push-extend branch code))
        (vector-push-extend (list 'iso-answer (caar rest) (cdar rest)) code)
        (vector-push-extend '(proceed) code)
        (when branch (setf (second branch) (length code)))))
    (setf (machine-code vm) code (machine-pc vm) 0) t))
(defun iso-result (args &optional action) (cons args action))
(defun iso-instruction-p (op) (member op '(iso-answer iso-catch-end iso-catch-fail iso-repeat)))
(defstruct iso-handler snapshot catcher recovery parent tailp)
(defun iso-execute (vm op operands)
  (case op
    (iso-answer
     (let ((values (iso-copy (first operands) vm)))
       (and (loop for x in values for i from 0 always (iso-bind vm (aref (machine-args vm) i) x))
            (or (null (second operands)) (funcall (second operands))))))
    
    (iso-catch-fail (backtrack vm))
    (iso-repeat (push-choice vm (1- (machine-pc vm)) t) t)
    (iso-catch-end (setf (machine-iso-handlers vm) (iso-handler-parent (machine-iso-handlers vm))) t)))

(defun iso-catch (vm goal catcher recovery tailp)
  ;; Save the protected call's entry state; choice points retain handler chains.
  (let ((snapshot (make-choice :code (machine-code vm) :pc (machine-pc vm)
                              :args (copy-seq (machine-args vm)) :slots (machine-slots vm)
                              :continuation (machine-continuation vm) :cut (machine-cut vm)
                              :scopes (machine-scopes vm) :lineage (machine-slg-lineage vm)
                              :delays (machine-delays vm) :heap (length (machine-heap vm))
                              :trail (length (machine-trail vm)) :age (length (machine-choices vm))
                              :handlers (machine-iso-handlers vm))))
    (let ((code (machine-code vm)) (pc (machine-pc vm)))
      (setf (machine-code vm) #((iso-catch-fail)) (machine-pc vm) 0)
      (push-choice vm 0 t)
      (setf (machine-code vm) code (machine-pc vm) pc))
    (unless tailp (iso-save-continuation vm))
    (setf (machine-iso-handlers vm)
          (make-iso-handler :snapshot snapshot :catcher catcher :recovery recovery
                           :parent (machine-iso-handlers vm) :tailp tailp))
    (iso-enter vm goal t '((iso-catch-end)))))
(defun iso-handle-exception (vm exception)
  (let ((ball (iso-copy (iso-exception-term exception))) (handler (machine-iso-handlers vm)))
    (loop while handler do
      (let* ((cp (iso-handler-snapshot handler)) (catcher (iso-handler-catcher handler))
             (recovery (iso-handler-recovery handler)))
        (setf (machine-iso-handlers vm) (iso-handler-parent handler))
        (unwind-trail vm (choice-trail cp))
        (truncate-vector (machine-heap vm) (choice-heap cp))
        (truncate-vector (machine-choices vm) (choice-age cp))
        (setf (machine-code vm) (choice-code cp) (machine-pc vm) (choice-pc cp)
              (machine-slots vm) (choice-slots cp) (machine-args vm) (choice-args cp)
              (machine-continuation vm) (choice-continuation cp) (machine-cut vm) (choice-cut cp)
              (machine-scopes vm) (choice-scopes cp) (machine-slg-lineage vm) (choice-lineage cp)
              (machine-delays vm) (choice-delays cp))
        (when (iso-unifiable-p catcher ball)
          (unify vm catcher (iso-copy ball vm))
          (return-from iso-handle-exception (iso-enter vm recovery (iso-handler-tailp handler)))))
      (setf handler (iso-handler-parent handler)))
    (error exception)))

;;; Arithmetic: integer arithmetic stays exact; ISO floats are SBCL doubles.
(defun iso-eval (expression)
  (labels ((evaluate (x)
             (let ((x (iso-required x)))
               (when (numberp x)
                 (unless (or (integerp x) (floatp x))
                   (iso-error "type_error" (iso-atom "evaluable") x))
                 (return-from evaluate x))
               (multiple-value-bind (functor args)
                   (if (and (consp x) t) (values (car x) (cdr x)) (iso-parts x))
                 (let* ((spelling (string-upcase (iso-text functor)))
                        (name (or (cdr (assoc spelling '(("LOGAND" . "/\\") ("LOGIOR" . "\\/") ("LOGNOT" . "\\")) :test #'string=)) spelling))
                        (n (length args))
                        (a (and args (evaluate (first args))))
                        (b (and (cdr args) (evaluate (second args)))))
                   (flet ((ints () (unless (and (integerp a) (integerp b))
                                     (iso-error "type_error" (iso-atom "integer") (if (integerp a) b a))))
                          (float-arg () (unless (floatp a) (iso-error "type_error" (iso-atom "float") a)))
                          (arity (expected) (unless (= n expected)
                                              (iso-error "type_error" (iso-atom "evaluable")
                                                         (iso-compound (iso-atom "/") functor n)))))
                     (cond
                       ((string= name "PI") (arity 0) (coerce pi 'double-float))
                       ((string= name "+") (unless (member n '(1 2)) (arity 2)) (if (= n 1) a (+ a b)))
                       ((string= name "-") (unless (member n '(1 2)) (arity 2)) (if (= n 1) (- a) (- a b)))
                       ((string= name "*") (arity 2) (* a b))
                       ((string= name "/") (arity 2) (when (zerop b) (iso-error "evaluation_error" (iso-atom "zero_divisor")))
                        (/ (coerce a 'double-float) (coerce b 'double-float)))
                       ((string= name "//") (arity 2) (ints) (truncate a b))
                       ((string= name "DIV") (arity 2) (ints) (floor a b))
                       ((string= name "REM") (arity 2) (ints) (rem a b))
                       ((string= name "MOD") (arity 2) (ints) (mod a b))
                       ((string= name "**") (arity 2) (expt (coerce a 'double-float) b))
                       ((string= name "^") (arity 2)
                        (if (and (integerp a) (integerp b) (>= b 0)) (expt a b)
                            (expt (coerce a 'double-float) b)))
                       ((string= name "MIN") (arity 2) (min a b))
                       ((string= name "MAX") (arity 2) (max a b))
                       ((string= name "ABS") (arity 1) (abs a))
                       ((string= name "SIGN") (arity 1) (signum a))
                       ((string= name "FLOAT") (arity 1) (coerce a 'double-float))
                       ((string= name "FLOAT_INTEGER_PART") (arity 1) (float-arg) (coerce (truncate a) 'double-float))
                       ((string= name "FLOAT_FRACTIONAL_PART") (arity 1) (float-arg) (- a (truncate a)))
                       ((member name '("FLOOR" "CEILING" "TRUNCATE" "ROUND") :test #'string=)
                        (arity 1) (float-arg)
                        (cond ((string= name "FLOOR") (floor a)) ((string= name "CEILING") (ceiling a))
                              ((string= name "TRUNCATE") (truncate a))
                              (t (if (minusp a) (ceiling (- a 0.5d0)) (floor (+ a 0.5d0))))))
                       ((member name '("SIN" "COS" "TAN" "ASIN" "ACOS" "ATAN" "EXP" "LOG" "SQRT") :test #'string=)
                        (arity 1)
                        (let ((v (funcall (symbol-function (find-symbol name :cl)) (coerce a 'double-float))))
                          (unless (realp v) (iso-error "evaluation_error" (iso-atom "undefined"))) v))
                       ((string= name "ATAN2") (arity 2)
                        (when (and (zerop a) (zerop b)) (iso-error "evaluation_error" (iso-atom "undefined")))
                        (atan (coerce a 'double-float) (coerce b 'double-float)))
                       ((string= name "\\") (arity 1) (iso-integer a) (lognot a))
                       ((member name '("/\\" "\\/" "XOR" "<<" ">>") :test #'string=)
                        (arity 2) (ints)
                        (cond ((string= name "/\\") (logand a b)) ((string= name "\\/") (logior a b))
                              ((string= name "XOR") (logxor a b)) ((string= name "<<") (ash a b))
                              (t (ash a (- b)))))
                       (t (iso-error "type_error" (iso-atom "evaluable")
                                     (iso-compound (iso-atom "/") functor n))))))))))
    (handler-case
        (let ((work (list (list :visit expression))) (values nil)
              (colors (make-hash-table :test 'eq)) (cache (make-hash-table :test 'eq)))
          (loop while work do
            (destructuring-bind (kind node &optional functor count) (pop work)
              (if (eq kind :apply)
                  (let* ((args (nreverse (loop repeat count collect (pop values))))
                         (result (evaluate (if args (cons functor args) functor))))
                    (unless (or (integerp result) (floatp result))
                      (iso-error "evaluation_error" (iso-atom "undefined")))
                    (setf (gethash node colors) :done (gethash node cache) result) (push result values))
                  (let ((x (iso-required node)))
                    (if (numberp x) (push (evaluate x) values)
                        (case (gethash x colors)
                          (:active (iso-error "type_error" (iso-atom "evaluable") x))
                          (:done (push (gethash x cache) values))
                          (otherwise
                           (multiple-value-bind (f args)
                               (if (and (consp x) t) (values (car x) (cdr x)) (iso-parts x))
                             (unless (finite-list-p args) (iso-error "type_error" (iso-atom "evaluable") x))
                             (setf (gethash x colors) :active)
                             (push (list :apply x f (length args)) work)
                             (dolist (arg (reverse args)) (push (list :visit arg) work))))))))))
          (car values))
      (division-by-zero () (iso-error "evaluation_error" (iso-atom "zero_divisor")))
      (floating-point-overflow () (iso-error "evaluation_error" (iso-atom "float_overflow")))
      (floating-point-underflow () (iso-error "evaluation_error" (iso-atom "underflow")))
      (arithmetic-error () (iso-error "evaluation_error" (iso-atom "undefined"))))))

;;; Database-local flags and stream aliases.
(defstruct iso-state (flags (make-hash-table :test 'equal))
  (streams (make-hash-table :test 'eq)) (aliases (make-hash-table :test 'equal))
  (input *standard-input*) (output *standard-output*)
  (dynamic (make-hash-table :test 'equal)))
(defun iso-state-for (database)
  (or (database-iso-state database)
      (setf (database-iso-state database)
            (let ((state (make-iso-state)))
              (dolist (entry '(("bounded" . :false) ("integer_rounding_function" . :toward_zero)
                               ("debug" . :off) ("max_integer" . nil) ("min_integer" . nil)
                               ("unknown" . :error)))
                (unless (member (car entry) '("max_integer" "min_integer") :test #'string=)
                  (setf (gethash (car entry) (iso-state-flags state)) (cdr entry))))
              (setf (gethash "user_input" (iso-state-aliases state)) *standard-input*
                    (gethash "user_output" (iso-state-aliases state)) *standard-output*) state))))
(defun iso-flag-value (db name) (gethash name (iso-state-flags (iso-state-for db))))
(defun iso-set-flag (db name value)
  (let* ((flags (iso-state-flags (iso-state-for db))) (name (iso-text name)) (value (iso-required value)))
    (unless (nth-value 1 (gethash name flags)) (iso-error "domain_error" (iso-atom "prolog_flag") (iso-atom name)))
    (unless (member name '("debug" "unknown") :test #'string=)
      (iso-error "permission_error" (iso-atom "modify") (iso-atom "flag") (iso-atom name)))
    (let ((v (string-downcase (iso-text value))))
      (unless (member v (cond ((string= name "unknown") '("error" "fail" "warning"))
 (t '("on" "off"))) :test #'string=)
        (iso-error "domain_error" (iso-atom "flag_value") (iso-compound (iso-atom "+") (iso-atom name) value)))
      (setf (gethash name flags) (intern (string-upcase v) :keyword))) t))
(defun iso-output-list (root &optional kind)
  (let ((x (deref root)) (seen (make-hash-table :test 'eq)))
    (loop while (consp x) do
      (when (gethash x seen) (iso-error "type_error" (iso-atom "list") root))
      (setf (gethash x seen) t)
      (let ((item (deref (car x))))
        (unless (logic-var-p item)
          (cond ((eq kind :code) (iso-code-char item)) ((eq kind :char) (iso-character item)))))
      (setf x (deref (cdr x))))
    (unless (or (null x) (logic-var-p x)) (iso-error "type_error" (iso-atom "list") root))) t)
(defun iso-output-integer (x &optional nonnegative)
  (unless (logic-var-p (deref x)) (iso-integer x nonnegative)) t)
(defun iso-deterministic (vm name args)
  (let ((a (first args)) (b (second args)) (c (third args)))
    (cond
      ((member name '("TRUE" "!") :test #'string=) t)
      ((member name '("FAIL" "FALSE") :test #'string=) nil)
      ((string= name "=") (unify vm a b))
      ((string= name "\\=") (not (iso-unifiable-p a b)))
      ((string= name "UNIFY_WITH_OCCURS_CHECK") (iso-checked-unify vm a b))
      ((string= name "SUBSUMES_TERM") (iso-unifiable-p a b t))
      ((string= name "VAR") (logic-var-p (deref a)))
      ((string= name "NONVAR") (not (logic-var-p (deref a))))
      ((string= name "ATOM") (iso-atom-p a))
      ((string= name "ATOMIC") (let ((x (deref a))) (or (symbolp x) (numberp x))))
      ((string= name "NUMBER") (let ((x (deref a))) (or (integerp x) (floatp x))))
      ((string= name "INTEGER") (integerp (deref a)))
      ((string= name "FLOAT") (floatp (deref a)))
      ((string= name "COMPOUND") (consp (deref a)))
      ((string= name "CALLABLE") (let ((x (deref a))) (or (symbolp x) (consp x))))
      ((string= name "GROUND") (null (iso-variables a)))
      ((string= name "ACYCLIC_TERM") (iso-acyclic-p a))
      ((string= name "TERM_VARIABLES") (iso-output-list b) (unify vm b (iso-variables a)))
      ((string= name "==") (iso-identical-p a b))
      ((string= name "\\==") (not (iso-identical-p a b)))

      ((string= name "COPY_TERM") (unify vm b (iso-copy a vm)))

      ((string= name "IS") (unify vm a (iso-eval b)))
      ((member name '("<" "=<" ">" ">=" "=:=" "=\\=") :test #'string=)
       (let ((x (iso-eval a)) (y (iso-eval b)))
         (cond ((string= name "<") (< x y)) ((string= name "=<") (<= x y))
               ((string= name ">") (> x y)) ((string= name ">=") (>= x y))
               ((string= name "=:=") (= x y)) (t (/= x y)))))
      
      ((string= name "ATOM_LENGTH") (iso-output-integer b t) (unify vm b (length (iso-text a))))
      ((member name '("ATOM_CHARS" "ATOM_CODES" "NUMBER_CHARS" "NUMBER_CODES") :test #'string=)
       (iso-output-list b (if (search "CODES" name) :code :char))
       (let ((numbers (search "NUMBER" name)) (codes (search "CODES" name)) (x (deref a)))
         (if (logic-var-p x)
             (let* ((items (iso-list b))
                    (text (coerce (mapcar (lambda (v) (if codes (iso-code-char v) (iso-character v))) items) 'string)))
               (iso-bind vm a (if numbers (iso-parse-number text) (iso-atom text))))
             (let ((text (if numbers
                             (progn (unless (or (integerp x) (floatp x)) (iso-error "type_error" (iso-atom "number") x))
                                    (iso-number-string x)) (iso-text x))))
               (unify vm b (map 'list (lambda (ch) (if codes (char-code ch) (iso-atom (string ch)))) text))))))
      ((string= name "CHAR_CODE")
       (unless (logic-var-p (deref b)) (iso-code-char b))
       (if (logic-var-p (deref a)) (iso-bind vm a (iso-atom (string (iso-code-char b))))
           (unify vm b (char-code (iso-character a)))))
      ((string= name "SET_PROLOG_FLAG") (iso-set-flag (machine-database vm) a b))

      ((member name '("ASSERTA" "ASSERTZ" "ABOLISH" "RETRACTALL") :test #'string=) (iso-modify vm name a))
      ((member name '("HALT") :test #'string=)
       (funcall *iso-halt-function* (if args (iso-integer a) 0)) t)
      (t (iso-io vm name args)))))
(defun iso-character (x)
  (let ((s (iso-text x)))
    (unless (= (length s) 1) (iso-error "type_error" (iso-atom "character") x)) (char s 0)))
(defun iso-code-char (x)
  (let* ((n (iso-integer x)) (ch (and (<= 0 n #x10ffff) (not (<= #xd800 n #xdfff)) (code-char n))))
    (unless ch (iso-error "representation_error" (iso-atom "character_code"))) ch))
(defun iso-number-string (number)
  (let ((*read-default-float-format* 'double-float))
    (substitute #\e #\d (string-downcase (write-to-string number :readably t)))))
(defun iso-parse-number (text)
  (let* ((text (string-left-trim '(#\Space #\Tab #\Newline #\Return #\Page) text))
         (sign (if (and (plusp (length text)) (char= (char text 0) #\-)) -1 1))
         (unsigned (if (and (plusp (length text)) (find (char text 0) "+-")) (subseq text 1) text)))
    (when (and (> (length unsigned) 2) (char= (char unsigned 0) #\0) (find (char unsigned 1) "box"))
      (let ((radix (case (char unsigned 1) (#\b 2) (#\o 8) (t 16))) (digits (subseq unsigned 2)))
        (unless (every (lambda (ch) (digit-char-p ch radix)) digits) (iso-error "syntax_error" (iso-atom "number")))
        (return-from iso-parse-number (* sign (parse-integer digits :radix radix)))))
    (when (and (> (length unsigned) 2) (string= unsigned "0'" :end1 2))
      (let* ((suffix (subseq unsigned 2))
             (ch (cond ((= (length suffix) 1) (char suffix 0))
                       ((and (= (length suffix) 2) (char= (char suffix 0) #\\))
                        (case (char suffix 1) (#\n #\Newline) (#\t #\Tab) (#\r #\Return) (t (char suffix 1)))))))
        (unless ch (iso-error "syntax_error" (iso-atom "number")))
        (return-from iso-parse-number (* sign (char-code ch)))))
    ;; Only numeric tokens reach the host reader, with reader evaluation off.
    (unless (and (plusp (length text))
                 (every (lambda (ch) (or (digit-char-p ch) (find ch "+-eE."))) text)
                 (not (char= (char text (1- (length text))) #\.)))
      (iso-error "syntax_error" (iso-atom "number")))
    (handler-case
        (let ((*read-eval* nil) (*read-default-float-format* 'double-float))
          (multiple-value-bind (value pos) (read-from-string text nil :eof)
            (unless (and (or (integerp value) (and (floatp value) (find #\. text))) (= pos (length text)))
              (iso-error "syntax_error" (iso-atom "number"))) value))
      (iso-exception (c) (error c)) (error () (iso-error "syntax_error" (iso-atom "number"))))))

;;; Dynamic predicates use immutable clause/code snapshots (logical update view).
(defun iso-clause-parts (term)
  (let ((term (iso-required term)))
    (multiple-value-bind (f fields) (if (and (consp term) t)
                                     (values (car term) (cdr term)) (iso-parts term))
      (if (and (iso-rule-functor-p f) (= (length fields) 2))
          (values (iso-goal (first fields)) (second fields))
          (values (iso-goal term) (iso-atom "true"))))))
(defun iso-body-list (body)
  (let ((work (list body)) (result nil))
    (loop while work for x = (pop work) for g = (iso-goal x) do
      (if (and (string= (iso-predicate-name (car g) (length (cdr g))) ",") (= (length (cdr g)) 2))
          (progn (push (third g) work) (push (second g) work)) (push g result)))
    (nreverse result)))
(defun iso-body-term (body)
  (if (null body) (iso-atom "true")
      (reduce (lambda (a b) (iso-compound (iso-atom ",") a b))
              (mapcar (lambda (g) (if (host-goal-p g)
                                    (iso-error "permission_error" (iso-atom "access") (iso-atom "private_procedure") g)
                                    (if (null (cdr g)) (car g) g)))
                      body) :from-end t)))
(defun iso-publish (db key clauses)
  (incf (database-generation db))
  (setf (gethash key (database-predicates db))
        (make-predicate :clauses clauses :code (compile-predicate clauses))) t)
(defun iso-indicator (term)
  (let ((term (iso-required term)))
    (multiple-value-bind (f args) (if (and (consp term) t)
                                    (values (car term) (cdr term)) (iso-parts term))
      (unless (and (symbolp f) (string= (iso-text f) "/") (= (length args) 2))
        (iso-error "type_error" (iso-atom "predicate_indicator") term))
      (iso-text (first args)) (cons (first args) (iso-integer (second args) t)))))
(defun iso-check-modifiable (db key)
  (when (iso-builtin-p (car key) (cdr key))
    (iso-error "permission_error" (iso-atom "modify") (iso-atom "static_procedure")
               (iso-compound (iso-atom "/") (car key) (cdr key))))
  ;; Lisp-defined predicates remain writable, consistent with <- / <--.
  (setf (gethash key (iso-state-dynamic (iso-state-for db))) t))
(defun iso-modify (vm name term)
  (let ((db (machine-database vm)))
    (cond
      ((string= name "ABOLISH")
       (let* ((key (iso-indicator term)) (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key))))
         (iso-check-modifiable db key) (incf (database-generation db))
         (remhash key (database-predicates db)) (remhash key (database-tabled db)) t))
      ((string= name "RETRACTALL")
       (let* ((head (iso-goal term)) (key (predicate-key head))
              (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key)))
              (p (gethash key (database-predicates db))))
         (iso-check-modifiable db key)
         (iso-publish db key
                      (remove-if (lambda (clause) (iso-unifiable-p (cdr head) (cdr (car clause))))
                                 (and p (predicate-clauses p))))))
      (t (multiple-value-bind (head body) (iso-clause-parts term)
           ;; Reify stored variables with a single naming map across head and body.
           (let* ((clause (reify (cons head (iso-body-list body)))) (key (predicate-key head))
                  (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key)))
                  (p (gethash key (database-predicates db))))
             (iso-check-modifiable db key) (setf (caar clause) (car key))
             (iso-publish db key (if (string= name "ASSERTA")
                                    (cons clause (and p (predicate-clauses p)))
                                    (append (and p (predicate-clauses p)) (list clause))))))))))
(defun iso-clause-alternatives (vm name args)
  (let* ((db (machine-database vm)) (term (first args)) (head nil) (body nil))
    (if (string= name "CLAUSE") (setf head (iso-goal term) body (second args))
        (multiple-value-setq (head body) (iso-clause-parts term)))
    (let* ((key (predicate-key head)) (key (cons (iso-resolve-name db (car key) (cdr key)) (cdr key)))
           (p (gethash key (database-predicates db))) (results nil))
      (when (iso-builtin-p (car key) (cdr key))
        (iso-error "permission_error" (iso-atom "access") (iso-atom "private_procedure") term))
      (dolist (clause (and p (copy-list (predicate-clauses p))))
        (let* ((copy (term-template (cons (cdr (car clause)) (iso-body-term (cdr clause)))
                                    (make-hash-table :test 'eq) (list 0)))
               (max-index -1))
          (map-term copy (lambda (x) (when (slot-ref-p x) (setf max-index (max max-index (slot-ref-index x)))) x))
          (let* ((slots (make-array (1+ max-index))) (candidate nil))
            (dotimes (i (length slots)) (let ((v (%make-var i))) (setf (logic-var-binding v) v (aref slots i) v)))
            (setf candidate (instantiate copy slots))
            (when (iso-unifiable-p (cons (cdr head)
                                         (if (logic-var-p (deref body)) body (iso-body-term (iso-body-list body)))) candidate)
              (let ((h (cons (car head) (car candidate)))
                    (b (cdr candidate)))
                (push (iso-result
                       (if (string= name "CLAUSE")
                           (list h b)
                           (list (multiple-value-bind (f aa) (values (car (deref term)) (cdr (deref term)))
                                   (if (and (iso-rule-functor-p f) (= (length aa) 2))
                                       (list f h b)
                                       h))))
                       (when (string= name "RETRACT")
                         (let ((selected clause))
                           (lambda ()
                             (let ((current (gethash key (database-predicates db))))
                               (when (member selected (and current (predicate-clauses current)) :test #'eq)
                                 (iso-publish db key (remove selected (predicate-clauses current) :test #'eq :count 1))))))))
                      results))))))
      (nreverse results))))
(defun iso-child-solutions (vm template goal free)
  (let* ((child (%make-machine :database (machine-database vm) :code #((yield)) :args #()
                              :gc-floor (machine-gc-floor vm) :gc-limit (machine-gc-floor vm)))
         (roots (iso-copy (list template goal free) child)) (answers nil))
    (setf (machine-variables child) (list (cons :roots roots)))
    (unwind-protect
         (progn (iso-enter child (second roots))
                (loop while (nth-value 1 (next-solution child)) do
                  (push (iso-copy (list (first roots) (third roots)) vm) answers)))
      (close-query child))
    (nreverse answers)))
(defun iso-variant-p (a b)
  (let ((forward (make-hash-table :test 'eq)) (backward (make-hash-table :test 'eq))
        (seen (make-hash-table :test 'eq)) (work (list (cons a b))))
    (loop while work for pair = (pop work) for x = (deref (car pair)) for y = (deref (cdr pair)) do
      (cond ((and (logic-var-p x) (logic-var-p y))
             (when (or (and (gethash x forward) (not (eq (gethash x forward) y)))
                       (and (gethash y backward) (not (eq (gethash y backward) x))))
               (return-from iso-variant-p nil))
             (setf (gethash x forward) y (gethash y backward) x))
            ((or (logic-var-p x) (logic-var-p y)) (return-from iso-variant-p nil))
            ((and (consp x) (consp y))
             (let ((partners (or (gethash x seen) (setf (gethash x seen) (make-hash-table :test 'eq)))))
               (unless (gethash y partners) (setf (gethash y partners) t)
                 (push (cons (car x) (car y)) work) (push (cons (cdr x) (cdr y)) work))))
            ((not (iso-atomic-equal x y)) (return-from iso-variant-p nil)))) t))
(defun iso-collect (vm name args)
  (destructuring-bind (template goal output) args
    (iso-output-list output)
    (let ((existential nil) (actual goal))
      (loop for g = (iso-goal actual) while (and (string= (iso-text (car g)) "^") (= (length g) 3)) do
        (setf existential (append existential (iso-variables (second g))) actual (third g)))
      (let* ((free (unless (string= name "FINDALL")
                     (set-difference (iso-variables actual) (append (iso-variables template) existential) :test #'eq)))
             (answers (iso-child-solutions vm template actual free)))
        (if (string= name "FINDALL")
            (list (iso-result (list template goal (mapcar #'first answers))))
            (let ((groups nil))
              (dolist (answer answers)
                (let ((group (find (second answer) groups :key #'car
                                   :test #'iso-variant-p)))
                  (if group (progn (unify vm (car group) (second answer))
                                   (setf (cdr group) (append (cdr group) (list (first answer)))))
                      (push (cons (second answer) (list (first answer))) groups))))
              (setf groups (nreverse groups))
              (mapcar
               (lambda (group)
                 (let ((values (cdr group)) (bindings (pairlis free (car group))))
                   (iso-result
                    (list template
                          (map-term goal (lambda (x) (let ((entry (assoc (deref x) bindings :test #'eq)))
                                                       (if entry (cdr entry) (deref x))))) values)))) groups)))))))
(defun iso-enumerate (vm name args)
  (let ((a (first args)) (b (second args)) (c (third args)) (db (machine-database vm)) (results nil))
    (cond
      ((string= name "ATOM_CONCAT")
       (let ((x (deref a)) (y (deref b)) (z (deref c)))
         (if (and (not (logic-var-p x)) (not (logic-var-p y)))
             (push (iso-result (list a b (iso-atom (concatenate 'string (iso-text x) (iso-text y))))) results)
             (let ((text (iso-text z)))
               (dotimes (i (1+ (length text)))
                 (when (and (or (logic-var-p x) (string= (iso-text x) (subseq text 0 i)))
                            (or (logic-var-p y) (string= (iso-text y) (subseq text i))))
                   (push (iso-result (list (if (logic-var-p x) (iso-atom (subseq text 0 i)) x)
                                          (if (logic-var-p y) (iso-atom (subseq text i)) y) c)) results)))))))
      ((string= name "SUB_ATOM")
       (let* ((text (iso-text a)) (len (length text)) (before (deref b)) (length (deref c))
              (after (deref (fourth args))) (sub (deref (fifth args))))
         (dolist (x (list before length after)) (unless (logic-var-p x) (iso-integer x t)))
         (unless (logic-var-p sub) (iso-text sub))
         (loop for i from 0 to len do (loop for n from 0 to (- len i) for j = (- len i n) do
           (when (and (or (logic-var-p before) (= before i)) (or (logic-var-p length) (= length n))
                      (or (logic-var-p after) (= after j))
                      (or (logic-var-p sub) (string= (iso-text sub) (subseq text i (+ i n)))))
             (push (iso-result (list a i n j (if (logic-var-p sub) (iso-atom (subseq text i (+ i n))) sub))) results))))))
      ((member name '("FINDALL" "BAGOF") :test #'string=)
       (return-from iso-enumerate (iso-collect vm name args)))
      ((member name '("CLAUSE" "RETRACT") :test #'string=)
       (return-from iso-enumerate (iso-clause-alternatives vm name args)))
      ((string= name "CURRENT_PREDICATE")
       (maphash (lambda (key p) (declare (ignore p))
                  (push (iso-result (list (iso-compound (iso-atom "/") (car key) (cdr key)))) results))
                (database-predicates db)))
      ((string= name "CURRENT_PROLOG_FLAG")
       (unless (logic-var-p (deref a))
         (let ((n (iso-text a)))
           (unless (nth-value 1 (gethash n (iso-state-flags (iso-state-for db))))
             (iso-error "domain_error" (iso-atom "prolog_flag") a))))
       (maphash (lambda (key value) (push (iso-result (list (iso-atom key) (if (keywordp value) (iso-atom (string-downcase (symbol-name value))) value))) results))
                (iso-state-flags (iso-state-for db))))

      ((string= name "STREAM_PROPERTY") (return-from iso-enumerate (iso-stream-properties vm args)))
      (t (error "No builtin enumerator for ~A" name)))
    (nreverse results)))
(defun iso-invoke (vm symbol arity tailp)
  (let* ((spelling (string-upcase (symbol-name symbol)))
         (name (or (gethash (cons spelling arity) *iso-aliases*) spelling))
         (args (coerce (subseq (machine-args vm) 0 arity) 'list))
         (*iso-context* (iso-compound (iso-atom "/") symbol arity)))
    (cond
      ((string= name "CALL")
       (let* ((goal (iso-goal (first args))) (goal (append goal (cdr args))))
         (setf (car goal) (iso-resolve-name (machine-database vm) (car goal) (length (cdr goal))))
         (iso-enter vm goal tailp)))
      ((member name '(";" "," "->" "\\+" "ONCE") :test #'string=)
       (iso-enter vm (cons symbol args) tailp))
      ((string= name "CATCH")
       (iso-catch vm (first args) (second args) (third args) tailp))
      ((string= name "THROW") (error 'iso-exception :term (iso-copy (iso-required (first args)))))
      ((string= name "REPEAT")
       (unless tailp (iso-save-continuation vm))
       (setf (machine-code vm) #((iso-repeat) (proceed)) (machine-pc vm) 0) t)
      
      ((member name '("ATOM_CONCAT" "SUB_ATOM" "CURRENT_PREDICATE" "CURRENT_PROLOG_FLAG" "STREAM_PROPERTY" "CLAUSE" "RETRACT" "FINDALL" "BAGOF") :test #'string=)
       (iso-alternatives vm (iso-enumerate vm name args) tailp))
      (t (if (iso-deterministic vm name args)
             (progn (when tailp (restore-continuation vm)) t) (backtrack vm))))))

;;; Streams and options.
(defstruct iso-stream stream file mode (type "text") alias (reposition nil) (eof-action "eof_code") (past-end nil) (byte-look :empty))
(defun iso-options (term allowed)
  (let ((result nil))
    (dolist (option (iso-list term))
      (let ((option (iso-required option)))
        (multiple-value-bind (f args)
            (if (and (consp option) t) (values (car option) (cdr option)) (iso-parts option))
          (unless (and (symbolp f) (member (iso-text f) allowed :test #'string=) (= (length args) 1))
            (iso-error "domain_error" (iso-atom "option") option))
          (push (cons (iso-text f) (first args)) result)))) (nreverse result)))
(defun iso-option (options name default) (let ((entry (assoc name options :test #'string=))) (if entry (cdr entry) default)))
(defun iso-boolean (term)
  (let ((s (iso-text term)))
    (cond ((string= s "true") t) ((string= s "false") nil)
          (t (iso-error "domain_error" (iso-atom "boolean") term)))))
(defun iso-stream-for (vm term &optional direction type)
  (let* ((state (iso-state-for (machine-database vm))) (x (iso-required term))
         (stream (cond ((streamp x) x) ((symbolp x) (gethash (iso-text x) (iso-state-aliases state)))
                       (t (iso-error "type_error" (iso-atom "stream_or_alias") x)))))
    (unless (and stream (open-stream-p stream)) (iso-error "existence_error" (iso-atom "stream") x))
    (when (and direction (not (if (eq direction :input) (input-stream-p stream) (output-stream-p stream))))
      (iso-error "permission_error" (iso-atom (if (eq direction :input) "input" "output")) (iso-atom "stream") x))
    (let ((meta (or (gethash stream (iso-state-streams state))
                    (setf (gethash stream (iso-state-streams state))
                          (make-iso-stream :stream stream :mode (if (input-stream-p stream) "read" "write")
                                           :type (if (subtypep (stream-element-type stream) 'character) "text" "binary"))))))
      (when (and type (not (string= type (iso-stream-type meta))))
        (iso-error "permission_error" (iso-atom (if (eq direction :input) "input" "output"))
                   (iso-atom (if (string= type "text") "binary_stream" "text_stream")) x))
      (values stream meta))))
(defun iso-open (vm source mode target options)
  (let* ((file (iso-text source)) (mode (iso-text mode))
         (opts (iso-options options '("type" "reposition" "alias" "eof_action")))
         (type (iso-text (iso-option opts "type" (iso-atom "text"))))
         (reposition (iso-boolean (iso-option opts "reposition" (iso-atom "false"))))
         (alias (let ((x (assoc "alias" opts :test #'string=))) (and x (iso-text (cdr x)))))
         (eof (iso-text (iso-option opts "eof_action" (iso-atom "eof_code"))))
         (state (iso-state-for (machine-database vm))))
    (unless (logic-var-p (deref target)) (iso-error "uninstantiation_error" target))
    (unless (member mode '("read" "write" "append") :test #'string=) (iso-error "domain_error" (iso-atom "io_mode") (iso-atom mode)))
    (unless (member type '("text" "binary") :test #'string=) (iso-error "domain_error" (iso-atom "stream_option") (iso-atom type)))
    (unless (member eof '("error" "eof_code" "reset") :test #'string=) (iso-error "domain_error" (iso-atom "stream_option") (iso-atom eof)))
    (when (and alias (gethash alias (iso-state-aliases state)))
      (iso-error "permission_error" (iso-atom "open") (iso-atom "source_sink") (iso-compound (iso-atom "alias") (iso-atom alias))))
    (let ((stream (handler-case
                      (open file :direction (if (string= mode "read") :input :output)
                                 :element-type (if (string= type "text") 'character '(unsigned-byte 8))
                                 :if-exists (if (string= mode "append") :append :supersede)
                                 :if-does-not-exist (if (string= mode "read") :error :create))
                    (file-error ()
                      (if (string= mode "read") (iso-error "existence_error" (iso-atom "source_sink") source)
                          (iso-error "permission_error" (iso-atom "open") (iso-atom "source_sink") source))))))
      (setf (gethash stream (iso-state-streams state))
            (make-iso-stream :stream stream :file file :mode mode :type type :alias alias :reposition reposition :eof-action eof))
      (when alias (setf (gethash alias (iso-state-aliases state)) stream)) (unify vm target stream))))

(defun iso-stream-properties (vm args)
  (let ((property (deref (second args))))
    (unless (logic-var-p property)
      (multiple-value-bind (f fields) (iso-parts property)
        (unless (and (symbolp f)
                     (member (iso-text f) '("input" "output" "file_name" "mode" "alias" "position" "end_of_stream" "eof_action" "reposition" "type") :test #'string=)
                     (= (length fields) (if (member (iso-text f) '("input" "output") :test #'string=) 0 1)))
          (iso-error "domain_error" (iso-atom "stream_property") property)))))
  (let* ((state (iso-state-for (machine-database vm))) (target (first args)) (streams nil) (answers nil))
    (if (logic-var-p (deref target))
        (progn (iso-stream-for vm (iso-state-input state)) (iso-stream-for vm (iso-state-output state))
               (maphash (lambda (s m) (declare (ignore m)) (when (open-stream-p s) (push s streams))) (iso-state-streams state)))
        (push (iso-stream-for vm target) streams))
    (dolist (stream streams)
      (let* ((meta (gethash stream (iso-state-streams state)))
             (props (list (iso-compound (iso-atom "mode") (iso-atom (iso-stream-mode meta)))
                          (iso-compound (iso-atom "type") (iso-atom (iso-stream-type meta)))
                          (iso-compound (iso-atom "reposition") (iso-atom (if (iso-stream-reposition meta) "true" "false")))
                          (iso-compound (iso-atom "eof_action") (iso-atom (iso-stream-eof-action meta))))))
        (push (iso-atom (if (input-stream-p stream) "input" "output")) props)
        (when (iso-stream-file meta) (push (iso-compound (iso-atom "file_name") (iso-atom (iso-stream-file meta))) props))
        (when (iso-stream-alias meta) (push (iso-compound (iso-atom "alias") (iso-atom (iso-stream-alias meta))) props))
        (when (file-position stream) (push (iso-compound (iso-atom "position") (file-position stream)) props))
        (when (input-stream-p stream)
          (push (iso-compound (iso-atom "end_of_stream")
                              (iso-atom (cond ((iso-stream-past-end meta) "past")
                                              ((iso-stream-end-p stream meta) "at") (t "not")))) props))
        (dolist (property props) (push (iso-result (list stream property)) answers))))
    (nreverse answers)))
(defun iso-stream-end-p (stream meta)
  (null (iso-read-unit stream meta (string= (iso-stream-type meta) "binary") t)))
(defun iso-read-unit (stream meta bytep peekp)
  (when (and (iso-stream-past-end meta) (string= (iso-stream-eof-action meta) "error") (not peekp))
    (iso-error "permission_error" (iso-atom "input") (iso-atom "past_end_of_stream") stream))
  (let ((value
          (if bytep
              (if (not (eq (iso-stream-byte-look meta) :empty))
                  (prog1 (iso-stream-byte-look meta) (unless peekp (setf (iso-stream-byte-look meta) :empty)))
                  (if peekp
                      (let ((position (file-position stream)) (v (read-byte stream nil nil)))
                        (if position (file-position stream position) (setf (iso-stream-byte-look meta) v)) v)
                      (read-byte stream nil nil)))
              (if peekp (peek-char nil stream nil nil) (read-char stream nil nil)))))
    (unless peekp (setf (iso-stream-past-end meta) (null value))) value))
(defun iso-io (vm name args)
  (let* ((state (iso-state-for (machine-database vm))) (a (first args)) (b (second args))
         (n (length args)))
    (cond
      ((string= name "CURRENT_INPUT") (unify vm a (iso-state-input state)))
      ((string= name "CURRENT_OUTPUT") (unify vm a (iso-state-output state)))
      ((string= name "SET_INPUT") (setf (iso-state-input state) (iso-stream-for vm a :input)) t)
      ((string= name "SET_OUTPUT") (setf (iso-state-output state) (iso-stream-for vm a :output)) t)
      ((string= name "OPEN") (iso-open vm a b (third args) (fourth args)))
      ((string= name "CLOSE")
       (let* ((opts (iso-options b '("force"))) (force (iso-boolean (iso-option opts "force" (iso-atom "false")))))
         (multiple-value-bind (s meta) (iso-stream-for vm a)
           (unless (or (eq s *standard-input*) (eq s *standard-output*))
             (handler-case (close s) (stream-error (c) (unless force (error c))))
             (remhash s (iso-state-streams state))
             (when (iso-stream-alias meta) (remhash (iso-stream-alias meta) (iso-state-aliases state)))
             (when (eq (iso-state-input state) s) (setf (iso-state-input state) *standard-input*))
             (when (eq (iso-state-output state) s) (setf (iso-state-output state) *standard-output*))) t)))
      ((string= name "FLUSH_OUTPUT") (finish-output (iso-stream-for vm (if args a (iso-state-output state)) :output)) t)
      ((string= name "AT_END_OF_STREAM")
       (multiple-value-bind (s meta) (iso-stream-for vm (if args a (iso-state-input state)) :input)
         (iso-stream-end-p s meta)))
      ((string= name "SET_STREAM_POSITION")
       (multiple-value-bind (s meta) (iso-stream-for vm a)
         (unless (iso-stream-reposition meta) (iso-error "permission_error" (iso-atom "reposition") (iso-atom "stream") a))
         (let ((pos (iso-integer b t)))
           (unless (file-position s pos) (iso-error "domain_error" (iso-atom "stream_position") b))
           (setf (iso-stream-past-end meta) nil (iso-stream-byte-look meta) :empty) t)))
      ((member name '("GET_CHAR" "GET_CODE" "PEEK_CHAR" "PEEK_CODE" "GET_BYTE" "PEEK_BYTE") :test #'string=)
       (let ((bytep (search "BYTE" name)) (charp (search "CHAR" name)) (peekp (search "PEEK" name))
             (target (if (= n 2) b a)))
         (unless (logic-var-p (deref target))
           (if charp (unless (string= (iso-text target) "end_of_file") (iso-character target))
               (iso-integer target)))
         (multiple-value-bind (s meta) (iso-stream-for vm (if (= n 2) a (iso-state-input state)) :input (if bytep "binary" "text"))
           (let ((v (iso-read-unit s meta bytep peekp)))
             (iso-bind vm target (if charp (iso-atom (if v (string v) "end_of_file"))
                                    (if v (if bytep v (char-code v)) -1)))))))
      ((member name '("PUT_CHAR" "PUT_CODE" "PUT_BYTE") :test #'string=)
       (let* ((bytep (string= name "PUT_BYTE")) (target (if (= n 2) b a))
              (s (iso-stream-for vm (if (= n 2) a (iso-state-output state)) :output (if bytep "binary" "text"))))
         (if bytep (let ((v (iso-integer target)))
                     (unless (<= 0 v 255) (iso-error "type_error" (iso-atom "byte") target)) (write-byte v s))
             (write-char (if (string= name "PUT_CHAR") (iso-character target) (iso-code-char target)) s)) t))
      ((string= name "NL") (terpri (iso-stream-for vm (if args a (iso-state-output state)) :output "text")) t)

      (t (error "Missing builtin implementation: ~A/~D" name n)))))

(eval-when (:load-toplevel :execute)
  (clrhash *iso-builtins*)
  (clrhash *iso-aliases*)
  ;; S-expression spellings; retain compatible punctuation aliases.
  (dolist (entry '(("/=" 2 "\\=") ("/==" 2 "\\==")
                   ("=/=" 2 "=\\=") ("===" 2 "=:=")
                   ("/+" 1 "\\+") ("AND" 2 ",") ("OR" 2 ";")))
    (setf (gethash (cons (first entry) (second entry)) *iso-aliases*) (third entry)))
  (dolist (name '("true" "fail" "false" "!" "repeat" "nl" "flush_output" "at_end_of_stream" "halt")) (iso-register name '(0)))
  (iso-register "call" '(1 2 3 4 5 6 7 8))
  (dolist (name '("throw" "\\+" "once" "var" "nonvar" "atom" "atomic" "number" "integer" "float" "compound" "callable" "ground" "acyclic_term"
                  "asserta" "assertz" "retract" "retractall" "abolish" "current_predicate" "current_input" "current_output" "set_input" "set_output" "close" "flush_output" "at_end_of_stream" "nl"     "halt")) (iso-register name '(1)))
  (dolist (name '(";" "," "->" "=" "\\=" "unify_with_occurs_check" "subsumes_term"     "==" "\\=="  "copy_term" "term_variables"   "is" "=<" "<" ">=" ">" "=:=" "=\\=" "clause" "close" "stream_property" "set_stream_position"         "atom_length" "atom_chars" "atom_codes" "char_code" "number_chars" "number_codes" "set_prolog_flag" "current_prolog_flag")) (iso-register name '(2)))
  (dolist (name '("catch"    "findall" "bagof"  "open"     "atom_concat")) (iso-register name '(3)))
  (iso-register "open" '(4)) (iso-register "sub_atom" '(5))
  (dolist (name '("get_char" "get_code" "peek_char" "peek_code" "put_char" "put_code" "get_byte" "peek_byte" "put_byte")) (iso-register name '(1 2))))
