;; ASDF infers load order from this dependency package. Implementation symbols
;; stay in SPROLOG so the public API and internal symbol identities are stable.
(defpackage #:sprolog/src/wam (:use #:cl #:sprolog/src/gc))
(in-package #:sprolog)

(defun ensure-registers (vm count)
  (when (< (length (machine-args vm)) count)
    (let ((new (make-array (max count 16 (* 2 (length (machine-args vm)))) :initial-element nil)))
      (replace new (machine-args vm)) (setf (machine-args vm) new))))
(defun register-value (vm register)
  (ecase (first register)
    ((:x :a) (aref (machine-args vm) (second register)))
    (:y (aref (machine-slots vm) (second register)))))
(defun (setf register-value) (value vm register)
  (ecase (first register)
    ((:x :a) (ensure-registers vm (1+ (second register)))
             (setf (aref (machine-args vm) (second register)) value))
    (:y (setf (aref (machine-slots vm) (second register)) value))))
(defun scan-value (location)
  (if (eq (cdr location) :car) (caar location) (cdar location)))
(defun (setf scan-value) (value location)
  (if (eq (cdr location) :car) (setf (caar location) value) (setf (cdar location) value)))
(defun begin-list (vm register buildp)
  (let ((term (unless buildp (deref (register-value vm register)))))
    (cond ((or buildp (logic-var-p term))
           (let ((cell (fresh-cons vm nil nil)))
             (if buildp (setf (register-value vm register) cell) (bind-var vm term cell))
             (setf (machine-mode vm) :write
                   (machine-scan vm) (list (cons cell :car) (cons cell :cdr)))
             t))
          ((consp term)
           (setf (machine-mode vm) :read
                 (machine-scan vm) (list (cons term :car) (cons term :cdr))) t)
          (t nil))))
(defun new-structure (vm functor arity)
  ;; The public S-expression representation remains (functor arg ...).
  (let* ((root (fresh-cons vm functor nil)) (tail root) (locations nil))
    (dotimes (i arity)
      (let ((cell (fresh-cons vm nil nil)))
        (setf (cdr tail) cell tail cell) (push (cons cell :car) locations)))
    (values root (nreverse locations))))
(defun begin-structure (vm functor arity register buildp)
  (unless (and (integerp arity) (>= arity 0)) (error "Invalid structure arity"))
  (let ((term (unless buildp (deref (register-value vm register)))))
    (when (or buildp (logic-var-p term))
      (multiple-value-bind (root locations) (new-structure vm functor arity)
        (if buildp (setf (register-value vm register) root) (bind-var vm term root))
        (setf (machine-mode vm) :write (machine-scan vm) locations)
        (return-from begin-structure t)))
    (unless (and (consp term) (unify vm (car term) functor))
      (return-from begin-structure nil))
    ;; Open list tails must retain their original cons-based unification semantics.
    (let ((tail (cdr term)) (locations nil))
      (dotimes (i arity)
        (let ((cell (deref tail)))
          (when (logic-var-p cell)
            (let ((new (fresh-cons vm (fresh-var vm) (fresh-var vm))))
              (bind-var vm cell new) (setf cell new)))
          (unless (consp cell) (return-from begin-structure nil))
          (push (cons cell :car) locations) (setf tail (cdr cell))))
      (unless (unify vm tail nil) (return-from begin-structure nil))
      (setf (machine-mode vm) :read (machine-scan vm) (nreverse locations)) t)))
(defun scan-instruction (vm operation operand)
  (let ((location (pop (machine-scan vm))))
    (unless location (error "Term scan exhausted for ~S" operation))
    (ecase operation
      (:variable
       (setf (register-value vm operand)
             (if (eq (machine-mode vm) :read) (scan-value location)
                 (setf (scan-value location) (fresh-var vm)))) t)
      (:value
       (if (eq (machine-mode vm) :read)
           (unify vm (scan-value location) (register-value vm operand))
           (progn (setf (scan-value location) (register-value vm operand)) t)))
      (:constant
       (if (eq (machine-mode vm) :read) (unify vm (scan-value location) operand)
           (progn (setf (scan-value location) operand) t)))
      (:void
       (when (eq (machine-mode vm) :write) (setf (scan-value location) (fresh-var vm))) t))))
(defun execute-term-instruction (vm op operands)
  (case op
    (get-variable (setf (register-value vm (first operands))
                        (register-value vm (second operands))) t)
    (get-value (unify vm (register-value vm (first operands))
                     (register-value vm (second operands))))
    (get-constant (unify vm (first operands) (register-value vm (second operands))))
    (get-list (begin-list vm (first operands) nil))
    (get-structure (begin-structure vm (first operands) (second operands) (third operands) nil))
    (put-variable
     (let ((var (fresh-var vm)))
       (setf (register-value vm (first operands)) var
             (register-value vm (second operands)) var)) t)
    (put-value (setf (register-value vm (second operands))
                     (register-value vm (first operands))) t)
    (put-constant (setf (register-value vm (second operands)) (first operands)) t)
    (put-list (begin-list vm (first operands) t))
    (put-structure (begin-structure vm (first operands) (second operands) (third operands) t))
    ((unify-variable set-variable)
     (when (and (eq op 'set-variable) (not (eq (machine-mode vm) :write)))
       (error "SET instruction in read mode"))
     (scan-instruction vm :variable (first operands)))
    ((unify-value set-value)
     (when (and (eq op 'set-value) (not (eq (machine-mode vm) :write)))
       (error "SET instruction in read mode"))
     (scan-instruction vm :value (first operands)))
    ((unify-constant set-constant)
     (when (and (eq op 'set-constant) (not (eq (machine-mode vm) :write)))
       (error "SET instruction in read mode"))
     (scan-instruction vm :constant (first operands)))
    ((unify-void set-void)
     (when (and (eq op 'set-void) (not (eq (machine-mode vm) :write)))
       (error "SET instruction in read mode"))
     (dotimes (i (first operands)) (scan-instruction vm :void nil)) t)
    (otherwise (error "Unknown instruction ~S" op))))
