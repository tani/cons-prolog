;; ASDF infers load order from this dependency package. Implementation symbols
;; stay in SPROLOG so the public API and internal symbol identities are stable.
(defpackage #:sprolog/src/wam-compiler (:use #:cl #:sprolog/src/compiler))
(in-package #:sprolog)

(defun structure-fields (term)
  "Recognize short proper S-expression structures in bounded time.
Long or open lists use GET_LIST; both encodings have identical cons semantics."
  (when (and (consp term) (symbolp (car term)))
    (let ((tail (cdr term)) (fields nil))
      (loop repeat 8 while (consp tail) do (push (car tail) fields) (setf tail (cdr tail)))
      (when (null tail) (values (nreverse fields) t)))))
(defun compound-fields (term)
  (multiple-value-bind (fields structurep) (structure-fields term)
    (if structurep (values fields t) (values (list (car term) (cdr term)) nil))))

(defun ir-argument-register-count (instructions)
  (let ((work (copy-list instructions)) (maximum 0))
    (loop while work do
      (let* ((instruction (pop work)))
        (case (car instruction)
          (get-term (setf maximum (max maximum (1+ (second instruction)))))
          (put-args (setf maximum (max maximum (length (second instruction)))))
          (unify (setf maximum (max maximum 2)))
          (scoped-body (dolist (child (second instruction)) (push child work)))
          (iso-if (dolist (branch (cdr instruction))
                    (dolist (child branch) (push child work))))
          (or-branches (dolist (branch (second instruction))
                         (dolist (child branch) (push child work)))))))
    maximum))

(defun lower-wam-code (ir slot-count queryp)
  "Lower template IR into X/Y-register WAM term instruction families.
All graph traversals are iterative, including compilation of cyclic templates."
  (let* ((code (make-array 32 :adjustable t :fill-pointer 0))
         (known (make-array slot-count :initial-element queryp))
         (base (ir-argument-register-count ir))
         (temporary base) (allocation nil))
    (labels
        ((emit (op &rest args) (vector-push-extend (cons op args) code))
         (temp () (prog1 (list :x temporary) (incf temporary)))
         (slot (ref) (list :y (slot-ref-index ref)))
         (first-slot-p (ref)
           (let ((index (slot-ref-index ref)))
             (prog1 (not (aref known index)) (setf (aref known index) t))))
         (ensure-slot (ref)
           (when (first-slot-p ref) (let ((x (temp))) (emit 'put-variable (slot ref) x))))
         (head-atom (term register)
           (if (slot-ref-p term)
               (unless (slot-ref-anonymous term)
                 (emit (if (first-slot-p term) 'get-variable 'get-value) (slot term) register))
               (emit 'get-constant term register)))
         (scan-atom (term writep)
           (if (and (slot-ref-p term) (slot-ref-anonymous term))
               (emit (if writep 'set-void 'unify-void) 1)
               (if (slot-ref-p term)
               (emit (if writep
                         (if (first-slot-p term) 'set-variable 'set-value)
                         (if (first-slot-p term) 'unify-variable 'unify-value)) (slot term))
               (emit (if writep 'set-constant 'unify-constant) term))))
         (match-head (root register)
           (if (not (consp root)) (head-atom root register)
               (let ((nodes (make-hash-table :test 'eq)) (work nil))
                 (let ((x (temp))) (setf (gethash root nodes) x)
                   (emit 'get-variable x register) (push root work))
                 (loop while work do
                   (let* ((node (pop work)))
                     (multiple-value-bind (fields structurep) (compound-fields node)
                       (let ((x (gethash node nodes)))
                         (if structurep (emit 'get-structure (car node) (length fields) x)
                             (emit 'get-list x)))
                       (dolist (field fields)
                         (if (consp field)
                             (let ((x (gethash field nodes)))
                               (if x (emit 'unify-value x)
                                   (let ((new (temp)))
                                     (setf (gethash field nodes) new)
                                     (emit 'unify-variable new) (push field work))))
                             (scan-atom field nil)))))))))
         (put-atom (term register)
           (if (slot-ref-p term)
               (emit (if (first-slot-p term) 'put-variable 'put-value) (slot term) register)
               (emit 'put-constant term register)))
         (build-term (root register)
           (if (not (consp root)) (put-atom root register)
               (let ((nodes (make-hash-table :test 'eq)) (order nil) (work (list root)))
                 ;; Assign a stable X reference to every graph node before filling edges.
                 (loop while work do
                   (let* ((node (pop work)))
                     (unless (gethash node nodes)
                       (let ((x (temp))) (setf (gethash node nodes) x)
                         (emit 'put-variable x x))
                       (push node order)
                       (multiple-value-bind (fields structurep) (compound-fields node)
                         (declare (ignore structurep))
                         (dolist (field fields) (when (consp field) (push field work)))))))
                 (let ((scratch (temp)))
                   (dolist (node (nreverse order))
                     (multiple-value-bind (fields structurep) (compound-fields node)
                       (if structurep (emit 'put-structure (car node) (length fields) scratch)
                           (emit 'put-list scratch))
                       (dolist (field fields)
                         (if (consp field) (emit 'set-value (gethash field nodes))
                             (scan-atom field t)))
                       (emit 'get-value scratch (gethash node nodes))))
                   (emit 'put-value (gethash root nodes) register)))))
         (ensure-template-slots (template)
           (let ((seen (make-hash-table :test 'eq)) (work (list template)))
             (loop while work do
               (let* ((x (pop work)))
                 (cond ((slot-ref-p x) (ensure-slot x))
                       ((and (consp x) (not (gethash x seen)))
                        (setf (gethash x seen) t) (push (car x) work) (push (cdr x) work)))))))
         (lower-sequence (sequence)
           (dolist (instruction sequence)
             (let ((op (car instruction)) (args (cdr instruction)))
               (case op
                 (allocate nil)
                 (get-term (match-head (second args) (list :a (first args))))
                 (put-args (loop for term in (first args) for index from 0 do
                             (build-term term (list :a index))))
                 (unify (build-term (first args) '(:a 0))
                        (build-term (second args) '(:a 1))
                        (emit 'get-value '(:a 0) '(:a 1)) (emit 'clear-x))
                 (iso-if
                  (dotimes (index slot-count) (ensure-slot (slot-ref index)))
                  (emit 'enter-cut-scope)
                  (let ((branch (list 'try-branch nil)) (jump (list 'jump nil)))
                    (vector-push-extend branch code)
                    (lower-sequence (first args)) (emit 'cut) (emit 'leave-cut-scope)
                    (lower-sequence (second args)) (vector-push-extend jump code)
                    (setf (second branch) (length code)) (emit 'leave-cut-scope)
                    (lower-sequence (third args))
                    (setf (second jump) (length code))))
                 (tnot (ensure-template-slots (first args))
                       (vector-push-extend instruction code) (emit 'clear-x))
                 (host (dolist (template (second args)) (ensure-template-slots template))
                       (when (third args) (ensure-template-slots (third args)))
                       (vector-push-extend instruction code) (emit 'clear-x))
                 (scoped-body (emit 'enter-cut-scope)
                              (lower-sequence (first args)) (emit 'leave-cut-scope))
                 (or-branches
                  ;; All Y cells exist before the branch choice. Alternatives only bind
                  ;; them, so rollback never needs to undo assignment to a Y slot.
                  (dotimes (index slot-count) (ensure-slot (slot-ref index)))
                  (emit 'clear-x)
                  (let ((jumps nil))
                    (loop for branches on (first args) do
                      (let ((try (and (cdr branches) (list 'try-branch nil))))
                        (when try (vector-push-extend try code))
                        (lower-sequence (car branches))
                        (when (cdr branches)
                          (let ((jump (list 'jump nil)))
                            (vector-push-extend jump code) (push jump jumps))
                          (setf (second try) (length code)))))
                    (dolist (jump jumps) (setf (second jump) (length code)))))
                 ((execute proceed) (unless queryp (emit 'deallocate))
                                    (vector-push-extend instruction code))
                 (otherwise (vector-push-extend instruction code)))))))
      (unless queryp
        (setf allocation (list 'allocate slot-count nil))
        (vector-push-extend allocation code))
      (lower-sequence ir)
      (when allocation (setf (third allocation) temporary))
      (coerce code 'list))))
