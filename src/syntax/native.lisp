;;; Ground functional modes of pure predicates, with guarded VM fallback.
(uiop:define-package #:sprolog/src/syntax/native
  (:use #:cl)
  (:import-from #:sprolog/src/kernel/model)
  (:import-from #:sprolog/src/kernel/engine
    #:index-key #:deref #:unify #:map-term #:restore-continuation #:backtrack)
  (:import-from #:sprolog/src/kernel/protocol
    #:register-provider #:iso-atomic-equal #:iso-primitive-p #:iso-syntax-p)
  (:import-from #:sprolog/src/kernel/runtime #:iso-resolve-name)
  (:import-from #:sprolog/src/kernel/wam)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-acyclic-p)
  (:import-from #:sprolog/src/syntax/dcg)
  (:import-from #:sprolog/src/syntax/compiler #:variable-symbol-p #:anonymous-p)
  (:export #:native-call #:*native-enabled*))
(in-package #:sprolog/src/syntax/native)

(defvar *native-enabled* #+sbcl t #-sbcl nil)
(defvar *term-executor* (symbol-function 'sprolog/src/kernel/wam:execute-term-instruction))
(defconstant +depth-limit+ 2048)
(defvar *compiling-modes* nil)

(defun native-integer (value)
  (unless (integerp value) (throw 'native-deopt nil)) value)

(defun flatten-body (body)
  (loop for goal in body append
    (cond ((sprolog/src/kernel/model:sequence-goals-p goal)
           (flatten-body (sprolog/src/kernel/model:sequence-goals-goals goal)))
          ((and (consp goal) (symbolp (car goal))
                (member (symbol-name (car goal)) '("," "AND") :test #'string-equal)
                (= (length goal) 3))
           (flatten-body (cdr goal)))
          (t (list goal)))))

(defun cut-goal-p (goal)
  (let ((name (if (and (consp goal) (null (cdr goal))) (car goal) goal)))
    (and (symbolp name) (string= (symbol-name name) "!"))))

(defun disjoint-patterns-p (a b &optional (depth 0))
  (when (> depth 64) (throw 'not-functional nil))
  (cond ((or (variable-symbol-p a) (variable-symbol-p b)) nil)
        ((and (consp a) (consp b))
         (or (disjoint-patterns-p (car a) (car b) (1+ depth))
             (disjoint-patterns-p (cdr a) (cdr b) (1+ depth))))
        ((or (consp a) (consp b)) t)
        (t (not (iso-atomic-equal a b)))))

(defun ground-equal (a b)
  (let ((work (list a b)))
    (loop while work do
      (let ((a (pop work)) (b (pop work)))
        (cond ((eq a b))
              ((and (consp a) (consp b))
               (push (cdr b) work) (push (cdr a) work)
               (push (car b) work) (push (car a) work))
              ((not (iso-atomic-equal a b)) (return-from ground-equal nil))))) t))

(defun compile-mode (database name arity mask &optional enumeratep)
  "Compile a closed group of deterministic/semideterministic ground modes.
No VM bindings, effects or table operations occur inside this group."
  (let ((key (list database name arity mask enumeratep)))
    (when (member key *compiling-modes* :test #'equal) (return-from compile-mode nil))
    (let ((*compiling-modes* (cons key *compiling-modes*)))
  (catch 'not-functional
    (let ((nodes (make-hash-table :test 'equal)) (pending nil) (definitions nil))
      (labels
          ((request (name arity mask)
             (when (or (iso-primitive-p name arity) (iso-syntax-p name arity))
               (throw 'not-functional nil))
             (let* ((name (iso-resolve-name database name arity)) (key (list name arity mask)))
               (or (gethash key nodes)
                   (let ((function (gensym "MODE")))
                     (when (gethash (cons name arity) (sprolog/src/kernel/model:database-tabled database))
                       (throw 'not-functional nil))
                     (when (>= (hash-table-count nodes) 128) (throw 'not-functional nil))
                     (setf (gethash key nodes) function)
                     (push (list key function) pending) function))))
           (known-p (term env &optional (depth 0))
             (when (> depth 64) (throw 'not-functional nil))
             (cond ((variable-symbol-p term) (nth-value 1 (gethash term env)))
                   ((consp term) (and (known-p (car term) env (1+ depth))
                                      (known-p (cdr term) env (1+ depth))))
                   ((sprolog/src/kernel/model:logic-var-p term) (throw 'not-functional nil))
                   (t t)))
           (value-form (term env &optional (depth 0))
             (when (> depth 64) (throw 'not-functional nil))
             (cond ((variable-symbol-p term)
                    (multiple-value-bind (value present) (gethash term env)
                      (unless present (throw 'not-functional nil)) value))
                   ((consp term) `(cons ,(value-form (car term) env (1+ depth))
                                        ,(value-form (cdr term) env (1+ depth))))
                   ((sprolog/src/kernel/model:logic-var-p term) (throw 'not-functional nil))
                   (t `',term)))
           (free-outputs-p (terms)
             (let ((seen nil))
               (every (lambda (term)
                        (and (variable-symbol-p term)
                             (or (anonymous-p term)
                                 (unless (member term seen :test #'eq) (push term seen) t)))) terms)))
           (arithmetic-form (term env &optional (depth 0))
             (when (> depth 64) (throw 'not-functional nil))
             (cond ((integerp term) term)
                   ((variable-symbol-p term) `(native-integer ,(value-form term env)))
                   ((and (consp term) (symbolp (car term)))
                    (unless (sprolog/src/syntax/dcg:finite-list-p term) (throw 'not-functional nil))
                    (let* ((name (string-upcase (symbol-name (car term))))
                           (args (cdr term)) (count (length args))
                           (operator (cdr (assoc name '(("+" . +) ("-" . -) ("*" . *)
                                                       ("MOD" . mod) ("REM" . rem)
                                                       ("MIN" . min) ("MAX" . max)
                                                       ("ABS" . abs)) :test #'string=))))
                      (unless (and operator
                                   (if (eq operator 'abs) (= count 1)
                                       (if (member operator '(+ -)) (member count '(1 2)) (= count 2))))
                        (throw 'not-functional nil))
                      (let ((forms (mapcar (lambda (x) (arithmetic-form x env (1+ depth))) args)))
                        (if (member operator '(mod rem))
                            `(let ((a ,(first forms)) (b ,(second forms)))
                               (when (zerop b) (throw 'native-deopt nil)) (,operator a b))
                            `(,operator ,@forms)))))
                   (t (throw 'not-functional nil))))
           (match-form (pattern value env k failure &optional (depth 0))
             (when (> depth 64) (throw 'not-functional nil))
             (cond ((anonymous-p pattern) (funcall k))
                   ((variable-symbol-p pattern)
                    (multiple-value-bind (old present) (gethash pattern env)
                      (if present `(if (ground-equal ,old ,value) ,(funcall k) ,failure)
                          (progn (setf (gethash pattern env) value) (funcall k)))))
                   ((consp pattern)
                    (let ((a (gensym "CAR")) (b (gensym "CDR")))
                      `(if (consp ,value)
                           (let ((,a (car ,value)) (,b (cdr ,value)))
                             ,(match-form (car pattern) a env
                                (lambda () (match-form (cdr pattern) b env k failure (1+ depth)))
                                failure (1+ depth)))
                           ,failure)))
                   ((sprolog/src/kernel/model:logic-var-p pattern) (throw 'not-functional nil))
                   (t `(if ,(cond ((null pattern) `(null ,value))
                                  ((numberp pattern) `(eql ',pattern ,value))
                                  (t `(iso-atomic-equal ',pattern ,value)))
                           ,(funcall k) ,failure))))
           (match-many (patterns values env k failure)
             (if (null patterns) (funcall k)
                 (match-form (car patterns) (car values) env
                   (lambda () (match-many (cdr patterns) (cdr values) env k failure)) failure)))
           (function-definition (key function)
             (destructuring-bind (name arity mask) key
               (let* ((predicate (gethash (cons name arity) (sprolog/src/kernel/model:database-predicates database)))
                      (clauses (and predicate (sprolog/src/kernel/model:predicate-clauses predicate)))
                      (inputs (loop for i below arity when (logbitp i mask) collect i))
                      (outputs (loop for i below arity unless (logbitp i mask) collect i))
                      (parameters (loop for i in inputs collect (gensym "ARG")))
                      (done (gensym "DONE")) (forms nil))
                 (unless clauses (throw 'not-functional nil))
                 ;; Ground facts are a relation indexed by the available scalar inputs.
                 ;; Retain source order inside each bucket and check name-bridge collisions.
                 (when (and (every (lambda (clause) (null (cdr clause))) clauses)
                            (every (lambda (clause)
                                     (and (known-p (cdar clause) (make-hash-table :test 'eq))
                                          (every (lambda (i) (not (consp (nth i (cdar clause))))) inputs))) clauses))
                   (let ((index (make-hash-table :test 'equal)))
                     (dolist (clause (reverse clauses))
                       (let ((tuple (loop for i in inputs collect (index-key (nth i (cdar clause))))))
                         (push (cdar clause) (gethash tuple index))))
                     (unless (or enumeratep (loop for rows being the hash-values of index always (null (cdr rows))))
                       (throw 'not-functional nil))
                     (return-from function-definition
                       `(,function (depth ,@parameters ,@(when enumeratep '(callback)))
                          (declare (ignore depth))
                          (when (minusp (decf fuel)) (throw 'native-deopt nil))
                          (dolist (row (gethash (list ,@(loop for parameter in parameters collect `(index-key ,parameter))) ',index))
                            (when (and ,@(loop for i in inputs for parameter in parameters collect `(ground-equal (nth ,i row) ,parameter)))
                              ,(if enumeratep
                                   `(funcall callback ,@(loop for i in outputs collect `(nth ,i row)))
                                   `(return-from ,function (values t ,@(loop for i in outputs collect `(nth ,i row)))))))
                          (values nil)))))
                 ;; Output patterns do not discriminate calls with free outputs.
                 (unless enumeratep
                 (loop for rest on clauses do
                   (unless (some #'cut-goal-p (flatten-body (cdar rest)))
                     (dolist (later (cdr rest))
                       (unless (some (lambda (i)
                                       (disjoint-patterns-p (nth i (cdaar rest)) (nth i (cdar later)))) inputs)
                         (throw 'not-functional nil))))))
                 (dolist (clause clauses)
                   (let* ((env (make-hash-table :test 'eq)) (failed (gensym "CLAUSE"))
                          (failure `(return-from ,failed nil)) (committed (gensym "CUT")))
                     (labels ((goals-form (goals)
                                (if (null goals)
                                    (if enumeratep
                                        `(funcall callback ,@(loop for i in outputs collect (value-form (nth i (cdar clause)) env)))
                                        `(return-from ,done (values t ,@(loop for i in outputs collect (value-form (nth i (cdar clause)) env)))))
                                    (let ((goal (car goals)))
                                      (if (cut-goal-p goal)
                                          (if enumeratep
                                              (let* ((block (gensym "CUT-RIGHT")) (saved failure)
                                                     (body (unwind-protect
                                                               (progn (setf failure `(return-from ,block nil))
                                                                      (goals-form (cdr goals)))
                                                             (setf failure saved))))
                                                `(return-from ,done (block ,block ,body)))
                                              `(progn (setf ,committed t) ,(goals-form (cdr goals))))
                                          (progn
                                            (when (symbolp goal) (setf goal (list goal)))
                                            (unless (and (consp goal) (symbolp (car goal))
                                                         (sprolog/src/syntax/dcg:finite-list-p goal))
                                              (throw 'not-functional nil))
                                            (let* ((name (string-upcase (symbol-name (car goal)))) (args (cdr goal)))
                                              (cond
                                                ((and (string= name "TRUE") (null args)) (goals-form (cdr goals)))
                                                ((and (member name '("FAIL" "FALSE") :test #'string=) (null args)) failure)
                                                ((and (string= name "=") (= (length args) 2))
                                                 (let (pattern expression)
                                                   (cond ((known-p (second args) env) (setf pattern (first args) expression (value-form (second args) env)))
                                                         ((known-p (first args) env) (setf pattern (second args) expression (value-form (first args) env)))
                                                         (t (throw 'not-functional nil)))
                                                   (let ((value (gensym "EQ")))
                                                     `(let ((,value ,expression))
                                                        ,(match-form pattern value env (lambda () (goals-form (cdr goals))) failure)))))
                                                ((and (string= name "FINDALL") (= (length args) 3))
                                                 (let* ((goal (second args))
                                                        (nested-env (make-hash-table :test 'eq)))
                                                   (unless (and (consp goal) (symbolp (car goal))
                                                                (sprolog/src/syntax/dcg:finite-list-p goal))
                                                     (throw 'not-functional nil))
                                                   (maphash (lambda (key value) (setf (gethash key nested-env) value)) env)
                                                   (let* ((terms (cdr goal))
                                                          (mask (loop for arg in terms for i from 0 when (known-p arg nested-env) sum (ash 1 i)))
                                                          (generator (compile-mode database (car goal) (length terms) mask t))
                                                          (in (loop for arg in terms for i from 0 when (logbitp i mask) collect (value-form arg nested-env)))
                                                          (out (loop for arg in terms for i from 0 unless (logbitp i mask) collect arg))
                                                          (values (loop for arg in out collect (gensym "ITEM")))
                                                          (collection (gensym "COLLECT")) (count (gensym "COUNT")))
                                                     (unless (and generator (free-outputs-p out)) (throw 'not-functional nil))
                                                     `(let ((,collection nil) (,count 0))
                                                        (funcall ',generator ,@in
                                                          (lambda (,@values)
                                                            ,(match-many out values nested-env
                                                               (lambda () `(progn
                                                                              (when (> (incf ,count) 65536) (throw 'native-deopt nil))
                                                                              (push ,(value-form (first args) nested-env) ,collection))) nil)))
                                                        (setf ,collection (nreverse ,collection))
                                                        ,(match-form (third args) collection env (lambda () (goals-form (cdr goals))) failure)))))
                                                ((and (string= name "IS") (= (length args) 2))
                                                 (let ((value (gensym "NUMBER")))
                                                   `(let ((,value ,(arithmetic-form (second args) env)))
                                                      ,(match-form (first args) value env (lambda () (goals-form (cdr goals))) failure))))
                                                ((and (member name '("<" "=<" ">" ">=" "=:=" "=\\=" "===" "=/=") :test #'string=)
                                                      (= (length args) 2))
                                                 (let ((operator (cond ((string= name "<") '<) ((string= name "=<") '<=)
                                                                       ((string= name ">") '>) ((string= name ">=") '>=)
                                                                       ((member name '("=:=" "===") :test #'string=) '=) (t '/=))))
                                                   `(if (,operator ,(arithmetic-form (first args) env) ,(arithmetic-form (second args) env))
                                                        ,(goals-form (cdr goals)) ,failure)))
                                                (t
                                                 (let* ((mask (loop for arg in args for i from 0 when (known-p arg env) sum (ash 1 i)))
                                                        (callee (request (car goal) (length args) mask))
                                                        (in (loop for arg in args for i from 0 when (logbitp i mask) collect (value-form arg env)))
                                                        (out (loop for arg in args for i from 0 unless (logbitp i mask) collect arg))
                                                        (ok (gensym "OK")) (values (loop for arg in out collect (gensym "OUT"))))
                                                   (unless (free-outputs-p out) (throw 'not-functional nil))
                                                   (if enumeratep
                                                       (let* ((block (gensym "NEXT")) (saved failure)
                                                              (body (unwind-protect
                                                                        (progn (setf failure `(return-from ,block nil))
                                                                               (match-many out values env (lambda () (goals-form (cdr goals))) failure))
                                                                      (setf failure saved))))
                                                         `(,callee (1+ depth) ,@in
                                                            (lambda (,@values) (block ,block ,body))))
                                                       `(multiple-value-bind (,ok ,@values) (,callee (1+ depth) ,@in)
                                                          (if ,ok ,(match-many out values env (lambda () (goals-form (cdr goals))) failure)
                                                              ,failure)))))))))))))
                       (push `(let ((,committed nil))
                                (block ,failed
                                  ,(match-many (loop for i in inputs collect (nth i (cdar clause))) parameters env
                                     (lambda () (goals-form (flatten-body (cdr clause)))) failure))
                                (when ,committed (return-from ,done (values nil)))) forms))))
                 `(,function (depth ,@parameters ,@(when enumeratep '(callback)))
                    (declare (optimize (speed 3) (safety 1) (debug 0)))
                    (when (or (> depth +depth-limit+) (minusp (decf fuel))) (throw 'native-deopt nil))
                    (block ,done ,@(nreverse forms) (values nil)))))))
        (let ((entry (request name arity mask)))
          (loop while pending do
            (destructuring-bind (key function) (pop pending)
              (push (function-definition key function) definitions)))
          (let ((parameters (loop for i below arity when (logbitp i mask) collect (gensym "INPUT"))))
            (compile nil `(lambda (,@parameters ,@(when enumeratep '(callback)))
                            (let ((fuel 1000000))
                              (declare (type fixnum fuel))
                              (labels ,(nreverse definitions) (,entry 0 ,@parameters ,@(when enumeratep '(callback)))))))))))))))

(defun native-call (vm name arity tailp)
  ;; The bounded native stack is an optimization. Deep, open, cyclic, tabled,
  ;; effectful and instrumented calls keep the stack-safe VM implementation.
  (unless (and *native-enabled* (not (uiop:getenv "SPROLOG_DISABLE_NATIVE"))
               (not (sprolog/src/kernel/model:machine-slg-worker vm))
               (not (sprolog/src/kernel/model:machine-delays vm))
               (eq *term-executor* (symbol-function 'sprolog/src/kernel/wam:execute-term-instruction)))
    (return-from native-call nil))
  (let* ((database (sprolog/src/kernel/model:machine-database vm))
         (generation (sprolog/src/kernel/model:database-generation database))
         (cached (sprolog/src/kernel/model:database-native-cache database)))
    (unless (and cached (= generation (car cached)))
      (setf cached (cons generation (make-hash-table :test 'equal))
            (sprolog/src/kernel/model:database-native-cache database) cached))
    (let* ((args (sprolog/src/kernel/model:machine-args vm))
           (mask (loop for i below arity unless (sprolog/src/kernel/model:logic-var-p (deref (aref args i))) sum (ash 1 i)))
           (key (list name arity mask))
           (function (multiple-value-bind (function present) (gethash key (cdr cached))
                       (if present function
                           (setf (gethash key (cdr cached)) (compile-mode database name arity mask))))))
      (when (or (null function)
                (and (sprolog/src/kernel/model:machine-native-disabled vm)
                     (gethash key (sprolog/src/kernel/model:machine-native-disabled vm))))
        (return-from native-call nil))
      (let ((free nil))
        (dotimes (i arity)
          (unless (logbitp i mask)
            (let ((var (deref (aref args i))))
              (when (member var free :test #'eq) (return-from native-call nil))
              (push var free)))))
      (let* ((inputs nil)
             (result (catch 'native-deopt
                       (dotimes (i arity)
                         (when (logbitp i mask)
                           (let ((value (deref (aref args i))))
                             (when (consp value)
                               (unless (iso-acyclic-p value) (throw 'native-deopt nil))
                               (setf value (map-term value (lambda (x)
                                                            (let ((x (deref x)))
                                                              (when (sprolog/src/kernel/model:logic-var-p x) (throw 'native-deopt nil)) x)))))
                             (push value inputs))))
                       (cons t (multiple-value-list (apply function (nreverse inputs)))))))
        (unless result
          (unless (sprolog/src/kernel/model:machine-native-disabled vm)
            (setf (sprolog/src/kernel/model:machine-native-disabled vm) (make-hash-table :test 'equal)))
          (setf (gethash key (sprolog/src/kernel/model:machine-native-disabled vm)) t)
          (incf (sprolog/src/kernel/model:machine-native-deopts vm))
          (return-from native-call nil))
        (incf (sprolog/src/kernel/model:machine-native-calls vm))
        (if (and (second result)
                 (loop with values = (cddr result) for i below arity
                       always (or (logbitp i mask) (unify vm (aref args i) (pop values)))))
            (when tailp (restore-continuation vm))
            (backtrack vm))
        t))))

(eval-when (:load-toplevel :execute)
  (register-provider 'sprolog/src/kernel/protocol:native-call 'native-call))
