(defpackage #:sprolog/src/adapter (:use #:cl #:sprolog/src/arithmetic))
(in-package #:sprolog)

;;; Database-local flags and stream aliases.
(defstruct iso-state (flags (make-hash-table :test 'equal))
  (streams (make-hash-table :test 'eq)) (aliases (make-hash-table :test 'equal))
  (input *standard-input*) (output *standard-output*)
  (dynamic (make-hash-table :test 'equal)))
(defun iso-state-for (database)
  (or (database-iso-state database)
      (setf (database-iso-state database)
            (let ((state (make-iso-state)))
              (dolist (entry '(("bounded" . :false) ("integer_rounding_function" . :toward_zero)
                               ("debug" . :off) ("max_integer" . nil) ("min_integer" . nil)
                               ("unknown" . :error)))
                (unless (member (car entry) '("max_integer" "min_integer") :test #'string=)
                  (setf (gethash (car entry) (iso-state-flags state)) (cdr entry))))
              (setf (gethash "user_input" (iso-state-aliases state)) *standard-input*
                    (gethash "user_output" (iso-state-aliases state)) *standard-output*) state))))
(defun iso-flag-value (db name) (gethash name (iso-state-flags (iso-state-for db))))
(defun iso-set-flag (db name value)
  (let* ((flags (iso-state-flags (iso-state-for db))) (name (iso-text name)) (value (iso-required value)))
    (unless (nth-value 1 (gethash name flags)) (iso-error "domain_error" (iso-atom "prolog_flag") (iso-atom name)))
    (unless (member name '("debug" "unknown") :test #'string=)
      (iso-error "permission_error" (iso-atom "modify") (iso-atom "flag") (iso-atom name)))
    (let ((v (string-downcase (iso-text value))))
      (unless (member v (cond ((string= name "unknown") '("error" "fail" "warning"))
 (t '("on" "off"))) :test #'string=)
        (iso-error "domain_error" (iso-atom "flag_value") (iso-compound (iso-atom "+") (iso-atom name) value)))
      (setf (gethash name flags) (intern (string-upcase v) :keyword))) t))
(defun iso-output-list (root &optional kind)
  (let ((x (deref root)) (seen (make-hash-table :test 'eq)))
    (loop while (consp x) do
      (when (gethash x seen) (iso-error "type_error" (iso-atom "list") root))
      (setf (gethash x seen) t)
      (let ((item (deref (car x))))
        (unless (logic-var-p item)
          (cond ((eq kind :code) (iso-code-char item)) ((eq kind :char) (iso-character item)))))
      (setf x (deref (cdr x))))
    (unless (or (null x) (logic-var-p x)) (iso-error "type_error" (iso-atom "list") root))) t)
(defun iso-output-integer (x &optional nonnegative)
  (unless (logic-var-p (deref x)) (iso-integer x nonnegative)) t)
(defun iso-deterministic (vm name args)
  (let ((a (first args)) (b (second args)) (c (third args)))
    (cond
      ((member name '("TRUE" "!") :test #'string=) t)
      ((member name '("FAIL" "FALSE") :test #'string=) nil)
      ((string= name "=") (unify vm a b))
      ((string= name "UNIFY_WITH_OCCURS_CHECK") (iso-checked-unify vm a b))
      ((string= name "SUBSUMES_TERM") (iso-unifiable-p a b t))
      ((string= name "VAR") (logic-var-p (deref a)))
      ((string= name "ATOM") (iso-atom-p a))
      ((string= name "ATOMIC") (let ((x (deref a))) (or (symbolp x) (numberp x))))
      ((string= name "INTEGER") (integerp (deref a)))
      ((string= name "FLOAT") (floatp (deref a)))
      ((string= name "COMPOUND") (consp (deref a)))
      ((string= name "ACYCLIC_TERM") (iso-acyclic-p a))
      ((string= name "TERM_VARIABLES") (iso-output-list b) (unify vm b (iso-variables a)))
      ((string= name "==") (iso-identical-p a b))


      ((string= name "IS") (unify vm a (iso-eval b)))
      ((member name '("<" "=<" ">" ">=" "=:=" "=\\=") :test #'string=)
       (let ((x (iso-eval a)) (y (iso-eval b)))
         (cond ((string= name "<") (< x y)) ((string= name "=<") (<= x y))
               ((string= name ">") (> x y)) ((string= name ">=") (>= x y))
               ((string= name "=:=") (= x y)) (t (/= x y)))))
      
      ((string= name "%OUTPUT_NONNEGATIVE") (iso-output-integer a t) t)
      ((string= name "%SUB_ATOM_ARGUMENTS")
       (iso-text a)
       (dolist (x (subseq args 1 4)) (iso-output-integer x t))
       (unless (logic-var-p (deref (fifth args))) (iso-text (fifth args))) t)
      ((member name '("ATOM_CODES" "NUMBER_CODES") :test #'string=)
       (iso-output-list b :code)
       (let ((numbers (string= name "NUMBER_CODES")) (x (deref a)))
         (if (logic-var-p x)
             (let ((text (coerce (mapcar #'iso-code-char (iso-list b)) 'string)))
               (iso-bind vm a (if numbers (iso-parse-number text) (iso-atom text))))
             (let ((text (if numbers
                             (progn
                               (unless (or (integerp x) (floatp x))
                                 (iso-error "type_error" (iso-atom "number") x))
                               (iso-number-string x))
                             (iso-text x))))
               (unify vm b (map 'list #'char-code text))))))
      ((string= name "%CHARS_ARGUMENTS")
       (iso-output-list c :char)
       (let ((x (deref b)))
         (if (logic-var-p x)
             (dolist (ch (iso-list c)) (iso-character ch))
             (if (string= (iso-text a) "number")
                 (unless (or (integerp x) (floatp x))
                   (iso-error "type_error" (iso-atom "number") x))
                 (iso-text x)))) t)
      ((string= name "CHAR_CODE")
       (unless (logic-var-p (deref b)) (iso-code-char b))
       (if (logic-var-p (deref a)) (iso-bind vm a (iso-atom (string (iso-code-char b))))
           (unify vm b (char-code (iso-character a)))))
      ((string= name "SET_PROLOG_FLAG") (iso-set-flag (machine-database vm) a b))

      ((member name '("ASSERTA" "ASSERTZ" "ABOLISH" "%ENSURE_DYNAMIC") :test #'string=) (iso-modify vm name a))
      ((member name '("HALT") :test #'string=)
       (funcall *iso-halt-function* (iso-integer a)) t)
      (t (iso-io vm name args)))))
(defun iso-character (x)
  (let ((s (iso-text x)))
    (unless (= (length s) 1) (iso-error "type_error" (iso-atom "character") x)) (char s 0)))
(defun iso-code-char (x)
  (let* ((n (iso-integer x)) (ch (and (<= 0 n #x10ffff) (not (<= #xd800 n #xdfff)) (code-char n))))
    (unless ch (iso-error "representation_error" (iso-atom "character_code"))) ch))
(defun iso-number-string (number)
  (let ((*read-default-float-format* 'double-float))
    (substitute #\e #\d (string-downcase (write-to-string number :readably t)))))
(defun iso-parse-number (text)
  (let* ((text (string-left-trim '(#\Space #\Tab #\Newline #\Return #\Page) text))
         (sign (if (and (plusp (length text)) (char= (char text 0) #\-)) -1 1))
         (unsigned (if (and (plusp (length text)) (find (char text 0) "+-")) (subseq text 1) text)))
    (when (and (> (length unsigned) 2) (char= (char unsigned 0) #\0) (find (char unsigned 1) "box"))
      (let ((radix (case (char unsigned 1) (#\b 2) (#\o 8) (t 16))) (digits (subseq unsigned 2)))
        (unless (every (lambda (ch) (digit-char-p ch radix)) digits) (iso-error "syntax_error" (iso-atom "number")))
        (return-from iso-parse-number (* sign (parse-integer digits :radix radix)))))
    (when (and (> (length unsigned) 2) (string= unsigned "0'" :end1 2))
      (let* ((suffix (subseq unsigned 2))
             (ch (cond ((= (length suffix) 1) (char suffix 0))
                       ((and (= (length suffix) 2) (char= (char suffix 0) #\\))
                        (case (char suffix 1) (#\n #\Newline) (#\t #\Tab) (#\r #\Return) (t (char suffix 1)))))))
        (unless ch (iso-error "syntax_error" (iso-atom "number")))
        (return-from iso-parse-number (* sign (char-code ch)))))
    ;; Only numeric tokens reach the host reader, with reader evaluation off.
    (unless (and (plusp (length text))
                 (every (lambda (ch) (or (digit-char-p ch) (find ch "+-eE."))) text)
                 (not (char= (char text (1- (length text))) #\.)))
      (iso-error "syntax_error" (iso-atom "number")))
    (handler-case
        (let ((*read-eval* nil) (*read-default-float-format* 'double-float))
          (multiple-value-bind (value pos) (read-from-string text nil :eof)
            (unless (and (or (integerp value) (and (floatp value) (find #\. text))) (= pos (length text)))
              (iso-error "syntax_error" (iso-atom "number"))) value))
      (iso-exception (c) (error c)) (error () (iso-error "syntax_error" (iso-atom "number"))))))
