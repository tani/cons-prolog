(defpackage #:sprolog/src/arithmetic (:use #:cl #:sprolog/src/runtime))
(in-package #:sprolog)

;;; Arithmetic: integer arithmetic stays exact; ISO floats are SBCL doubles.
(defun iso-eval (expression)
  (labels ((evaluate (x)
             (let ((x (iso-required x)))
               (when (numberp x)
                 (unless (or (integerp x) (floatp x))
                   (iso-error "type_error" (iso-atom "evaluable") x))
                 (return-from evaluate x))
               (multiple-value-bind (functor args)
                   (if (and (consp x) t) (values (car x) (cdr x)) (iso-parts x))
                 (let* ((spelling (string-upcase (iso-text functor)))
                        (name (or (cdr (assoc spelling '(("LOGAND" . "/\\") ("LOGIOR" . "\\/") ("LOGNOT" . "\\")) :test #'string=)) spelling))
                        (n (length args))
                        (a (and args (evaluate (first args))))
                        (b (and (cdr args) (evaluate (second args)))))
                   (flet ((ints () (unless (and (integerp a) (integerp b))
                                     (iso-error "type_error" (iso-atom "integer") (if (integerp a) b a))))
                          (float-arg () (unless (floatp a) (iso-error "type_error" (iso-atom "float") a)))
                          (arity (expected) (unless (= n expected)
                                              (iso-error "type_error" (iso-atom "evaluable")
                                                         (iso-compound (iso-atom "/") functor n)))))
                     (cond
                       ((string= name "PI") (arity 0) (coerce pi 'double-float))
                       ((string= name "+") (unless (member n '(1 2)) (arity 2)) (if (= n 1) a (+ a b)))
                       ((string= name "-") (unless (member n '(1 2)) (arity 2)) (if (= n 1) (- a) (- a b)))
                       ((string= name "*") (arity 2) (* a b))
                       ((string= name "/") (arity 2) (when (zerop b) (iso-error "evaluation_error" (iso-atom "zero_divisor")))
                        (/ (coerce a 'double-float) (coerce b 'double-float)))
                       ((string= name "//") (arity 2) (ints) (truncate a b))
                       ((string= name "DIV") (arity 2) (ints) (floor a b))
                       ((string= name "REM") (arity 2) (ints) (rem a b))
                       ((string= name "MOD") (arity 2) (ints) (mod a b))
                       ((string= name "**") (arity 2) (expt (coerce a 'double-float) b))
                       ((string= name "^") (arity 2)
                        (if (and (integerp a) (integerp b) (>= b 0)) (expt a b)
                            (expt (coerce a 'double-float) b)))
                       ((string= name "MIN") (arity 2) (min a b))
                       ((string= name "MAX") (arity 2) (max a b))
                       ((string= name "ABS") (arity 1) (abs a))
                       ((string= name "SIGN") (arity 1) (signum a))
                       ((string= name "FLOAT") (arity 1) (coerce a 'double-float))
                       ((string= name "FLOAT_INTEGER_PART") (arity 1) (float-arg) (coerce (truncate a) 'double-float))
                       ((string= name "FLOAT_FRACTIONAL_PART") (arity 1) (float-arg) (- a (truncate a)))
                       ((member name '("FLOOR" "CEILING" "TRUNCATE" "ROUND") :test #'string=)
                        (arity 1) (float-arg)
                        (cond ((string= name "FLOOR") (floor a)) ((string= name "CEILING") (ceiling a))
                              ((string= name "TRUNCATE") (truncate a))
                              (t (if (minusp a) (ceiling (- a 0.5d0)) (floor (+ a 0.5d0))))))
                       ((member name '("SIN" "COS" "TAN" "ASIN" "ACOS" "ATAN" "EXP" "LOG" "SQRT") :test #'string=)
                        (arity 1)
                        (let ((v (funcall (symbol-function (find-symbol name :cl)) (coerce a 'double-float))))
                          (unless (realp v) (iso-error "evaluation_error" (iso-atom "undefined"))) v))
                       ((string= name "ATAN2") (arity 2)
                        (when (and (zerop a) (zerop b)) (iso-error "evaluation_error" (iso-atom "undefined")))
                        (atan (coerce a 'double-float) (coerce b 'double-float)))
                       ((string= name "\\") (arity 1) (iso-integer a) (lognot a))
                       ((member name '("/\\" "\\/" "XOR" "<<" ">>") :test #'string=)
                        (arity 2) (ints)
                        (cond ((string= name "/\\") (logand a b)) ((string= name "\\/") (logior a b))
                              ((string= name "XOR") (logxor a b)) ((string= name "<<") (ash a b))
                              (t (ash a (- b)))))
                       (t (iso-error "type_error" (iso-atom "evaluable")
                                     (iso-compound (iso-atom "/") functor n))))))))))
    (handler-case
        (let ((work (list (list :visit expression))) (values nil)
              (colors (make-hash-table :test 'eq)) (cache (make-hash-table :test 'eq)))
          (loop while work do
            (destructuring-bind (kind node &optional functor count) (pop work)
              (if (eq kind :apply)
                  (let* ((args (nreverse (loop repeat count collect (pop values))))
                         (result (evaluate (if args (cons functor args) functor))))
                    (unless (or (integerp result) (floatp result))
                      (iso-error "evaluation_error" (iso-atom "undefined")))
                    (setf (gethash node colors) :done (gethash node cache) result) (push result values))
                  (let ((x (iso-required node)))
                    (if (numberp x) (push (evaluate x) values)
                        (case (gethash x colors)
                          (:active (iso-error "type_error" (iso-atom "evaluable") x))
                          (:done (push (gethash x cache) values))
                          (otherwise
                           (multiple-value-bind (f args)
                               (if (and (consp x) t) (values (car x) (cdr x)) (iso-parts x))
                             (unless (finite-list-p args) (iso-error "type_error" (iso-atom "evaluable") x))
                             (setf (gethash x colors) :active)
                             (push (list :apply x f (length args)) work)
                             (dolist (arg (reverse args)) (push (list :visit arg) work))))))))))
          (car values))
      (division-by-zero () (iso-error "evaluation_error" (iso-atom "zero_divisor")))
      (floating-point-overflow () (iso-error "evaluation_error" (iso-atom "float_overflow")))
      (floating-point-underflow () (iso-error "evaluation_error" (iso-atom "underflow")))
      (arithmetic-error () (iso-error "evaluation_error" (iso-atom "undefined"))))))
