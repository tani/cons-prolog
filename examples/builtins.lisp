(require :asdf)
(asdf:load-asd (merge-pathnames "../cons-prolog.asd" *load-truename*))
(asdf:load-system "cons-prolog")
(use-package :prolog)
(format t "Term: ~S~%" (query '((= ?term (f a b)))))
(format t "Nonunifiability: ~S~%" (query '((/= a b))))
(format t "Arithmetic: ~S~%" (query '((is ?n (+ 1 (* 3 6))))))
(format t "Arithmetic equality: ~S~%" (query '((=== (+ 1 2) 3))))
(format t "Bitwise: ~S~%" (query '((is ?n (logand 6 3)))))
(format t "Collector: ~S~%" (query '((findall ?x (or (= ?x 1) (= ?x 2)) ?answers))))
(format t "Exception: ~S~%" (query '((catch (throw ball) ?e (= ?result ?e)))))
