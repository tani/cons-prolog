(require :asdf)
(asdf:load-asd (merge-pathnames "../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(use-package :sprolog)
(format t "Term: ~S~%" (?- (= ?term (f a b))))
(format t "Nonunifiability: ~S~%" (?- (/= a b)))
(format t "Arithmetic: ~S~%" (?- (is ?n (+ 1 (* 3 6)))))
(format t "Arithmetic equality: ~S~%" (?- (=== (+ 1 2) 3)))
(format t "Bitwise: ~S~%" (?- (is ?n (logand 6 3))))
(format t "Collector: ~S~%" (?- (findall ?x (or (= ?x 1) (= ?x 2)) ?answers)))
(format t "Exception: ~S~%" (?- (catch (throw ball) ?e (= ?result ?e))))
