(require :asdf)
(asdf:load-asd (merge-pathnames "../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(use-package :sprolog)
(---> (article) '(the))
(---> (noun cat) '(cat))
(--> (noun dog) '(dog))
(---> (verb sleeps) '(sleeps))
(---> (sentence (s ?subject ?verb))
      (article) (noun ?subject) (verb ?verb))
(format t "Parse: ~S~%" (query '((phrase (sentence ?tree) ( the cat sleeps)))))
(format t "Generate: ~S~%" (query '((phrase (sentence ?tree) ?tokens))))
(format t "Suffix: ~S~%" (query '((phrase (sentence ?tree) ( the dog sleeps and more) ?rest))))
(---> (letter ?x) (or '(a) '(b))
      (do (lisp ?x :recognized)))
(format t "Alternatives: ~S~%" (query '((phrase (letter ?x) ?tokens))))
(disassemble-predicate 'sentence 3)
