(require :asdf)
(asdf:load-asd (merge-pathnames "../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(use-package :sprolog)
(---> (article) (:terminals the))
(---> (noun cat) (:terminals cat))
(--> (noun dog) (:terminals dog))
(---> (verb sleeps) (:terminals sleeps))
(---> (sentence (s ?subject ?verb))
      (article) (noun ?subject) (verb ?verb))
(format t "Parse: ~S~%" (?- (phrase (sentence ?tree) ( the cat sleeps))))
(format t "Generate: ~S~%" (?- (phrase (sentence ?tree) ?tokens)))
(format t "Suffix: ~S~%" (?- (phrase (sentence ?tree) ( the dog sleeps and more) ?rest)))
(---> (letter ?x) (:or (:terminals a) (:terminals b))
      (:goals (lisp ?x :recognized)))
(format t "Alternatives: ~S~%" (?- (phrase (letter ?x) ?tokens)))
(disassemble-predicate 'sentence 3)
