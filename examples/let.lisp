(require :asdf)
(asdf:load-asd (merge-pathnames "../cons-prolog.asd" *load-truename*))
(asdf:load-system "cons-prolog")
(use-package :prolog)
(<-- (adjusted ?n ?out)
  (let offset 10)
  (lisp ?out (+ ?n offset)))
(format t "Adjusted: ~S~%" (query '((adjusted 3 ?out))))
(prolog
  (let counter 0)
  (or (= ?n 3) (= ?n 4))
  (lisp ?out (incf counter ?n))
  (lisp (format t "Input ~D, running total ~D~%" ?n ?out)))
