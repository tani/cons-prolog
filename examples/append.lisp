(require :asdf)
(asdf:load-asd (merge-pathnames "../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(use-package :sprolog)
(<-- (append () ?ys ?ys))
(<- (append (?x . ?xs) ?ys (?x . ?zs)) (append ?xs ?ys ?zs))
(format t "Solutions: ~S~%" (?- (append ?xs ?ys (a b c))))
(let ((items '(a b c)) (results nil))
  (prolog (lisp ?items items) (append ?xs ?ys ?items)
          (lisp (push (list ?xs ?ys) results)))
  (format t "Lexical callback: ~S~%" (nreverse results)))
(disassemble-predicate 'append 3)
