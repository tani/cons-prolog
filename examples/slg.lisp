(require :asdf)
(asdf:load-asd (merge-pathnames "../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(use-package :sprolog)
(clear-database)
(table 'path 2)
(<-- (path ?x ?y) (path ?x ?z) (edge ?z ?y))
(<- (path ?x ?y) (edge ?x ?y))
(<-- (edge a b)) (<- (edge b c)) (<- (edge c a))
(format t "Left-recursive cyclic paths: ~S~%" (?- (path a ?y)))
(table 'letters 2)
(---> (letters) (letters) '(a))
(--> (letters))
(format t "Left-recursive DCG: ~S~%" (?- (phrase (letters) ( a a a))))
(table 'p 0) (table 'q 0)
(<-- (p) (tnot (q))) (<-- (q) (tnot (p)))
(format t "Negative cycle: ~S~%" (query '((p)) :truth-values t))
(table 'first-path 1)
(<-- (first-path ?x) (path a ?x) !)
(format t "Cut after completed child SCC: ~S~%" (?- (first-path ?x)))
(table 'bad 1)
(<-- (bad ?x) (bad ?x) !) (<- (bad base))
(handler-case (?- (bad ?x))
  (slg-incomplete-cut (condition)
    (format t "Rejected incomplete-table cut: ~A~%" condition)))
