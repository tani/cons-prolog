(uiop:define-package #:sprolog/tests/term-syntax
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/tests/builtins #:iso-error-p)
  (:import-from #:sprolog/tests/tests #:check #:solutions #:value-of)
  (:export #:run-term-syntax-tests))
(in-package #:sprolog/tests/term-syntax)

(defun run-term-syntax-tests ()
  (let ((*database* (make-database)))
    (<-- (cons-head (f ?x) (?x)))
    (dolist (gc '(nil 1 8 4096))
      (check (query '((atom_codes () (110 105 108))) :gc-threshold gc)
             "NIL uses its Lisp atom name rather than Prolog empty-list spelling")
      (check (query '((cons-head (f a) (a))) :gc-threshold gc))
      (check (query '((= (f a b) (f a b))) :gc-threshold gc) "cons terms have no separate compound type")
      (check (query '((= (a . ?tail) (a b)) (= ?tail (b))) :gc-threshold gc))
      (check (equal '(f a (g b)) (value-of '?x (car (query '((= ?x (f a (g b)))) :gc-threshold gc)))))
      (check (query '((= ?goal (cons-head (f a) (a))) (call ?goal)) :gc-threshold gc))
      (check (query '((= ?x (f . ?x)) (ground ?x) (/+ (acyclic_term ?x))) :gc-threshold gc))
      (check (query '((catch (throw (f a)) (f ?x) (== ?x a))) :gc-threshold gc))
      (check (query '((assertz (rule (cons-dynamic ?x) (= ?x (f a))))
                     (cons-dynamic (f a)) (retractall (cons-dynamic ?))) :gc-threshold gc))
      (check (equal '(list a b) (value-of '?x (car (query '((= ?x (list a b))) :gc-threshold gc))))
             "LIST is an ordinary symbol in a data term")
      (check (equal '(cons a b) (value-of '?x (car (query '((= ?x (cons a b))) :gc-threshold gc))))
             "CONS is an ordinary symbol in a data term")
      (check (equal '(f) (value-of '?x (car (query '((= ?x (f))) :gc-threshold gc))))
             "one-element lists are not atoms"))
    (<-- (group-first b 2)) (<- (group-first a 1)) (<- (group-first b 3))
    (let ((answers (solutions (bagof ?value (group-first ?key ?value) ?bag))))
      (check (equal '(b a) (mapcar (lambda (s) (value-of '?key s)) answers)) "bagof uses first appearance order")
      (check (equal '((2 3) (1)) (mapcar (lambda (s) (value-of '?bag s)) answers))))
    (dolist (indicator '((functor . 3) (arg . 3) (=.. . 2) (@< . 2) (@=< . 2)
                         (@> . 2) (@>= . 2) (compare . 3) (sort . 2) (keysort . 2) (setof . 3)
                         (read . 1) (read . 2) (read_term . 2) (read_term . 3)
                         (write . 1) (write . 2) (writeq . 1) (writeq . 2)
                         (write_canonical . 1) (write_canonical . 2) (write_term . 2) (write_term . 3)
                         (op . 3) (current_op . 3) (char_conversion . 2) (current_char_conversion . 2)))
      (check (sprolog/src/api/registry:iso-builtin-p (car indicator) (cdr indicator)) "cons-model builtin is registered"))
    (check (query '((functor (f a) f 1))) "term arity matches call arity")
    (let ((ring (cons 'f nil)))
      (setf (cdr ring) ring)
      (let ((answer (value-of '?x (car (query (list (list '= '?x ring)) :gc-threshold 1)))))
        (check (eq (cdr answer) answer) "cyclic source cons graph is preserved")))))
