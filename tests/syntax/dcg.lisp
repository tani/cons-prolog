(uiop:define-package #:sprolog/tests/syntax/dcg
  (:use #:cl #:prolog)
  (:import-from #:sprolog/tests/support/assertions #:check #:solutions #:value-of)
  (:import-from #:sprolog/tests/kernel/wam-gc #:normalize-solutions #:palette #:red #:blue)
  (:export #:run-dcg-tests #:signals-error-p))
(in-package #:sprolog/tests/syntax/dcg)
(defun signals-error-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun run-dcg-tests ()
  (---> (article) '(the))
  (---> (noun cat) '(cat))
  (--> (noun dog) '(dog))
  (---> (verb sleeps) '(sleeps))
  (---> (sentence (s ?n ?v)) (article) (noun ?n) (verb ?v))
  (check (equal (solutions (phrase (sentence ?tree) ( the cat sleeps)))
                '(((?tree s cat sleeps)))) "DCG recognition and semantic tree")
  (check (null (solutions (phrase (sentence ?tree) ( the fish sleeps)))) "DCG failure")
  (check (null (solutions (phrase (sentence ?tree) ( the cat sleeps extra)))) "PHRASE/2 requires full input")
  (check (equal (value-of '?rest (first (solutions (phrase (sentence ?tree) ( the dog sleeps extra) ?rest))))
                '(extra)) "PHRASE/3 suffix")
  (check (equal (mapcar (lambda (s) (value-of '?tokens s)) (solutions (phrase (sentence ?tree) ?tokens)))
                '((the cat sleeps) (the dog sleeps))) "DCG generation")
  (check (equal (phrase '(sentence ?tree) '( the cat sleeps)) '(((?tree s cat sleeps))))
         "runtime PHRASE function")
  (check (equal (solutions (phrase '(a b) ( a b))) '(nil)) "terminal grammar expression")
  (check (equal (solutions (phrase '() ())) '(nil)) "empty terminals")
  (check (equal (phrase ''(a b) '(a b)) '(nil)) "runtime quoted terminal grammar")
  (check (equal (solutions (phrase '(?x ?x) (a a))) '(((?x . a))))
         "inline quoted variables unify")
  (check (null (solutions (phrase '(?x ?x) (a b)))) "inline quoted variable conflict")
  (check (equal (solutions (phrase '(noun cat) (noun cat))) '(nil))
         "quoted tokens do not call a nonterminal")
  (check (equal (solutions (phrase '((quote a)) ((quote a)))) '(nil))
         "quote inside a token stays ordinary term data")
  (check (equal (solutions (phrase (and '() '(a) '()) (a))) '(nil))
         "empty quoted terminals between consuming forms")
  (check (equal (solutions (phrase (do (= ?x ok)) (a) ?rest))
                '(((?x . ok) (?rest a)))) "pure DO leaves input unchanged")
  (dolist (grammar '((quote) (quote (a) (b)) (quote a) (quote (a . b))))
    (check (signals-error-p (lambda () (phrase grammar nil))) "reject malformed DCG quote"))
  (let ((tokens (list 'a)))
    (setf (cdr tokens) tokens)
    (check (signals-error-p (lambda () (phrase (list 'quote tokens) nil)))
           "reject cyclic quoted token sequence"))
  (check (equal (phrase '(:seq (:terminals a) (:or (:terminals b) (:terminals c))
                               (:goals (= ?x ok))) '(a b)) '(((?x . ok))))
         "legacy DCG syntax remains compatible")
  (---> (empty))
  (check (equal (solutions (phrase (empty) ())) '(nil)) "epsilon rule")
  (check (null (solutions (phrase (empty) ( a)))) "epsilon with leftover input")
  (check (equal (value-of '?rest (first (solutions (phrase (empty) ( a b) ?rest)))) '(a b)))
  (---> (tagged ?x) '((token ?x) end))
  (check (eq 'a (value-of '?x (first (solutions (phrase (tagged ?x) ( (token a) end))))))
         "compound terminal with variable")
  (---> (same-token ?x) '(?x ?x))
  (check (null (solutions (phrase (same-token ?x) ( a b)))) "repeated terminal variable")
  (check (eq 'a (value-of '?x (first (solutions (phrase (same-token ?x) ( a a)))))))
  (---> (nested) (and '(a) (and '(b) '(c))))
  (check (equal (solutions (phrase (nested) ( a b c))) '(nil)) "nested sequence")
  (---> (number ?n) '(?n) (do (lispp (integerp ?n)) (lispp (plusp ?n))))
  (check (equal (solutions (phrase (number ?n) ( 7))) '(((?n . 7)))) "embedded semantic test")
  (check (null (solutions (phrase (number ?n) ( -1)))) "embedded semantic failure")
  (let ((offset 10))
    (---> (incremented ?out) '(?n) (do (lisp ?out (+ ?n offset))))
    (check (eq 13 (value-of '?x (first (solutions (phrase (incremented ?x) ( 3))))))
           "lexical environment in DCG host callback"))
  (---> (choice ?kind)
        (or (and '(a) (do (= ?kind first)))
             (and '(a) (do (= ?kind second))))
        '(b))
  (check (equal (mapcar (lambda (s) (value-of '?kind s)) (solutions (phrase (choice ?kind) ( a b))))
                '(first second)) "inline disjunction and trailing continuation")
  (check (null (solutions (phrase (choice ?kind) ( a c)))) "failure after branch restores state")
  (let ((prefix-count 0))
    (---> (side-effect) (do (lisp (incf prefix-count)))
          (or '(a) '(a)))
    (check (= 2 (length (solutions (phrase (side-effect) ( a))))) "two disjunction answers")
    (check (= prefix-count 1) "prefix side effect runs once across alternatives"))
  (---> (committed)
        (or (and '(a) ! '(b)) '(a c)))
  (check (null (solutions (phrase (committed) ( a c)))) "cut prunes DCG branch alternatives")
  (check (equal (solutions (phrase (committed) ( a b))) '(nil)))
  (--> (committed) '(a c))
  (check (null (solutions (phrase (committed) ( a c)))) "cut also prunes later grammar clauses")
  (---> (branch-cut) (or (and '(a) !) '(a)))
  (check (equal (mapcar (lambda (s) (value-of '?x s))
                        (solutions (palette ?x) (phrase (branch-cut) ( a)))) '(red blue))
         "DCG cut preserves caller choices")
  (check (equal (mapcar (lambda (s) (value-of '?x s))
                        (solutions (palette ?x)
                            (phrase (and (or '(a) '(a)) !) ( a))))
                '(red blue)) "inline PHRASE cut is opaque to caller choices")
  (let ((vm (make-query '((palette ?x) (phrase (and (or '(a) '(a)) !) ( a)))
                        :gc-threshold 1)))
    (unwind-protect
         (progn
           (check (eq 'red (value-of '?x (next-solution vm))))
           (collect-query-garbage vm)
           (check (eq 'blue (value-of '?x (next-solution vm)))))
      (close-query vm)))
  (let ((count 0))
    (prolog (phrase (choice ?kind) ( a b)) (lisp (incf count)))
    (check (= count 2) "DCG in PROLOG macro"))
  ;; PHRASE expression callbacks preserve the query's lexical environment too.
  (let ((allow t))
    (check (equal (solutions (phrase (and '(a) (do (lispp allow))) ( a))) '(nil))))
  ;; A user variable whose printed name resembles generated variables remains visible.
  (let ((name (make-symbol "?DCG-USER")))
    (check (assoc name (first (query (list (list 'phrase (list 'noun name) '(cat))))))
           "DCG hygiene does not suppress similarly named user variables"))
  (check (signals-error-p (lambda () (phrase '(or) '( a)))) "reject empty disjunction")
  (check (signals-error-p (lambda () (phrase '?grammar '( a)))) "reject dynamic nonterminal")
  (check (signals-error-p (lambda () (phrase '(:goal (true) (true)) nil))) "reject malformed semantic form")
  (check (signals-error-p (lambda () (query '((phrase (noun ?x)))))) "reject malformed phrase")
  (let ((cyclic (list 'or nil)))
    (setf (second cyclic) cyclic)
    (check (signals-error-p (lambda () (phrase cyclic nil))) "reject cyclic DCG control syntax"))
  ;; Three alternatives and nested branch offsets in a non-first clause.
  (---> (offset-choice ?x) '(impossible) (do (= ?x impossible)))
  (--> (offset-choice ?x)
       (or (and '(a) (do (= ?x first)))
            (and '(a) (do (= ?x second)))
            (or (and '(a) (do (= ?x third)))
                 (and '(a) (do (= ?x fourth))))))
  (check (equal (mapcar (lambda (s) (value-of '?x s))
                        (solutions (phrase (offset-choice ?x) ( a)))) '(first second third fourth))
         "nested alternatives and relocated clause branch addresses")
  (dolist (threshold '(1 8 64))
    (check (= 4 (length (query '((phrase (offset-choice ?x) ( a))) :gc-threshold threshold)))
           "nested branch environments survive GC"))
  ;; The replacement macro resets only the expanded predicate's arity.
  (---> (replace-grammar) '(old))
  (--> (replace-grammar) '(also-old))
  (---> (replace-grammar) '(new))
  (check (null (solutions (phrase (replace-grammar) ( old)))) "DCG replacement removes old rules")
  (check (equal (solutions (phrase (replace-grammar) ( new))) '(nil)))
  ;; All eighteen term operations remain exercised by actual source programs.
  (let* ((original (symbol-function 'sprolog/src/kernel/wam:execute-term-instruction))
         (seen (make-hash-table)))
    (unwind-protect
         (progn
           (setf (symbol-function 'sprolog/src/kernel/wam:execute-term-instruction)
                 (lambda (vm op args) (setf (gethash op seen) t) (funcall original vm op args)))
           (<-- (opcode-atom a))
           (<-- (opcode-shape ( node ?x ?x a ?)))
           (<-- (opcode-fresh ?out ?old) (opcode-atom ?old)
                 (= ?out ( pair ?new ?new ? ?old)) (opcode-atom a))
           (<-- (opcode-list ( ?x  . ?xs)))
           (<-- (opcode-produce ?x) (= ?x ( ?  . ?tail)))
           (solutions (opcode-fresh ?out a))
           (solutions (opcode-shape ?out))
           (solutions (opcode-shape ( node b b a ignored)))
           (solutions (opcode-list ?out))
           (solutions (opcode-produce ?out))
           (check (= 18 (hash-table-count seen)) "all 18 term instructions run from S-expression source"))
      (setf (symbol-function 'sprolog/src/kernel/wam:execute-term-instruction) original)))
  ;; Match hand-written difference-list rules independently of the DCG expander.
  (<-- (manual-choice first ( a . ( b  . ?rest)) ?rest))
  (<- (manual-choice second ( a . ( b  . ?rest)) ?rest))
  (dolist (input '((a b) (a b extra) (a c)))
    (let ((expected (normalize-solutions (query (list (list 'manual-choice '?kind input '?rest))))))
      (dolist (threshold '(nil 1 8 64))
        (check (equal expected (normalize-solutions
                                (query (list (list 'phrase '(choice ?kind) input '?rest))
                                       :gc-threshold threshold)))
               "DCG matches independent difference-list rules under GC"))))
  ;; Force GC between branch answers, including a suspended grammar environment.
  (let ((vm (make-query '((phrase (choice ?kind) ( a b))) :gc-threshold 1)))
    (unwind-protect
         (progn
           (check (eq 'first (value-of '?kind (next-solution vm))))
           (collect-query-garbage vm)
           (check (eq 'second (value-of '?kind (next-solution vm))))
           (check (not (nth-value 1 (next-solution vm)))))
      (close-query vm)))
  (---> (many) '(a) (many))
  (--> (many))
  (let* ((tokens (loop repeat 10000 collect 'a))
         (vm (make-query
              (list (sprolog/src/kernel/model:make-host-goal :function (lambda () tokens) :output '?tokens)
                    '(phrase (many) ?tokens)) :gc-threshold 64)))
    (unwind-protect
         (progn
           (check (nth-value 1 (next-solution vm)) "10,000-token right-recursive DCG")
           (check (= 1 (getf (query-statistics vm) :max-continuation-depth))
                  "DCG tail recursion uses EXECUTE")
           (format t "DCG 10,000 tokens: ~S~%" (query-statistics vm)))
      (close-query vm)))
  ;; Standalone query sequence expansion stays iterative for a deeply nested AND.
  (let ((grammar ''(a)))
    (dotimes (i 10000) (setf grammar (list 'and grammar)))
    (check (equal (phrase grammar '( a)) '(nil)) "deep DCG sequence expansion")))
