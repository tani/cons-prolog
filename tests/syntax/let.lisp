(uiop:define-package #:sprolog/tests/syntax/let
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/tests/api/interactive #:interactive-output)
  (:import-from #:sprolog/tests/kernel/slg #:signals-error-p)
  (:import-from #:sprolog/tests/support/assertions #:check #:solutions #:value-of)
  (:export #:run-let-tests))
(in-package #:sprolog/tests/syntax/let)

(defun run-let-tests ()
  (let ((*database* (make-database)))
    (check (equal (solutions (let offset 10) (lisp ?out (+ offset 3))) '(((?out . 13))))
           "LET introduces a Lisp variable without exposing internal slots")
    (check (equal (solutions (= ?x 3) (let factor (* ?x 2)) (lisp ?out (+ factor 1)))
                  '(((?x . 3) (?out . 7)))) "initializer reads logic variables")
    (let ((outer 5))
      (check (equal (solutions (let local (+ outer 2)) (lisp ?out local)) '(((?out . 7))))
             "initializer captures outer lexical variables"))
    (check (equal (solutions (let offset 10) (let offset (+ offset 1)) (lisp ?out offset))
                  '(((?out . 11)))) "nested LET shadows after evaluating initializer")
    (check (equal (solutions (let first 2) (let second (+ first 3)) (lisp ?out (* first second)))
                  '(((?out . 10)))) "successive bindings are visible")
    (check (equal (solutions (let counter 0) (lisp (incf counter)) (lisp ?out counter))
                  '(((?out . 1)))) "SETF updates shared lexical cell")
    (check (equal (solutions (let offset 9) (lisp ?out (let ((offset 2)) offset))) '(((?out . 2))))
           "ordinary Lisp LET shadows bridge binding")
    (check (equal (solutions (let offset 10 (declare (type integer offset))) (lisp ?out (1+ offset)))
                  '(((?out . 11)))) "optional Lisp declaration")
    (check (equal (solutions (let offset 10) (lispp (= offset 10))) '(nil)) "LET in LISPP")
    (check (null (solutions (let offset 10) (lispp (< offset 0)))) "semantic test failure")
    (<-- (let-callee ?out) (let offset 20) (lisp ?out offset))
    (check (equal (solutions (let offset 10) (let-callee ?inner) (lisp ?out offset))
                  '(((?inner . 20) (?out . 10)))) "callee bindings do not replace caller bindings")
    (check (equal (solutions (and (let offset 10) (lisp ?out offset))) '(((?out . 10))))
           "LET in explicit conjunction")
    (check (equal (solutions (or (and (let offset 1) (lisp ?out offset))
                                (and (let offset 2) (lisp ?out offset))))
                  '(((?out . 1)) ((?out . 2)))) "branch-local lexical bindings")
    (check (equal (solutions (let offset 3) (or (lisp ?out offset) (lisp ?out (1+ offset))))
                  '(((?out . 3)) ((?out . 4)))) "bindings propagate into control branches")
    (check (equal (solutions (let offset 3) (or (-> (lispp t) (lisp ?out offset)) (= ?out wrong)))
                  '(((?out . 3)))) "if-then-else preserves commitment")
    (check (equal (solutions (let offset 3) (once (lisp ?out offset))) '(((?out . 3))))
           "binding inside opaque control")
    (let ((initializations 0))
      (check (= 2 (length (solutions (let counter (progn (incf initializations) 0))
                                    (or (true) (true)) (lisp (incf counter))))))
      (check (= initializations 1) "backtracking after LET does not reinitialize"))
    (let ((initializations 0))
      (check (= 2 (length (solutions (or (true) (true))
                                    (let local (incf initializations)) (lispp (plusp local))))))
      (check (= initializations 2) "backtracking before LET reinitializes"))
    (check (equal (solutions (let counter 0) (or (true) (true))
                             (lisp ?out (incf counter))) '(((?out . 1)) ((?out . 2))))
           "Lisp mutations persist across backtracking")
    (let ((function (value-of '?fn (first (solutions (let counter 0)
                          (lisp ?fn (lambda () (incf counter))))))))
      (check (= 1 (funcall function)) "escaping closure retains lexical binding after cursor close")
      (check (= 2 (funcall function)) "escaping closure updates the same cell"))
    (let ((initializations 0))
      (check (= 2 (length (solutions (or (let local (incf initializations))
                                        (let local (incf initializations)))))))
      (check (= initializations 2) "LET accepted as a control branch"))
    (<-- (let-tail 0))
    (<- (let-tail ?n) (lispp (plusp ?n)) (let next (1- ?n))
        (lisp ?m next) (let-tail ?m))
    (let ((vm (make-query '((let-tail 10000)) :gc-threshold 64)))
      (unwind-protect
           (progn
             (check (nth-value 1 (next-solution vm)) "10,000 tail calls with LET")
             (check (= 1 (getf (query-statistics vm) :max-continuation-depth))
                    "LET preserves tail execution"))
        (close-query vm)))
    (---> (let-dcg ?out) '(?n) (do (let offset 10) (lisp ?out (+ ?n offset))))
    (check (equal (solutions (phrase (let-dcg ?out) (3))) '(((?out . 13)))) "LET in DCG DO")
    (table 'let-tabled 1)
    (<-- (let-tabled a)) (<- (let-tabled b))
    (<-- (let-cursor ?out)
      (let offset 10) (let-tabled ?x) (lisp ?out (list ?x offset)))
    (dolist (threshold '(nil 1 8 64))
      (let ((vm (make-query '((let-cursor ?out)) :gc-threshold threshold)))
        (unwind-protect
             (progn
               (check (equal (value-of '?out (next-solution vm)) '(a 10)) "binding survives SLG suspension")
               (collect-query-garbage vm)
               (check (equal (value-of '?out (next-solution vm)) '(b 10)) "binding survives GC and cursor resume"))
          (close-query vm))))
    (<-- (let-counter ?out) (let counter 0) (or (true) (true)) (lisp ?out (incf counter)))
    (let ((one (make-query '((let-counter ?out)))) (two (make-query '((let-counter ?out)))))
      (unwind-protect
           (progn
             (check (= 1 (value-of '?out (next-solution one))))
             (check (= 1 (value-of '?out (next-solution two))) "cursors have independent cells")
             (collect-query-garbage one)
             (check (= 2 (value-of '?out (next-solution one))))
             (check (= 2 (value-of '?out (next-solution two)))))
        (close-query one) (close-query two)))
    (let ((output (interactive-output "" (lambda () (?- (let offset 10) (lisp ?out offset))))))
      (check (search "?OUT = 10" output) "LET works in interactive queries")
      (check (not (search "?LET-" output)) "internal environment slots are hidden"))
    (dolist (form '((?- (let)) (?- (let ?x 1)) (?- (let :x 1)) (?- (let t 1))
                    (?- (let *package* 1)) (?- (let x 1 (not-a-declaration)))
                    (?- (let x 1 (declare (special x))))))
      (check (signals-error-p (lambda () (macroexpand-1 form))) "reject invalid or special LET bindings"))))
