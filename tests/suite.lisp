(uiop:define-package #:sprolog/tests/suite
  (:use #:cl #:sprolog)
  (:nicknames #:sprolog/tests)
  (:import-from #:sprolog/tests/native #:run-native-tests)
  (:import-from #:sprolog/tests/iso-compatibility #:run-iso-compatibility-tests)
  (:import-from #:sprolog/tests/prolog-loader #:run-prolog-loader-tests)
  (:import-from #:sprolog/tests/cons-operations #:run-cons-operation-tests)
  (:import-from #:sprolog/tests/builtins #:run-builtin-tests)
  (:import-from #:sprolog/tests/dcg #:run-dcg-tests)
  (:import-from #:sprolog/tests/interactive #:run-interactive-tests)
  (:import-from #:sprolog/tests/let #:run-let-tests)
  (:import-from #:sprolog/tests/slg #:run-slg-depth-tests #:run-slg-tests #:run-wfs-exhaustive-tests #:run-wfs-oracle-tests)
  (:import-from #:sprolog/tests/slg-cut #:run-slg-cut-tests)
  (:import-from #:sprolog/tests/standard-library #:run-derived-adapter-tests #:run-standard-library-tests)
  (:import-from #:sprolog/tests/term-syntax #:run-term-syntax-tests)
  (:import-from #:sprolog/tests/tests #:*checks* #:check #:solutions #:value-of)
  (:import-from #:sprolog/tests/wam-gc #:run-wam-gc-tests)
  (:export #:run-tests))
(in-package #:sprolog/tests/suite)
(defun run-package-tests ()
  (check (eq (find-package :sprolog) (find-package :sprolog/src/api/package))
         "public nickname selects final facade")
  (check (eq (symbol-package 'sprolog/src/kernel/engine:unify)
             (find-package :sprolog/src/kernel/engine)) "engine owns unification")
  (check (eq (symbol-package 'sprolog/src/syntax/compiler:query)
             (find-package :sprolog/src/syntax/compiler)) "compiler owns query construction")
  (check (eq (symbol-package 'sprolog/src/api/api:<-)
             (find-package :sprolog/src/api/api)) "API module owns definition macro")
  (check (eq 'sprolog:query 'sprolog/src/syntax/compiler:query)
         "facade reexports provider symbol")
  (check (eq 'sprolog:<- 'sprolog/src/api/api:<-)
         "facade reexports macro symbol")
  (check (null (find-symbol "ISO-COPY" :sprolog)) "facade does not import private graph copier")
  (dolist (package (list-all-packages))
    (when (and (uiop:string-prefix-p "SPROLOG/SRC/" (package-name package))
               (not (eq package (find-package :sprolog))))
      (check (null (package-nicknames package)) "implementation packages have no nicknames"))))

(defun run-tests ()
  (let ((*database* (make-database)) (*checks* 0))
    (run-package-tests)
  (run-native-tests)
    (<-- (parent alice bob)) (<- (parent bob charlie))
    (<-- (ancestor ?x ?y) (parent ?x ?y))
    (<- (ancestor ?x ?y) (parent ?x ?z) (ancestor ?z ?y))
    (check (equal (mapcar (lambda (s) (value-of '?who s)) (solutions (ancestor alice ?who)))
                  '(bob charlie)) "clause order and recursion")
    (<-- (append () ?ys ?ys))
    (<- (append ( ?x  . ?xs) ?ys ( ?x  . ?zs)) (append ?xs ?ys ?zs))
    (let ((solutions (solutions (append ?xs ?ys ( a b c)))))
      (check (= 4 (length solutions)) "append alternatives")
      (check (equal (mapcar (lambda (s) (list (value-of '?xs s) (value-of '?ys s))) solutions)
                    '((nil (a b c)) ((a) (b c)) ((a b) (c)) ((a b c) nil)))))
    (<-- (same ?x ?x))
    (check (null (solutions (same a b))) "repeated head variable")
    (check (equal (solutions (same a a)) '(nil)) "ground success is distinct from failure")
    (check (equal (solutions (= ?x ( a b)) (= ?y ?x)) '(((?x a b) (?y a b)))) "built-in unification")
    (<-- (local ?x) (parent alice ?x) !)
    (<- (local fallback))
    (check (equal (mapcar (lambda (s) (value-of '?x s)) (solutions (local ?x))) '(bob)) "cut")
    (<-- (pick a)) (<- (pick b))
    (<-- (inner ?x) (pick ?x) !)
    (check (equal (mapcar (lambda (s) (list (value-of '?a s) (value-of '?b s)))
                         (solutions (pick ?a) (inner ?b))) '((a a) (b a))) "cut preserves caller alternatives")
    (<-- (bad ?x) (= ?x a) (same a b))
    (<- (bad b))
    (check (eq 'b (value-of '?x (first (solutions (bad ?x))))) "failed bindings roll back")
    (<-- (anonymous ? ?))
    (check (equal (solutions (anonymous a b)) '(nil)) "fresh anonymous variables")
    (check (null (query '((pick ?x)) :limit 0)))
    (check (= 1 (length (query '((pick ?x)) :limit 1))))
    (let ((items '(a b c)) (results nil))
      (prolog (lisp ?items items) (append ?xs ?ys ?items)
              (lisp (push (list ?xs ?ys) results)))
      (check (= 4 (length results)) "lexical Lisp bridge"))
    (let ((threshold 2))
      (check (equal (solutions (lisp ?x (+ threshold 1)) (lispp (> ?x threshold))) '(((?x . 3))))))
    (check (eq :done (prolog (pick ?x) (lisp (return-from prolog :done)))) "nonlocal exit")
    (check (null (solutions (lispp nil))) "host failure")
    (<-- (cycle ?x) (= ?x ( a  . ?x)))
    (let ((v (value-of '?x (first (solutions (cycle ?x))))))
      (check (and (eq (car v) 'a) (eq (cdr v) v)) "cyclic term export"))
    (check (equal (solutions (cycle ?x) (cycle ?y) (= ?x ?y) fail) nil) "cyclic unification terminates")
    (let ((cursor (make-query '((pick ?x)))))
      (check (eq 'a (value-of '?x (next-solution cursor))))
      (<-- (pick c))
      (check (eq 'b (value-of '?x (next-solution cursor))) "active alternatives retain old code")
      (check (not (nth-value 1 (next-solution cursor))))
      (close-query cursor))
    (check (eq 'c (value-of '?x (first (solutions (pick ?x))))) "replacement visible to new calls")
    ;; Tail recursion: host arithmetic avoids allocating a million-node input term.
    (<-- (down 0) !)
    (<- (down ?n) (lispp (> ?n 0)) (lisp ?m (1- ?n)) (down ?m))
    ;; Non-tail recursion: TRUE is after the recursive call, preventing EXECUTE.
    (<-- (non-tail 0) !)
    (<- (non-tail ?n) (lispp (> ?n 0)) (lisp ?m (1- ?n)) (non-tail ?m) (true))
    (dolist (case '((down 1000000 1) (non-tail 100000 100001)))
      (destructuring-bind (name depth expected) case
        (let ((vm (make-query (list (list name depth)))) (start (get-internal-real-time)))
          (unwind-protect
               (progn (check (nth-value 1 (next-solution vm)) "deep recursive success")
                      (check (= expected (getf (query-statistics vm) :max-continuation-depth))
                             "explicit continuation depth")
                      (format t "~S/~D: ~,3Fs ~S~%" name depth
                              (/ (- (get-internal-real-time) start) internal-time-units-per-second)
                              (query-statistics vm)))
            (close-query vm)))))
    ;; Compilation, copying, unification and export of a deep cons graph are iterative.
    (let* ((large (loop repeat 100000 collect 'a))
           (vm (make-query (list (list '= '?x large) (list '= '?x large)))))
      (unwind-protect
           (check (= 100000 (length (value-of '?x (next-solution vm)))) "deep term")
        (close-query vm)))
    (run-wam-gc-tests)
    (run-dcg-tests)
    (run-slg-tests)
    (run-wfs-oracle-tests)
    (run-wfs-exhaustive-tests)
    (run-slg-depth-tests)
    (run-slg-cut-tests)
    (run-builtin-tests)
    (run-term-syntax-tests)
    (run-cons-operation-tests)
    (run-prolog-loader-tests)
    (run-iso-compatibility-tests)
    (run-interactive-tests)
    (run-let-tests)
    (run-standard-library-tests)
    (run-derived-adapter-tests)
    (format t "~D checks passed.~%" *checks*) t))
