(in-package #:sprolog/tests)

(defun incomplete-cut-p (thunk)
  (handler-case (progn (funcall thunk) nil) (slg-incomplete-cut () t)))
(defun run-slg-cut-tests ()
  (dolist (gc '(nil 1 8 64))
    (let ((*database* (make-database)))
      (table 'pick 1)
      (<-- (candidate a)) (<- (candidate b))
      (<-- (pick ?x) (candidate ?x) !)
      (<- (pick fallback))
      (check (equal (query '((pick ?x)) :gc-threshold gc) '(((?x . a))))
             "cut in tabled generator prunes ordinary candidates and later clauses")
      (table 'entry-cut 1)
      (<-- (entry-cut ?x) ! (candidate ?x)) (<- (entry-cut fallback))
      (check (equal (slg-values '?x (query '((entry-cut ?x)) :gc-threshold gc)) '(a b))
             "entry cut preserves alternatives created after it")
      (table 'choices 1) (<-- (choices a)) (<- (choices b))
      (table 'first-tabled 1)
      (<-- (first-tabled ?x) (choices ?x) !)
      (<- (first-tabled fallback))
      (check (equal (query '((first-tabled ?x) (choices ?y)) :gc-threshold gc)
                    '(((?x . a) (?y . a)) ((?x . a) (?y . b))))
             "child table completes before cut; its other answers remain available")
      (table 'reach-cut 2)
      (<-- (arc a b)) (<- (arc b c)) (<- (arc c a))
      (<-- (reach-cut ?x ?y) (reach-cut ?x ?z) (arc ?z ?y))
      (<- (reach-cut ?x ?y) (arc ?x ?y))
      (table 'first-reach 1)
      (<-- (first-reach ?x) (reach-cut a ?x) !)
      (check (equal (query '((first-reach ?x) (reach-cut a ?y)) :gc-threshold gc)
                    '(((?x . b) (?y . b)) ((?x . b) (?y . c)) ((?x . b) (?y . a))))
             "recursive child SCC completes before parent cut")
      ;; A new helper's local cut does not cross the caller's earlier suspension.
      (table 'helper-loop 1)
      (<-- (helper-loop ?x) (helper-loop ?x) (local-helper))
      (<- (helper-loop a))
      (<-- (local-helper) !) (<- (local-helper) fail)
      (check (equal (query '((helper-loop ?x)) :gc-threshold gc) '(((?x . a))))
             "helper cut after a caller suspension is local")
      ;; Rebased continuations retain logical boundaries when returning to callers.
      (table 'ancestor-loop 1)
      (<-- (ancestor-loop ?x) (suspending-helper ?x) !)
      (<- (ancestor-loop a))
      (<-- (suspending-helper ?x) (ancestor-loop ?x))
      (check (incomplete-cut-p (lambda () (query '((ancestor-loop ?x)) :gc-threshold gc)))
             "cut after returning from suspended helper crosses unfinished table")
      (table 'recursive-cut 1)
      (<-- (recursive-cut ?x) (recursive-cut ?x) !) (<- (recursive-cut a))
      (check (incomplete-cut-p (lambda () (query '((recursive-cut ?x)) :gc-threshold gc)))
             "recursive consumer cut is rejected with a typed condition")
      (table 'mutual-a 1) (table 'mutual-b 1)
      (<-- (mutual-a ?x) (mutual-b ?x) !) (<- (mutual-a a))
      (<-- (mutual-b ?x) (mutual-a ?x)) (<- (mutual-b b))
      (check (incomplete-cut-p (lambda () (query '((mutual-a ?x)) :gc-threshold gc)))
             "mutual recursive cut crosses incomplete SCC")
      (table 'frozen-alternative 0)
      (<-- (frozen-alternative) (frozen-alternative))
      (<- (frozen-alternative) !) (<- (frozen-alternative))
      (check (incomplete-cut-p (lambda () (query '((frozen-alternative)) :gc-threshold gc)))
             "cut in a later clause cannot silently discard an earlier frozen consumer")
      (table 'undefined-child 0) (<-- (undefined-child) (tnot (undefined-child)))
      (table 'negative-parent 0) (<-- (negative-parent) (tnot (undefined-child)) !)
      (check (eq :undefined (getf (car (query '((negative-parent)) :truth-values t :gc-threshold gc)) :truth))
             "completed negative SCC permits parent cut")
      (table 'negative-cut 0) (<-- (negative-cut) (tnot (negative-cut)) !)
      (check (incomplete-cut-p (lambda () (query '((negative-cut)) :truth-values t :gc-threshold gc)))
             "cut over an unfinished delayed negative subgoal rejected")
      (table 'letters-cut 2)
      (---> (letters-cut) (:or (:terminals a) (:terminals b)) !)
      (--> (letters-cut) (:terminals c))
      (check (equal (phrase '(letters-cut) '?input nil :gc-threshold gc) '(((?input a))))
             "DCG predicate cut in tabled generator")
      (table 'opaque-phrase 1)
      (<-- (opaque-phrase ?tokens)
           (phrase (:or (:seq (:terminals a) !) (:terminals b)) ?tokens ()))
      (<- (opaque-phrase ( c)))
      (check (equal (query '((opaque-phrase ?tokens)) :gc-threshold gc)
                    '(((?tokens a)) ((?tokens c)))) "PHRASE cut preserves generator clause choices")
      (table 'opaque-after-suspend 1)
      (<-- (opaque-after-suspend ?x)
           (opaque-after-suspend ?x)
           (phrase (:or (:seq (:terminals a) !) (:terminals b)) ( a) ()))
      (<- (opaque-after-suspend seed))
      (check (equal (query '((opaque-after-suspend ?x)) :gc-threshold gc) '(((?x . seed))))
             "opaque PHRASE cut after caller suspension remains local")
      ;; Dependency graph consists of two mutually recursive SCCs.
      (table 'scc-p 1) (table 'scc-q 1) (table 'scc-r 1) (table 'scc-s 1)
      (<-- (scc-p ?x) (scc-q ?x)) (<- (scc-p ?x) (scc-r ?x))
      (<-- (scc-q ?x) (scc-p ?x))
      (<-- (scc-r ?x) (scc-s ?x)) (<- (scc-r base))
      (<-- (scc-s ?x) (scc-r ?x))
      (let ((vm (make-query '((scc-p ?x)) :gc-threshold gc)))
        (unwind-protect
             (progn
               (check (equal (next-solution vm) '((?x . base))))
               (check (= 2 (getf (getf (query-statistics vm) :slg) :max-component-size)))
               (check (= 2 (getf (getf (query-statistics vm) :slg) :completed-components)))
               (collect-query-garbage vm)
               (check (not (nth-value 1 (next-solution vm)))))
          (close-query vm)))
      (let ((vm (make-query '((recursive-cut ?x)) :gc-threshold gc)))
        (unwind-protect
             (progn
               (check (incomplete-cut-p (lambda () (next-solution vm))) "cursor cut failure")
               (check (not (nth-value 1 (next-solution vm))) "illegal cut aborts cursor")
               (check (zerop (getf (getf (query-statistics vm) :slg) :tables))
                      "illegal cut immediately releases partial tables"))
          (close-query vm))
        (check (zerop (getf (getf (query-statistics vm) :slg) :tables)) "cut error cleanup")))))
