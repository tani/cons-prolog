;;; Run against any checkout for differential comparison:
;;; SPROLOG_ROOT=/path/to/checkout sbcl --script tests/derived-observations.lisp
(require :asdf)
(let ((*standard-output* (make-broadcast-stream)))
  (asdf:load-asd (truename (merge-pathnames "sprolog.asd"
                        (uiop:ensure-directory-pathname (or (uiop:getenv "SPROLOG_ROOT") "./")))))
  (asdf:load-system "sprolog"))
(uiop:define-package #:sprolog/tests/observations (:use #:cl #:sprolog))
(in-package #:sprolog/tests/observations)
(defun observation (goals)
  (handler-case
      (list :solutions (query goals :limit 20 :gc-threshold 1))
    (iso-exception (c) (list :error (iso-exception-term c)))))
(let ((*database* (make-database)) (*print-circle* t) (*print-pretty* nil))
  (dolist (goals
           '(((nonvar ?x)) ((atomic 1/2)) ((atomic #C(1 2))) ((number 1/2))
             ((callable (a . b))) ((ground (f ?x))) ((= ?x (a . ?x)) (ground ?x))
             ((/= (f ?x ?x) (f a b)) (var ?x)) ((/== ?x ?x))
             ((once (or (= ?x a) (= ?x b)))) ((repeat))
             ((/+ (and (= ?x a) fail)) (var ?x)) ((/+ (and ! fail)))
             ((or (-> true fail) true)) ((call once (or (= ?x a) (= ?x b))))
             ((once 42)) ((/+ ?x))
             ((copy_term (f ?x ?x) (f ?a ?b)) (== ?a ?b) (/== ?x ?a))
             ((= ?x (a . ?x)) (copy_term ?x ?y) (== ?x ?y))
             ((atom_length abc ?n)) ((atom_length 42 bad)) ((atom_length ?x ?n))
             ((sub_atom abc ?b ?n ?a ?s)) ((sub_atom abc ?x ?x ?a ?s))
             ((sub_atom abc 0 -1 ?a ?s)) ((sub_atom abc ?b ?n ?a 42))
             ((atom_chars abc (?a ?b ?c))) ((atom_chars ?atom (a b c)))
             ((atom_chars abc (?a . ?tail))) ((atom_chars ?atom (?a)))
             ((atom_chars abc (bad))) ((atom_chars 42 bad))
             ((number_chars 12 ?chars)) ((number_chars ?n (|1| |2|)))
             ((number_chars 1/2 ?chars)) ((number_chars ?n (?char)))
             ((number_chars ?n (a))) ((number_chars 12 (|1| ?char)))
             ((retractall (absent ?x)) (var ?x) (current_predicate (/ absent 1)))
             ((retractall (once ?x))) ((open ?file read ?stream))
             ((close 42)) ((get_char 42)) ((put_code -1))))
    ;; Normalize package identities, but preserve variable names and graph shape.
    (write (sprolog/src/kernel/engine:map-term (observation goals)
                    (lambda (x) (if (symbolp x) (string-downcase (symbol-name x)) x))))
    (terpri))
  (let* ((input (make-string-input-stream "ab")) (output (make-string-output-stream))
         (state (sprolog/src/adapters/adapter:iso-state-for *database*)))
    (setf (sprolog/src/kernel/model:iso-state-input state) input (sprolog/src/kernel/model:iso-state-output state) output)
    (dolist (goals '(((peek_char ?c)) ((get_char ?c)) ((get_code ?c))
                     ((get_code ?c)) ((at_end_of_stream)) ((nl))
                     ((put_char z)) ((flush_output))))
      (write (sprolog/src/kernel/engine:map-term (observation goals)
                      (lambda (x) (if (symbolp x) (string-downcase (symbol-name x)) x))))
      (terpri))
    (write (get-output-stream-string output)) (terpri)))
