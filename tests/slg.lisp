(in-package #:sprolog/tests)

(defun slg-values (name solutions)
  (sort (mapcar (lambda (s) (value-of name s)) solutions) #'string< :key #'prin1-to-string))
(defun signals-error-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun run-slg-tests ()
  (let ((*database* (make-database)))
    (table 'reach 2)
    (<-- (edge a b)) (<- (edge b c)) (<- (edge c a)) (<- (edge c d))
    ;; Recursive clause deliberately precedes the base case.
    (<-- (reach ?x ?y) (reach ?x ?z) (edge ?z ?y))
    (<- (reach ?x ?y) (edge ?x ?y))
    (dolist (gc '(nil 1 8 64))
      (check (equal (slg-values '?y (query '((reach a ?y)) :gc-threshold gc)) '(a b c d))
             "SLG left recursion and cyclic transitive closure")
      (check (= 12 (length (query '((reach ?x ?y)) :gc-threshold gc))) "all-pairs closure")
      (check (equal (?- (reach a ?y) (reach a ?y)) '(((?y . b)) ((?y . c)) ((?y . a)) ((?y . d)))))
      (let ((vm (make-query '((reach a ?y)) :gc-threshold gc)))
        (unwind-protect
             (progn
               (check (nth-value 1 (next-solution vm)))
               (check (plusp (getf (getf (query-statistics vm) :slg) :suspensions)))
               (check (plusp (getf (getf (query-statistics vm) :slg) :resumptions)))
               (collect-query-garbage vm)
               (check (= 3 (loop while (nth-value 1 (next-solution vm)) count t))))
          (close-query vm))
        (check (zerop (getf (getf (query-statistics vm) :slg) :tables)) "close clears table space")))
    (table 'p 1) (table 'q 1)
    (<-- (p ?x) (q ?x)) (<- (p base))
    (<-- (q ?x) (p ?x)) (<- (q other))
    (check (equal (slg-values '?x (?- (p ?x))) '(base other)) "mutual recursion")
    (table 'empty-loop 0)
    (<-- (empty-loop) (empty-loop))
    (check (null (?- (empty-loop))) "positive loop without a base case fails")
    (table 'alias 2)
    (<-- (alias ?x ?x)) (<- (alias ?x ?x))
    (let ((answers (?- (alias ?x ?y))))
      (check (= 1 (length answers)) "nonground variant answers deduplicated")
      (check (eq (value-of '?x (car answers)) (value-of '?y (car answers))) "alias preserved"))
    (<- (alias a b))
    (check (= 1 (length (?- (alias ?x ?x)))) "call variant distinguishes sharing")
    (check (= 2 (length (?- (alias ?x ?y)))) "fresh query observes added clause")
    (table 'nested 1)
    (<-- (nested ( node ?x ?x)))
    (check (= 1 (length (?- (nested ?out)))))
    (check (equal (?- (nested ( node a ?y))) '(((?y . a)))) "structured tabled answers")
    (table 'zero 0) (<-- (zero)) (<- (zero))
    (check (equal (?- (zero)) '(nil)) "ground duplicate answer")
    (<-- (wrapper ?x) (reach a ?x))
    (check (= 4 (length (?- (wrapper ?x)))) "table tail call from untabled predicate")
    (<-- (first ?x) (reach a ?x) !)
    (check (= 1 (length (?- (first ?x)))) "caller cut after completion")
    ;; Left-recursive DCG; input is finite, so its variants and answers are finite.
    (table 'letters 2)
    (---> (letters) (letters) (:terminals a)) (--> (letters))
    (dolist (gc '(nil 1 8))
      (check (equal (phrase '(letters) '( a a a) nil :gc-threshold gc) '(nil)) "left-recursive DCG")
      (check (= 4 (length (phrase '(letters) '( a a a) '?rest :gc-threshold gc))) "DCG prefix answers"))
    ;; Ground negation, including unfounded positive loops and negative cycles.
    (table 'neg-p 0) (table 'neg-q 0)
    (<-- (neg-p) (tnot (neg-q))) (<-- (neg-q) (tnot (neg-p)))
    (check (null (?- (neg-p))) "ordinary query enumerates only true answers")
    (let ((result (query '((neg-p)) :truth-values t :gc-threshold 1)))
      (check (= 1 (length result)))
      (check (eq :undefined (getf (car result) :truth)) "negative cycle undefined")
      (check (equal '((neg-q)) (getf (car result) :delays))))
    (let ((vm (make-query '((neg-p)))))
      (unwind-protect
           (multiple-value-bind (bindings found truth delays) (next-solution vm)
             (declare (ignore bindings))
             (check found) (check (eq truth :undefined)) (check (equal delays '((neg-q)))))
        (close-query vm)))
    (check (eq :undefined (getf (car (query '((tnot (neg-p))) :truth-values t)) :truth)))
    (table 'odd 0) (<-- (odd) (tnot (odd)))
    (check (eq :undefined (getf (car (query '((odd)) :truth-values t)) :truth)) "odd negative loop")
    (table 'not-empty 0) (<-- (not-empty) (tnot (empty-loop)))
    (check (equal (?- (not-empty)) '(nil)) "unfounded loop makes negation true")
    (check (null (?- (tnot (zero)))) "negation of true fails")
    (check (equal (?- (tnot (empty-loop))) '(nil)) "negation of false succeeds")
    (table 'simplified 0)
    (<-- (simplified) (tnot (neg-p)) (empty-loop))
    (check (null (query '((simplified)) :truth-values t)) "failed suffix eliminates delayed answer")
    (table 'certain 0)
    (<-- (certain) (tnot (neg-p))) (<- (certain))
    (check (equal (query '((certain)) :truth-values t)
                  '((:truth :true :bindings nil :delays nil))) "unconditional answer dominates")
    (table 'false-neg 0) (table 'true-neg 0)
    (<-- (false-neg) (tnot (true-neg))) (<-- (true-neg))
    (check (null (query '((false-neg)) :truth-values t)) "late unconditional answer invalidates delay")
    (table 'delayed-alternative 1)
    (<-- (delayed-alternative ?x) (tnot (neg-p)) (= ?x conditional))
    (<- (delayed-alternative definite))
    (check (equal (?- (delayed-alternative ?x)) '(((?x . definite)))) "branch delay rollback")
    (check (= 2 (length (query '((delayed-alternative ?x)) :truth-values t))))
    (check (signals-error-p (lambda () (?- (tnot (reach a ?x))))) "non-ground negation flounders")
    (check (signals-error-p (lambda () (?- (tnot (edge a b))))) "negation requires table declaration")
    (check (signals-error-p (lambda () (?- (= ?x ( f ?x)) (nested ?x)))) "cyclic table call rejected")
    (table 'unsafe-cut 0) (<-- (unsafe-cut) !)
    (check (equal (?- (unsafe-cut)) '(nil)) "generator entry cut allowed")
    (table 'unsafe-host 0) (<-- (unsafe-host) (lisp 1))
    (check (signals-error-p (lambda () (?- (unsafe-host)))) "generator host callback rejected")
    (let ((vm (make-query '((reach a ?y)))))
      (unwind-protect
           (progn (next-solution vm) (<- (edge e f))
                  (check (signals-error-p (lambda () (next-solution vm))) "active table invalidation rejected"))
        (close-query vm)))
    (table 'winning 1)
    (<-- (game-edge a b)) (<- (game-edge b a))
    (<- (game-edge c d)) (<- (game-edge e c)) (<- (game-edge f f))
    (<-- (winning ?x) (game-edge ?x ?y) (tnot (winning ?y)))
    (let ((results (query '((winning ?x)) :truth-values t :gc-threshold 1)))
      (check (= 4 (length results)) "nonground generator with ground negative children")
      (check (equal (sort (loop for r in results when (eq :true (getf r :truth))
                               collect (value-of '?x (getf r :bindings))) #'string<) '(c)))
      (check (equal (sort (loop for r in results when (eq :undefined (getf r :truth))
                               collect (value-of '?x (getf r :bindings))) #'string<) '(a b f))))
    (let ((first (copy-seq "same")) (second (copy-seq "same")))
      (table 'identity 2) (<-- (identity ?x ?x))
      (let ((vm (make-query (list (list 'identity first '?x) (list 'identity second '?y)))))
        (unwind-protect
             (let ((answer (next-solution vm)))
               (check (eq first (value-of '?x answer)))
               (check (eq second (value-of '?y answer)))
               (check (= 2 (getf (getf (query-statistics vm) :slg) :tables))
                      "table keys preserve EQL identity of string atoms"))
          (close-query vm))))
    (check (signals-error-p (lambda () (?- (neg-p) (lisp 1))))
           "host side effects on conditional derivations rejected")
    (table 'identity-after 2)
    (<-- (identity-after ?x ?y) (zero) (= ?x ?y))
    (let* ((atom (vector 1 2))
           (answer (query (list (list 'identity-after atom '?out)) :gc-threshold 1)))
      (check (eq atom (value-of '?out (car answer))) "continuation copy preserves vector atom identity"))
    (untable 'zero 0)
    (check (= 2 (length (?- (zero)))) "untable restores SLD duplicate enumeration")
    (clear-database)
    (check (zerop (hash-table-count (sprolog::database-tabled *database*))) "clear removes declarations")))

(defun wfs-oracle (rules count)
  "Independent alternating fixed point on a finite propositional reduct."
  (labels ((gamma (assumption)
             (let ((model 0))
               (loop
                 (let ((next model))
                   (dolist (rule rules)
                     (destructuring-bind (head positives negatives) rule
                       (when (and (zerop (logand negatives assumption))
                                  (= positives (logand positives model)))
                         (setf next (logior next (ash 1 head))))))
                   (when (= next model) (return model))
                   (setf model next))))))
    (let ((lower 0) (upper (1- (ash 1 count))))
      (loop
        (let* ((new-lower (gamma upper)) (new-upper (gamma new-lower)))
          (when (and (= lower new-lower) (= upper new-upper))
            (return (values lower upper)))
          (setf lower new-lower upper new-upper))))))
(defun run-wfs-oracle-tests ()
  (let ((seed 1789))
    (labels ((draw (n)
               (setf seed (mod (+ (* seed 1664525) 1013904223) 4294967296))
               (mod (ash seed -8) n)))
      (dotimes (case 300)
        (let* ((*database* (make-database))
               (names (loop for i below 3 collect (make-symbol (format nil "ORACLE~D" i))))
               (rules (loop repeat (draw 10) collect (list (draw 3) (draw 8) (draw 8)))))
          (dolist (name names) (table name 0))
          (dolist (rule rules)
            (destructuring-bind (head positives negatives) rule
              (sprolog::add-clause
               (list (nth head names))
               (append (loop for name in names for i from 0 when (logbitp i positives) collect (list name))
                       (loop for name in names for i from 0 when (logbitp i negatives) collect (list 'tnot (list name)))) nil)))
          (multiple-value-bind (lower upper) (wfs-oracle rules 3)
            (loop for name in names for i from 0 do
              (let* ((result (query (list (list name)) :truth-values t
                                    :gc-threshold (if (evenp case) 1 nil)))
                     (actual (if (null result) :false (getf (car result) :truth)))
                     (expected (cond ((logbitp i lower) :true) ((logbitp i upper) :undefined) (t :false))))
                (check (eq actual expected)
                       (format nil "WFS oracle case ~D atom ~D rules ~S: ~S vs ~S"
                               case i rules actual expected))))))))))

(defun run-wfs-exhaustive-tests ()
  ;; All 1,024 subsets of two-atom rules with empty/single-literal bodies.
  (let ((universe (loop for head below 2 append
                    (append (list (list head 0 0))
                            (loop for target below 2 collect (list head (ash 1 target) 0))
                            (loop for target below 2 collect (list head 0 (ash 1 target)))))))
    (dotimes (program 1024)
      (let* ((*database* (make-database)) (names '(exhaust-p exhaust-q))
             (rules (loop for rule in universe for i from 0 when (logbitp i program) collect rule)))
        (dolist (name names) (table name 0))
        (dolist (rule rules)
          (destructuring-bind (head pos neg) rule
            (sprolog::add-clause
             (list (nth head names))
             (append (loop for name in names for i from 0 when (logbitp i pos) collect (list name))
                     (loop for name in names for i from 0 when (logbitp i neg) collect (list 'tnot (list name)))) nil)))
        (multiple-value-bind (lower upper) (wfs-oracle rules 2)
          (loop for name in names for i from 0 do
            (let* ((answer (query (list (list name)) :truth-values t :gc-threshold 1))
                   (actual (if answer (getf (car answer) :truth) :false))
                   (expected (cond ((logbitp i lower) :true) ((logbitp i upper) :undefined) (t :false))))
              (check (eq actual expected) (format nil "exhaustive WFS program ~D atom ~D" program i)))))))))

(defun run-slg-depth-tests ()
  (let ((*database* (make-database)))
    (table 'tabled-chain 1)
    (<-- (tabled-chain ?x) (chain-edge ?x ?y) (tabled-chain ?y))
    (<- (tabled-chain 500))
    (dotimes (i 500) (sprolog::add-clause (list 'chain-edge i (1+ i)) nil nil))
    (let ((vm (make-query '((tabled-chain 0)) :gc-threshold 1)))
      (unwind-protect
           (progn
             (check (nth-value 1 (next-solution vm)) "500-level SLG dependency chain on a 1 MiB control stack")
             (check (= 501 (getf (getf (query-statistics vm) :slg) :tables)))
             (check (not (nth-value 1 (next-solution vm))))
             (format t "SLG 500 dependencies completed.~%"))
        (close-query vm)))))
