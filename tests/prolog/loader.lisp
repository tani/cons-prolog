(uiop:define-package #:cons-prolog/tests/prolog/loader
  (:use #:cl #:prolog)
  (:import-from #:cons-prolog/tests/support/assertions #:check #:value-of)
  (:export #:run-prolog-loader-tests))
(in-package #:cons-prolog/tests/prolog/loader)
(defun loader-error-p (thunk name)
  (handler-case (progn (funcall thunk) nil)
    (iso-exception (c)
      (let* ((term (iso-exception-term c)) (kind (second term)))
        (string-equal name (symbol-name (if (consp kind) (car kind) kind)))))))
(defun run-prolog-loader-tests ()
  (let ((*database* (make-database)) (*package* (find-package :cons-prolog/tests/prolog/loader)))
    (check (equal '((f a b) (f a b) (a b . tail) nil (f))
                  (parse-prolog-string "f(a,b). [f,a,b]. [a,b|tail]. []. f().")) "native term mapping")
    (let* ((term (first (parse-prolog-string "p(X,X,_,_)."))) (args (cdr term)))
      (check (eq (first args) (second args)) "named variable sharing")
      (check (not (eq (third args) (fourth args))) "fresh anonymous variables"))
    (let ((terms (parse-prolog-string "p(X). q(X).")))
      (check (not (eq (second (first terms)) (second (second terms)))) "per-term variable scope"))
    (check (equal '((+ 1 (* 2 3)) (- (- 5 2) 1) (|^| 2 (|^| 3 4)) -2 (97 98))
                  (parse-prolog-string "1+2*3. 5-2-1. 2^3^4. -2. \"ab\".")) "operator precedence and associativity")
    (check (equal '((p a) (q b)) (parse-prolog-string (format nil "%% comment~%p(a). /* block */ q(b)."))))
    (check (equal '(1 1.25d0 100.0d0) (parse-prolog-string "1. 1.25. 1e2.")))
    (check (equal '(83 83 83 83 10 46)
                  (parse-prolog-string "0b1010011. 0o123. 0x53. 0'S. 0'\\n. 0'.."))
           "ISO integer bases and character-code literals")
    (check (equal '(-16 (p 10 10))
                  (parse-prolog-string "-0x10. p(0b1010,0o12)."))
           "base literals retain signs and argument boundaries")
    (check (equal '(a a a)
                  (parse-prolog-string "'\\x61\\'. '\\141\\'. 'a'."))
           "ISO hexadecimal and octal escapes")
    (check (equal (list (list (code-char 7) #\Backspace #\Page (code-char 11)))
                  (mapcar (lambda (chars) (mapcar #'code-char chars))
                          (parse-prolog-string "\"\\a\\b\\f\\v\".")))
           "ISO control escapes")
    (dolist (text '("0x." "0b2." "0o8." "0xfg." "0'." "'\\x\\'." "'\\x61'." "'\\40000000\\'."))
      (check (loader-error-p (lambda () (parse-prolog-string text)) "syntax_error") text))
    (check (equal '((p |IT'S|)) (parse-prolog-string "p('it''s').")))
    (check (equal '((|[| |]| |,| |;| |(| |)| |.|))
                  (parse-prolog-string "['[',']',',',';','(',')','.']."))
           "quoted delimiters are atoms inside lists")
    (check (equal '((p |]| |(|)) (parse-prolog-string "p(']','(')."))
           "quoted delimiters are ordinary arguments")
    (with-input-from-string (stream "[]. p(a).")
      (multiple-value-bind (term present) (read-prolog-term stream)
        (check (and present (null term)) "NIL is not EOF"))
      (check (equal '(p a) (read-prolog-term stream)))
      (check (not (nth-value 1 (read-prolog-term stream)))))
    (with-input-from-string (stream (format nil "p.%% comment~%q."))
      (check (eq 'p (read-prolog-term stream)))
      (check (eq 'q (read-prolog-term stream))) "lookahead restores comment marker")
    (dolist (text '("p(a)" "p(a).junk." "p(." "[a|]." "'unterminated" "/* unterminated" "a=b=c."))
      (check (loader-error-p (lambda () (parse-prolog-string text)) "syntax_error") text))
    (dolist (text '("p(a')'." "[a']'." "a '.'"))
      (check (loader-error-p (lambda () (parse-prolog-string text)) "syntax_error")
             "quoted delimiters cannot close syntax forms"))
    (check (string= "#." (symbol-name (caar (parse-prolog-string "#.(evil).")))) "no Lisp reader evaluation")
    (check (= 4 (load-prolog-string "parent(alice,bob). parent(bob,charlie). ancestor(X,Y) :- parent(X,Y). ancestor(X,Y) :- parent(X,Z), ancestor(Z,Y).")))
    (dolist (gc '(nil 1 8 4096))
      (check (equal '(bob charlie) (mapcar (lambda (s) (value-of '?who s))
                                          (query '((ancestor alice ?who)) :gc-threshold gc)))))
    (load-prolog-string "pick(a). pick(b). first(X) :- pick(X), !. positive(X,Y) :- X > 0 -> Y is X+1 ; Y=0.")
    (check (equal '(a) (mapcar (lambda (s) (value-of '?x s)) (query '((first ?x))))))
    (check (query '((positive 3 4) (positive 0 0))))
    (load-prolog-string "pick(c). pick(d).")
    (check (equal '(c d) (mapcar (lambda (s) (value-of '?x s)) (query '((pick ?x))))) "replacement per load")
    (load-prolog-string ":- op(450, xfy, likes). alice likes bob. relation(X,Y) :- X likes Y.")
    (check (query '((likes alice bob) (relation alice bob))))
    (check (equal '((likes a (likes b c))) (parse-prolog-string "a likes b likes c.")))
    (load-prolog-string ":- op(0, xfy, likes).")
    (check (loader-error-p (lambda () (parse-prolog-string "a likes b.")) "syntax_error"))
    (load-prolog-string ":- op(300, fx, pre). :- op(300, xf, post).")
    (check (equal '((pre a) (post a)) (parse-prolog-string "pre a. a post.")) "prefix and postfix")
    (load-prolog-string ":- char_conversion(a,z). abc.")
    (check (query '((zbc))) "character conversion affects subsequent terms")
    (check (equal '(a) (parse-prolog-string "'a'.")) "quoted atoms bypass conversion")
    (check (query '((set_prolog_flag char_conversion off))))
    (check (equal '(abc) (parse-prolog-string "abc.")))
    (check (query '((set_prolog_flag double_quotes chars))))
    (check (equal '((a b)) (parse-prolog-string "\"ab\".")))
    (check (query '((set_prolog_flag double_quotes atom))))
    (check (equal '(ab) (parse-prolog-string "\"ab\".")))
    (check (query '((set_prolog_flag double_quotes codes))))
    (check (equal '(p q) (parse-prolog-string "p./* block */ q.")))
    (load-prolog-string ":- dynamic empty/1. :- discontiguous parent/2. :- multifile shared/1. shared(a).")
    (check (null (query '((empty a)))) "empty dynamic predicate exists")
    (load-prolog-string "shared(b).")
    (check (= 2 (length (query '((shared ?x))))) "multifile appends")
    (load-prolog-string ":- initialization(assertz(ready)). after_init.")
    (check (query '((ready) (after_init))))
    (check (loader-error-p (lambda () (load-prolog-string ":- dynamic p/X.")) "instantiation_error"))
    (check (loader-error-p (lambda () (load-prolog-string ":- include(X).")) "instantiation_error"))
    (check (loader-error-p (lambda () (load-prolog-string ":- fail.")) "load_error"))
    (check (loader-error-p (lambda () (load-prolog-string "true.")) "permission_error"))
    (load-prolog-string "token --> [a], {true}. two --> token, token. either --> [a] ; [b].")
    (check (phrase 'two '(a a)))
    (check (phrase 'either '(b)))
    (check (loader-error-p (lambda () (parse-prolog-string (concatenate 'string (make-string 80 :initial-element #\() "a" (make-string 80 :initial-element #\)) "."))) "syntax_error") "controlled nesting limit")
    (let ((text (format nil "large(~{~A~^,~})." (loop repeat 2000 collect "a"))))
      (check (= 2001 (length (first (parse-prolog-string text)))) "long flat term"))
    (let ((text (format nil "flat_right :- ~{~A~^,~}." (loop repeat 2000 collect "true"))))
      (load-prolog-string text)
      (check (query '((flat_right))) "long right-associative clauses do not exhaust parser frames"))
    (let ((*database* (make-database)))
      (load-prolog-string ":- op(900,xfy,r). :- op(900,xfy,s). :- op(900,yf,post).")
      (check (equal '((r a (r b c)) (r a (s b c)) (s (r a b) c))
                    (parse-prolog-string "a r b r c. a r b s c. (a r b) s c."))
             "flat xfy parsing preserves mixed operators and parentheses")
      (check (loader-error-p (lambda () (parse-prolog-string "a r b post r c.")) "syntax_error")
             "xfy parsing retains equal-priority operand restrictions"))
    (let* ((dir (merge-pathnames (format nil "cons-prolog-loader-~A/" (symbol-name (gensym))) (uiop:temporary-directory)))
           (root (merge-pathnames "root.pl" dir)) (child (merge-pathnames "child.pl" dir))
           (cycle (merge-pathnames "cycle.pl" dir)))
      (ensure-directories-exist root)
      (unwind-protect
           (progn
             (with-open-file (s child :direction :output :if-exists :supersede) (write-string "from_file(child)." s))
             (with-open-file (s root :direction :output :if-exists :supersede)
               (write-string ":- include('child.pl'). from_file(root). :- ensure_loaded('child.pl')." s))
             (check (= 2 (load-prolog-file root)))
             (check (= 2 (length (query '((from_file ?x))))) "include shares replacement context")
             (check (zerop (load-prolog-string ":- ensure_loaded('child.pl')." :base-directory dir)))
             (clear-database)
             (check (= 1 (load-prolog-string ":- ensure_loaded('child.pl')." :base-directory dir)))
             (with-open-file (s cycle :direction :output :if-exists :supersede) (write-string ":- include('cycle.pl')." s))
             (check (loader-error-p (lambda () (load-prolog-file cycle)) "permission_error"))
             (check (loader-error-p (lambda () (load-prolog-string ":- include('absent.pl')." :base-directory dir)) "existence_error")))
        (uiop:delete-directory-tree dir :validate t :if-does-not-exist :ignore)))
    (let ((*database* (make-database)))
      (check (null (parse-prolog-string "% only comment")))
      (check (loader-error-p (lambda () (parse-prolog-string "a likes b.")) "syntax_error") "operator state isolation"))))
