(uiop:define-package #:sprolog/tests/prolog/io
  (:use #:cl #:prolog)
  (:import-from #:sprolog/tests/support/assertions #:check)
  (:import-from #:sprolog/tests/adapters/builtins #:iso-error-p)
  (:export #:run-prolog-io-tests))
(in-package #:sprolog/tests/prolog/io)

(defun text-goals (text)
  (list (first (parse-prolog-string text))))
(defun rendered (text &optional (gc 1))
  (let ((out (make-string-output-stream)))
    (unwind-protect
         (progn
           (query (cons (list 'set_output out) (text-goals text)) :gc-threshold gc)
           (get-output-stream-string out))
      (query (list (list 'set_output *standard-output*)))
      (close out))))
(defun roundtrip (text gc &optional canonical)
  (let ((out (make-string-output-stream)))
    (unwind-protect
         (let* ((goal (first (parse-prolog-string text)))
                (write-goal (list (if canonical 'write_canonical 'writeq) out '?term)))
           ;; Bind the actual VM term before both writing and comparison.
           (query (list (list '= '?term goal) write-goal) :gc-threshold gc)
           (with-input-from-string (in (concatenate 'string (get-output-stream-string out) ". "))
             (query (list (list '= '?expected goal) (list 'read in '?actual)
                          '(= ?actual ?expected)) :gc-threshold gc)))
      (close out))))

(defun run-prolog-io-tests ()
  (let ((*package* (find-package :sprolog/tests/prolog/io)))
    (let ((*database* (make-database)))
      (check (query '((current_prolog_flag read_syntax lisp) (current_prolog_flag write_syntax lisp))))
      (dolist (flag '(read_syntax write_syntax))
        (check (iso-error-p (list (list 'set_prolog_flag flag 'sexp)) "domain_error")
               "syntax flags accept LISP rather than SEXP")
        (check (iso-error-p (list (list 'set_prolog_flag flag 'bad)) "domain_error")))
      (check (query '((set_prolog_flag write_syntax prolog) (current_prolog_flag read_syntax lisp)))
             "input and output syntax are independent")
      (check (null (query '((set_prolog_flag read_syntax prolog) fail))))
      (clear-database)
      (check (query '((current_prolog_flag read_syntax prolog) (current_prolog_flag write_syntax prolog)))
             "syntax settings survive failure and clearing clauses")
      (let ((*database* (make-database)))
        (check (query '((current_prolog_flag read_syntax lisp) (current_prolog_flag write_syntax lisp)))
               "syntax settings belong to each database")))
    (dolist (gc '(nil 1 8 4096))
      (let ((*database* (make-database)))
        (query '((set_prolog_flag read_syntax prolog) (set_prolog_flag write_syntax prolog)))
        (check (equal "f(a,b)" (rendered "write(f(a,b))." gc)))
        (check (equal "A" (rendered "write('A')." gc)))
        (check (equal "'A'" (rendered "writeq('A')." gc)))
        (check (equal "f(_G0,_G0,_G1)" (rendered "writeq(f(X,X,Y))." gc)))
        (check (equal "f(X,X,_G1)" (rendered "write_term(f(A,A,B),[variable_names(['X'=A,'_G0'=Z])])." gc))
               "explicit variable names reserve generated names")
        (check (equal "a + b * c" (rendered "writeq(a+b*c)." gc)))
        (check (equal "(a + b) * c" (rendered "writeq((a+b)*c)." gc)))
        (check (equal "+(a,*(b,c))" (rendered "write_canonical(a+b*c)." gc)))
        (check (equal "+(a,b)" (rendered "write_term(a+b,[ignore_ops(true)])." gc)))
        (check (equal "A" (rendered "writeq('$VAR'(0))." gc)))
        (check (equal "Z1" (rendered "write_term('$VAR'(51),[numbervars(true)])." gc)))
        (check (equal "'$VAR'(0)" (rendered "write_canonical('$VAR'(0))." gc)))
        (check (equal "'a''b\\\\c\\n'" (rendered "writeq('a''b\\\\c\\n')." gc)))
        (dolist (text '("f(a,b)." "f(X,X,Y)." "f()." "[]." "[1,a|T]."
                        "f([X,a],X)." "'A'." "'[]'." "'{}'." "','." "'|'." "'.'." "';'."
                        "'/*comment'." "''." "'a''b\\\\c\\n'." "f(0,123456789012345678901234567890,1.5,-2.5,-1)."
                        "a-(b-c)." "(a-b)-c." "(a;b),c." "f((a,b),(c->d;e))."
                        "(-1)**2." "-(1)." "'$VAR'(0)."))
          (check (roundtrip text gc t) "canonical Prolog output reads back as the same native term")
          (unless (string= text "'$VAR'(0).")
            (check (roundtrip text gc) "operator Prolog output reads back as the same native term")))
        (dolist (declaration '("op(300,fx,pre)." "op(300,fy,prey)." "op(300,xf,post)."
                               "op(300,yf,posty)." "op(500,xfx,rel)." "op(500,xfy,right)."
                               "op(500,yfx,left)."))
          (query (text-goals declaration)))
        (dolist (text '("pre a." "prey prey a." "a post." "a posty posty." "a rel b."
                        "a right b right c." "a left b left c." "(a right b) right c."
                        "a left (b left c)." "f((pre a),(a post),pre)." "prey(prey(a))."))
          (check (roundtrip text gc) "operator precedence and all seven fixities roundtrip"))
        (let ((lisp-text (rendered "set_prolog_flag(write_syntax,lisp),writeq(f(a,b))." gc)))
          (check (equal (concatenate 'string "f(a,b)" lisp-text)
                        (rendered "set_prolog_flag(write_syntax,prolog),writeq(f(a,b)),set_prolog_flag(write_syntax,lisp),writeq(f(a,b))." gc))
                 "write syntax can change between writes"))
        (query '((set_prolog_flag write_syntax prolog)))
        (check (iso-error-p '((= ?x (f . ?x)) (writeq ?x)) "representation_error")
               "Prolog output rejects cycles explicitly")
        (check (iso-error-p '((writeq "host string")) "type_error") "opaque Lisp values require Lisp output")
        (check (iso-error-p (text-goals "write_term(f(X,Y),[variable_names(['A'=X,'A'=Y])]).") "domain_error"))
        (check (iso-error-p (text-goals "write_term(X,[variable_names(['bad'=X])]).") "domain_error"))
        (check (query '((catch (write_term "host" ())
                               (error ?kind (/ write_term 2)) true))) "writer preserves wrapper error context")))
    (let ((*database* (make-database)) (out (make-string-output-stream)))
      (unwind-protect
           (progn
             (query '((set_prolog_flag write_syntax prolog)))
             (let ((deep 'a))
               (dotimes (i 10000) (setf deep (list 'f deep)))
               (check (query (list (list 'writeq out deep))) "deep Prolog output uses an explicit stack")
               (check (= 30001 (length (get-output-stream-string out)))))
             (let ((flat (loop repeat 20000 collect 1)))
               (check (query (list (list 'writeq out flat))) "long list output uses an explicit stack")
               (check (= 40001 (length (get-output-stream-string out))))))
        (close out)))))
