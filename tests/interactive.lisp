(defpackage #:sprolog/tests/interactive (:use #:cl #:sprolog/tests/term-syntax))
(in-package #:sprolog/tests)

(defun interactive-output (commands thunk)
  (let* ((*package* (find-package :sprolog/tests))
         (input (make-string-input-stream commands))
         (output (make-string-output-stream))
         (*query-io* (make-two-way-stream input output)))
    (funcall thunk)
    (get-output-stream-string output)))

(defun run-interactive-tests ()
  (let ((*database* (make-database)))
    (let ((count 0))
      (let ((output (interactive-output (string #\Newline)
                      (lambda () (?- (repeat) (lisp (incf count)) (= ?x first))))))
        (check (= count 1) "interactive query does not enumerate infinite alternatives")
        (check (search "?X = FIRST" output) "interactive binding display")
        (check (search "More?" output) "interactive continuation prompt")))
    (let ((count 0))
      (let ((output (interactive-output (format nil ";~%;~%")
                      (lambda () (?- (or (= ?x a) (= ?x b)) (lisp (incf count)))))))
        (check (= count 2) "semicolon computes successive answers")
        (check (and (search "?X = A" output) (search "?X = B" output))
               "all requested bindings displayed")
        (check (search "false." output) "exhaustion displayed only after requesting another")))
    (check (search "true." (interactive-output "" (lambda () (?- (true)))))
           "ground success is readable")
    (let ((output (interactive-output "" (lambda () (?- (fail))))))
      (check (search "false." output) "initial failure displayed")
      (check (not (search "More?" output)) "failure does not prompt"))
    (let ((count 0))
      (interactive-output "" (lambda () (?- (repeat) (lisp (incf count)))))
      (check (= count 1) "EOF stops without evaluating next alternative"))
    (let ((count 0))
      (let ((output (interactive-output (format nil "invalid~%~%")
                      (lambda () (?- (repeat) (lisp (incf count)))))))
        (check (= count 1) "invalid input does not advance the query")
        (check (search "Type ;" output) "invalid commands explain the choices")))
    (dolist (command '("q" "."))
      (let ((count 0))
        (interactive-output command (lambda () (?- (repeat) (lisp (incf count)))))
        (check (= count 1) "explicit stop commands do not advance")))
    (let ((offset 10))
      (check (search "?X = 13" (interactive-output "" (lambda () (?- (lisp ?x (+ 3 offset))))))
             "interactive macro retains lexical callbacks"))
    (interactive-output "" (lambda ()
      (check (null (multiple-value-list (?- (true))))
             "interactive macro returns no values")))
    (check (search "#1=" (interactive-output "" (lambda () (?- (= ?x (a . ?x))))))
           "cyclic answers are printed safely")
    (table 'interactive-p 0) (table 'interactive-q 0)
    (<-- (interactive-p) (tnot (interactive-q)))
    (<-- (interactive-q) (tnot (interactive-p)))
    (let ((output (interactive-output "" (lambda () (?- (interactive-p))))))
      (check (search "undefined" output) "conditional answer displays truth status")
      (check (search "INTERACTIVE-Q" output) "conditional answer displays delayed negation"))
    ;; Verify ownership teardown on stop, EOF, host error and nonlocal exit.
    (let ((original (symbol-function 'make-query)) (cursor nil))
      (unwind-protect
           (progn
             (setf (symbol-function 'make-query)
                   (lambda (&rest args) (setf cursor (apply original args))))
             (dolist (input (list (string #\Newline) ""))
               (interactive-output input (lambda () (?- (repeat))))
               (check (sprolog::machine-closed cursor) "stop and EOF close cursor")
               (check (zerop (length (sprolog::machine-heap cursor))) "stop releases managed roots"))
             (check (signals-error-p
                     (lambda ()
                       (interactive-output (format nil ";~%")
                         (lambda () (?- (or (true) (lisp (error "test failure"))))))))
                    "execution errors propagate")
             (check (sprolog::machine-closed cursor) "error closes cursor")
             (block escape
               (interactive-output "" (lambda () (?- (lisp (return-from escape))))))
             (check (sprolog::machine-closed cursor) "nonlocal exit closes cursor"))
        (setf (symbol-function 'make-query) original)))))
