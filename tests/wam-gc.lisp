(uiop:define-package #:sprolog/tests/wam-gc
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/tests/tests #:check #:solutions #:value-of)
  (:export #:palette #:red #:blue #:compare-gc-modes #:normalize-solutions #:run-wam-gc-tests))
(in-package #:sprolog/tests/wam-gc)

(defun normalize-solutions (solutions)
  ;; Normalize fresh unbound-variable symbols while preserving identity per solution.
  (mapcar (lambda (solution)
            (let ((names (make-hash-table :test 'eq)))
              (sprolog/src/kernel/engine:map-term solution
                (lambda (x)
                  (if (and (symbolp x) (null (symbol-package x)))
                      (or (gethash x names)
                          (setf (gethash x names) (list :unbound (hash-table-count names)))) x)))))
          solutions))
(defun compare-gc-modes (goals &optional limit)
  (let ((expected (normalize-solutions (query goals :limit limit :gc-threshold nil))))
    (dolist (threshold '(1 8 64))
        (check (equal expected (normalize-solutions
                                (query goals :limit limit :gc-threshold threshold)))
               "GC differential result"))))

(defun run-wam-gc-tests ()
  ;; Stress garbage construction and release while preserving older alternatives.
  (<-- (discard ?))
  (<-- (waste 0) !)
  (<- (waste ?n)
      (lispp (> ?n 0))
      (discard ( payload ?n ( nested ?n)))
      (lisp ?m (1- ?n))
      (waste ?m))
  (<-- (palette red)) (<- (palette blue))
  (<-- (product ?x ?y) (palette ?x) (waste 30) (palette ?y) (waste 30))
  (<-- (retry-gc ?x) (= ?x first) (waste 100) fail)
  (<- (retry-gc ?x) (= ?x second) (waste 100))
  (<-- (structured ( node ?x ( leaf ?x) ?)))
  (<-- (constant-structure ( node a b)))
  (<-- (unbound ?x ?y))
  (dolist (goals '(((append ?xs ?ys ( a b c d)))
                   ((ancestor alice ?x))
                   ((product ?x ?y))
                   ((retry-gc ?x))
                   ((same ?x ?y) (palette ?x) (waste 50))
                   ((structured ?x))
                   ((structured ( node a ( leaf b) ignored)))
                   ((structured ( node a ( leaf a) ignored)))
                   ((constant-structure ( node  . ?tail)))
                   ((constant-structure ( node . ( a  . ?tail))))
                   ((unbound ?x ?y))
                   ((= ?x (f ?y ?y)) (= ?y ( g a)))
                   ((= ?x (f a)) (= ?x ( g a)))
                   ((= ?x ( a  . ?tail)) (= ?x ( a b c)))
                   ((= ?x ( a  . ?tail)) (= ?tail ?rest))))
    (compare-gc-modes goals))
  (<-- (cut-child ?x) (palette ?x) (waste 30) !)
  (compare-gc-modes '((palette ?x) (cut-child ?y)))
  ;; Nested compound arguments and repeated variable constraints vary independently.
  (loop for i below 40 do
    (let ((term (list 'tree (list 'left i) (list 'right (mod i 5)))))
      (compare-gc-modes (list (list '= '?x term)
                              (list '= '?x (list 'tree (list 'left '?a) (list 'right '?b)))
                              (list '= '?a i)))
      (compare-gc-modes (list (list '= '?x term)
                              (list '= '?x (list 'tree (list 'left (1+ i)) '?rest))))))
  ;; Truly cyclic source graphs must compile as well as cycles made by unification.
  (let ((ring (cons 'a nil)))
    (setf (cdr ring) ring)
    (sprolog/src/syntax/compiler:add-clause (list 'cyclic-head ring) nil t)
    (dolist (goals (list (list (list '= '?x ring)) '((cyclic-head ?x))))
        (let ((vm (make-query goals :gc-threshold 1)))
          (unwind-protect
               (progn
                 (let ((term (value-of '?x (next-solution vm))))
                   (check (and (eq (car term) 'a) (eq (cdr term) term))
                          "cyclic source graph compiles and reifies"))
                 (collect-query-garbage vm))
            (close-query vm)))))
  ;; Collection between returned answers must retain future alternatives and undo data.
  (<-- (cycle-or-atom ?x) (= ?x ( a  . ?x)))
  (<- (cycle-or-atom final))
  (let ((vm (make-query '((cycle-or-atom ?x)) :gc-threshold 1)))
      (unwind-protect
           (progn
             (let ((x (value-of '?x (next-solution vm))))
               (check (eq (cdr x) x) "cyclic answer before forced GC"))
             (collect-query-garbage vm)
             (check (eq 'final (value-of '?x (next-solution vm))) "rollback after forced cyclic GC")
             (check (not (nth-value 1 (next-solution vm))) "exhaustion after forced GC"))
        (close-query vm)))
  ;; A detached answer must remain valid when subsequent searches collect the VM graph.
  (let ((vm (make-query '((append ?xs ?ys ( a b c))) :gc-threshold 1)))
    (unwind-protect
         (let ((first (next-solution vm)))
           (loop while (nth-value 1 (next-solution vm)) do (collect-query-garbage vm))
           (check (equal (value-of '?ys first) '(a b c)) "answer lifetime independent of VM"))
      (close-query vm)))
  ;; Actual compiler output must use term families rather than generalized templates.
  (let* ((p (gethash (cons 'structured 1) (sprolog/src/kernel/model:database-predicates *database*)))
         (ops (map 'list #'car (sprolog/src/kernel/model:predicate-code p))))
    (check (member 'sprolog/src/kernel/instructions:get-structure ops) "compiled GET_STRUCTURE")
    (check (member 'sprolog/src/kernel/instructions:unify-void ops) "compiled anonymous UNIFY_VOID")
    (check (not (intersection ops '(sprolog/src/kernel/instructions:get-term sprolog/src/kernel/instructions:put-args sprolog/src/kernel/engine:unify)))
           "production code uses granular term operations"))
  ;; Direct instruction programs exercise read/write modes, A/X aliasing, and VOID.
  (let* ((vm (sprolog/src/kernel/model:%make-machine
              :args (make-array 16 :initial-element nil)
              :code #((sprolog/src/kernel/instructions:allocate 3 16)
                      (sprolog/src/kernel/instructions:put-list (:x 0))
                      (sprolog/src/kernel/instructions:set-void 2)
                      (sprolog/src/kernel/instructions:get-list (:a 0))
                      (sprolog/src/kernel/instructions:unify-variable (:y 0))
                      (sprolog/src/kernel/instructions:unify-variable (:y 1))
                      (sprolog/src/kernel/instructions:put-constant a (:a 1))
                      (sprolog/src/kernel/instructions:get-value (:y 0) (:a 1))
                      (sprolog/src/kernel/instructions:put-structure pair 2 (:a 2))
                      (sprolog/src/kernel/instructions:set-value (:y 0))
                      (sprolog/src/kernel/instructions:set-variable (:y 2))
                      (sprolog/src/kernel/instructions:get-structure pair 2 (:a 2))
                      (sprolog/src/kernel/instructions:unify-constant a)
                      (sprolog/src/kernel/instructions:unify-void 1)
                      (sprolog/src/kernel/instructions:yield)))))
    (unwind-protect
         (progn
           (check (sprolog/src/kernel/engine:run-machine vm) "direct term instruction sequence")
           (check (not (eq (aref (sprolog/src/kernel/model:machine-slots vm) 0)
                           (aref (sprolog/src/kernel/model:machine-slots vm) 1))) "VOID creates independent variables")
           (collect-query-garbage vm)
           (check (equal (car (sprolog/src/kernel/engine:reify (aref (sprolog/src/kernel/model:machine-args vm) 2))) 'pair)
                  "instruction-register roots survive collection"))
      (close-query vm)))
  ;; Bounded managed live cells for long deterministic tail recursion with garbage terms.
  (let ((vm (make-query '((waste 100000)) :gc-threshold 64)))
    (unwind-protect
         (progn
           (check (nth-value 1 (next-solution vm)) "garbage-producing tail recursion")
           (let ((stats (query-statistics vm)))
             (check (plusp (getf stats :gc-count)) "automatic collection actually ran")
             (check (> (getf stats :gc-reclaimed) 100000) "unreachable cells reclaimed")
             (check (< (getf stats :max-heap-cells) 128) "bounded managed heap during tail recursion")
             (check (< (getf stats :max-trail-cells) 16) "bounded conditional trail")
             (format t "Garbage-producing tail recursion: ~S~%" stats)))
      (close-query vm)))
  ;; Collect while a write scan is active: its unfinished cons cell is a root.
  (let ((vm (sprolog/src/kernel/model:%make-machine :args (make-array 1 :initial-element nil))))
    (unwind-protect
         (progn
           (sprolog/src/kernel/wam:execute-term-instruction vm 'sprolog/src/kernel/instructions:put-list '((:a 0)))
           (setf (aref (sprolog/src/kernel/model:machine-args vm) 0) nil)
           (collect-query-garbage vm)
           (check (= 1 (length (sprolog/src/kernel/model:machine-heap vm))) "active scan roots survive GC")
           (sprolog/src/kernel/wam:execute-term-instruction vm 'sprolog/src/kernel/instructions:set-constant '(a))
           (sprolog/src/kernel/wam:execute-term-instruction vm 'sprolog/src/kernel/instructions:set-constant '(b))
           (collect-query-garbage vm)
           (check (zerop (length (sprolog/src/kernel/model:machine-heap vm))) "finished dead scan is reclaimed"))
      (close-query vm)))
  ;; A closed cursor retains neither heap, trail, continuation nor scan roots.
  (let ((vm (make-query '((product ?x ?y)) :gc-threshold 1)))
    (next-solution vm) (close-query vm)
    (check (and (zerop (length (sprolog/src/kernel/model:machine-heap vm)))
                (zerop (length (sprolog/src/kernel/model:machine-trail vm)))
                (null (sprolog/src/kernel/model:machine-scan vm))
                (null (sprolog/src/kernel/model:machine-continuation vm))) "closed cursor releases roots")))
