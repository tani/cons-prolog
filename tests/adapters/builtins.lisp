(uiop:define-package #:sprolog/tests/adapters/builtins
  (:use #:cl #:prolog)
  (:import-from #:sprolog/tests/support/assertions #:check #:solutions #:value-of)
  (:import-from #:sprolog/tests/kernel/slg-cut)
  (:export #:iso-error-p #:iso-value #:run-builtin-arithmetic-tests #:run-builtin-extra-tests #:run-builtin-stream-tests #:run-builtin-tests #:run-prolog-arrow-tests #:run-readable-spelling-tests #:run-unification-spelling-tests))
(in-package #:sprolog/tests/adapters/builtins)

(defun iso-value (name goals &optional (gc 1))
  (value-of name (car (query goals :gc-threshold gc))))
(defun iso-error-p (goals class)
  (handler-case (progn (query goals :gc-threshold 1) nil)
    (iso-exception (c)
      (let ((term (iso-exception-term c)))
        (and (consp term)
             (string= (sprolog/src/adapters/term-ops:iso-text (car term)) "error")
             (string= (sprolog/src/adapters/term-ops:iso-text (nth-value 0 (sprolog/src/adapters/term-ops:iso-parts (second term)))) class))))))
(defun run-builtin-tests ()
  (let ((*database* (make-database)))
    (dolist (gc '(nil 1 8 4096))
      (dolist (g '((var ?x) (nonvar a) (atom a) (atom ()) (atomic 3) (number 3.0d0)
                   (integer 3) (float 3.0d0) (compound ( f a)) (callable a)
                   (ground ( f a)) (acyclic_term ( a b)) (true)))
        (check (query (list g) :gc-threshold gc) "builtin type tests"))
      (check (null (query '((integer 3.0d0)) :gc-threshold gc)))
      (check (null (query '((unify_with_occurs_check ?x ( f ?x))) :gc-threshold gc)) "occurs check")
      (check (null (query '((|\\=| ?x ( f ?x))) :gc-threshold gc)) "nonunifiability follows engine unification")
      (check (query '((|\\=| a b)) :gc-threshold gc))
      (check (query '((subsumes_term ( f ?x ?y) ( f ?z ?z))) :gc-threshold gc))
      (check (null (query '((subsumes_term ( f ?z ?z) ( f ?x ?y))) :gc-threshold gc)))
      (check (query '((subsumes_term ?x ( f ?y)) (var ?x) (var ?y)) :gc-threshold gc) "subsumption has no bindings")
      (check (query '((= ?x ( a  . ?x)) (ground ?x)) :gc-threshold gc))
      (check (null (query '((= ?x ( a  . ?x)) (acyclic_term ?x)) :gc-threshold gc)))
      (check (query '((= ?x ( a  . ?x)) (copy_term ?x ?y) (== ?x ?y)) :gc-threshold gc) "cyclic copy and identity")

      (check (= 2 (length (iso-value '?vars '((term_variables ( f ?x ?x ?y) ?vars)) gc))))

      (check (= 19 (iso-value '?n '((is ?n (+ 1 (* 3 6)))) gc)))
      (check (query '((|=:=| 1 1.0d0) (|=\\=| 1 2) (< 1 2) (=< 2 2) (> 3 2) (>= 3 3)) :gc-threshold gc))
      (check (= -2 (iso-value '?n '((is ?n (// -7 3))) gc)))
      (check (= -3 (iso-value '?n '((is ?n (div -7 3))) gc)))
      (check (= 2 (iso-value '?n '((is ?n (mod -7 3))) gc)))
      (check (= -1 (iso-value '?n '((is ?n (rem -7 3))) gc)))
      (check (= 3 (iso-value '?n '((is ?n (round 2.5d0))) gc)))
      (check (= 3 (iso-value '?n '((is ?n (xor 5 6))) gc)))
      (check (= 3 (iso-value '?n '((atom_length abc ?n)) gc)))
      (check (equal '(97 98 99) (iso-value '?codes '((atom_codes abc ?codes)) gc)))
      (check (query '((atom_codes ?a ( 97 98 99)) (atom_length ?a 3)) :gc-threshold gc))
      (check (query '((atom_chars ?a ( a b c)) (atom_length ?a 3)) :gc-threshold gc))
      (check (= 65 (iso-value '?code '((char_code sprolog/atoms::|A| ?code)) gc)))
      (check (= 123 (iso-value '?n '((number_codes ?n ( 49 50 51))) gc)))
      (check (= 4 (length (query '((atom_concat ?a ?b abc)) :gc-threshold gc))))
      (check (= 10 (length (query '((sub_atom abc ?before ?len ?after ?sub)) :gc-threshold gc))))
      (check (query '((atom_concat a b ab)) :gc-threshold gc))
      (check (query '((|,| (= ?x 1) (= ?y 2))) :gc-threshold gc))
      (check (= 2 (length (query '((|;| (= ?x 1) (= ?x 2))) :gc-threshold gc))))
      (check (equal '(1) (mapcar (lambda (s) (value-of '?x s))
                                 (query '((once (|;| (= ?x 1) (= ?x 2)))) :gc-threshold gc))))
      (check (query '((|\\+| (= a b))) :gc-threshold gc))
      (check (null (query '((|\\+| (= ?x a))) :gc-threshold gc)))
      (check (query '((|\\+| (|,| (= ?x a) fail)) (var ?x)) :gc-threshold gc) "negation rollback")
      (check (= 1 (iso-value '?x '((|;| (-> (|;| (= ?x 1) (= ?x 2)) true) (= ?x 3))) gc)))
      (check (= 3 (iso-value '?x '((|;| (-> fail (= ?x 1)) (= ?x 3))) gc)))
      (check (null (query '((|;| (-> true fail) true)) :gc-threshold gc)) "if success commits despite then failure")
      (check (= 5 (iso-value '?x '((call (= ?x 5))) gc)))
      (check (query '((= ?g (= ?x 7)) (call ?g) (= ?x 7)) :gc-threshold gc))
      (check (query '((catch (throw foo) ?e (= ?x ?e)) (= ?x foo)) :gc-threshold gc))
      (check (query '((catch (|,| (= ?x a) (throw ball)) ?e (var ?x)) (= ?e ball)) :gc-threshold gc) "exception rolls bindings back")
      (check (= 2 (length (query '((catch (|;| (= ?x 1) (= ?x 2)) ?e fail)) :gc-threshold gc))) "catch is nondeterministic")
      (check (query '((catch (catch (throw a) b fail) a true)) :gc-threshold gc) "unmatched catcher propagates")
      (check (query '((catch (catch (throw a) a (throw b)) b true)) :gc-threshold gc) "handler inactive in recovery")
      (check (query '((catch (|;| (= ?x 1) (throw ball)) ?e (= ?x 2))) :gc-threshold gc) "catch reentry on retry")
      (check (equal '(1 2) (iso-value '?bag '((findall ?x (|;| (= ?x 1) (= ?x 2)) ?bag)) gc)))
      (check (query '((findall ?x fail ?bag) (= ?bag ())) :gc-threshold gc))
      (check (null (query '((bagof ?x fail ?bag)) :gc-threshold gc)))
      )
    (<-- (iso-pick a)) (<- (iso-pick b))
    (check (= 2 (length (solutions (call iso-pick ?x)))) "call/2")
    (<-- (iso-seven ?a ?b ?c ?d ?e ?f ?g))
    (check (solutions (call iso-seven 1 2 3 4 5 6 7)) "call/8")
    (<-- (iso-cut ?x) (iso-pick ?x) (call !))
    (check (= 2 (length (solutions (iso-cut ?x)))) "meta-call cut is opaque")
    (<-- (iso-transparent ?x) (|;| (|,| (iso-pick ?x) !) (= ?x c)))
    (check (= 1 (length (solutions (iso-transparent ?x)))) "disjunction cut is transparent")
    (<-- (iso-if ?x) (|;| (-> fail (= ?x a)) (= ?x b)))
    (check (eq 'b (iso-value '?x '((iso-if ?x)))) "clause if initializes Y before choice")
    (<-- (iso-group a 2)) (<- (iso-group b 3)) (<- (iso-group a 1))
    (let ((solutions (solutions (bagof ?v (iso-group ?key ?v) ?bag))))
      (check (= 2 (length solutions)))
      (check (equal '(a b) (mapcar (lambda (s) (value-of '?key s)) solutions)))
      (check (equal '((2 1) (3)) (mapcar (lambda (s) (value-of '?bag s)) solutions))))
    
    (check (solutions (assertz (iso-dynamic a)) (asserta (iso-dynamic b))))
    (check (equal '(b a) (mapcar (lambda (s) (value-of '?x s)) (solutions (iso-dynamic ?x)))))
    (check (= 2 (length (solutions (clause (iso-dynamic ?x) ?body)))))
    (check (= 2 (length (solutions (retract (iso-dynamic ?x))))) "retract effects occur on retry")
    (check (null (solutions (iso-dynamic ?x))))
    (check (solutions (assertz (|:-| (iso-rule ?x) (= ?x 4))) (iso-rule 4)))
    (check (solutions (retractall (iso-rule ?x))))
    (check (null (solutions (iso-rule 4))))
    (check (solutions (abolish (/ iso-rule 1))))
    (check (iso-error-p '((iso-rule 4)) "existence_error"))
    (check (iso-error-p '((is ?x ?y)) "instantiation_error"))
    (check (iso-error-p '((is ?x (/ 1 0))) "evaluation_error"))
    (check (iso-error-p '((is ?x (unknown 1))) "type_error"))

    (check (iso-error-p '((call 42)) "type_error"))
    (check (iso-error-p '((assertz (integer a))) "permission_error"))
    (check (solutions (catch (is ?x ?y) ?e true)) "ISO errors are catchable")
    (check (solutions (current_prolog_flag unknown error)))
    (check (solutions (set_prolog_flag unknown fail)))
    (check (null (solutions (unknown-iso-predicate))))
    (check (solutions (set_prolog_flag unknown error)))
    (check (iso-error-p '((set_prolog_flag bounded true)) "permission_error"))
    (run-builtin-extra-tests)
    (run-unification-spelling-tests)
    (run-readable-spelling-tests)
    (run-prolog-arrow-tests)
    (run-builtin-arithmetic-tests)
    
    (run-builtin-stream-tests)
    (format t "Builtin inventory: ~D predicate indicators.~%" (length (builtin-predicate-inventory)))))

(defun run-builtin-stream-tests ()
  (let* ((path (merge-pathnames (format nil "sprolog-iso-~A.tmp" (gensym)) (uiop:temporary-directory)))
         (file (sprolog/src/adapters/term-ops:iso-atom (namestring path))))
    (unwind-protect
         (progn
           (let ((solutions (query (list (list 'open file 'write '?s '((alias iso-test-stream)))
                                         '(put_code ?s 65) '(put_char ?s b) '(nl ?s)
                                         '(stream_property ?s ( mode write)) '(close ?s)) :gc-threshold 1)))
             (check solutions "open/write/property/close"))

           (check (solutions (current_input ?s) (set_input ?s) (current_output ?o) (set_output ?o) (flush_output))))
      (when (probe-file path) (delete-file path)))))

(defun run-builtin-extra-tests ()
  (<-- (iso-tail-catch ?x) (catch (throw a) ?e (= ?x ?e)))
  (check (solutions (iso-tail-catch a)) "tail catch recovery returns to caller")
  (<-- (iso-catch-fail ?x) (catch fail ?e (= ?x a)))
  (check (null (solutions (iso-catch-fail ?x))))
  (<-- (iso-catch-retry ?x) (catch (|;| (= ?x 1) (throw ball)) ball (= ?x 2)))
  (check (equal '(1 2) (mapcar (lambda (s) (value-of '?x s)) (solutions (iso-catch-retry ?x)))))
  (dolist (gc '(nil 1 8 4096))
    (check (query '((catch (|,| (= ?x ( f a)) (|,| (is ?n (+ 1 2)) (throw ball))) ball (var ?x))) :gc-threshold gc)
           "catch roots and rollback survive GC"))
  (<-- (iso-countdown 0) !)
  (<- (iso-countdown ?n) (> ?n 0) (is ?m (- ?n 1)) (iso-countdown ?m))
  (check (solutions (iso-countdown 100000)) "ISO arithmetic deep tail recursion")
  (<-- (iso-meta-down 0) !)
  (<- (iso-meta-down ?n) (> ?n 0) (is ?m (- ?n 1)) (call iso-meta-down ?m))
  (let ((vm (make-query '((iso-meta-down 10000)))))
    (unwind-protect
         (progn (check (nth-value 1 (next-solution vm)) "deep meta-calls")
                (check (< (getf (query-statistics vm) :max-continuation-depth) 5) "meta-call tail optimization"))
      (close-query vm)))
  (table 'iso-tabled 1) (<-- (iso-tabled ?x) (is ?x (+ 1 2)))
  (check (solutions (iso-tabled 3)))
  (table 'iso-meta 1) (<-- (iso-meta ?x) (call iso-tabled ?x))
  (check (solutions (iso-meta 3)) "SLG suspension through call")
  (check (equal '(nil nil nil) (query '((repeat)) :limit 3)))
  (check (solutions (catch (throw ( f ?x)) ( f ?y) (var ?y))))
  (check (solutions (assertz (|:-| (iso-retract-rule ?x) (= ?x 4)))))
  (check (solutions (retract (|:-| (iso-retract-rule ?x) (= ?x 4)))) "retract S-expression rule body")
  (check (null (solutions (iso-retract-rule 4))))
  (check (solutions (assertz (iso-view a)) (assertz (iso-view b))))
  (let ((vm (make-query '((iso-view ?x)))))
    (unwind-protect
         (progn (check (eq 'a (value-of '?x (next-solution vm))))
                (check (solutions (retractall (iso-view ?))))
                (check (eq 'b (value-of '?x (next-solution vm))) "logical update view for active calls"))
      (close-query vm)))
  (<-- (iso-nonground ?x a)) (<- (iso-nonground ?y b))
  (check (equal '(a b) (iso-value '?bag '((bagof ?v (iso-nonground ?key ?v) ?bag)))) "bagof groups variants")
  (check (= 1 (length (solutions (bagof ?v (iso-nonground ?key ?v) ?bag)))))

  (check (= 255 (iso-value '?n '((number_codes ?n ( 48 120 102 102))))))
  (check (iso-error-p '((is ?n (/ 0 0))) "evaluation_error"))
  (check (iso-error-p '((number_codes ?n ( 49 46))) "syntax_error"))
  (let ((status nil) (*iso-halt-function* nil))
    (setf *iso-halt-function* (lambda (code) (setf status code)))
    (check (solutions (halt 7))) (check (= 7 status)) (check (solutions (halt))) (check (= 0 status)))
  (check (solutions (current_predicate ?indicator)))
  (check (iso-error-p '((stream_property ?s nonsense)) "domain_error"))
  (dolist (predicate '(get_char get_code peek_char peek_code))
    (let* ((stream (make-string-input-stream "a"))
           (*database* (make-database))
           (state (sprolog/src/adapters/adapter:iso-state-for *database*)))
      (setf (sprolog/src/kernel/model:iso-state-input state) stream)
      (check (query (list (list predicate '?x))) "current-input arity")
      (check (query (list (list predicate (make-string-input-stream "a") '?x))) "explicit-stream arity")))
  (dolist (predicate '(put_char put_code))
    (let* ((stream (make-string-output-stream)) (*database* (make-database))
           (state (sprolog/src/adapters/adapter:iso-state-for *database*)) (value (if (eq predicate 'put_char) 'a 97)))
      (setf (sprolog/src/kernel/model:iso-state-output state) stream)
      (check (query (list (list predicate value))))
      (check (query (list (list predicate stream value))))
      (check (string= "aa" (get-output-stream-string stream)))))

  )

(defun run-builtin-arithmetic-tests ()
  (dolist (entry '(((+ 2) 2) ((- 2) -2) ((+ 2 3) 5) ((- 7 2) 5) ((* 2 3) 6)
                   ((/ 1 2) 0.5d0) ((// 7 2) 3) ((div -7 2) -4) ((rem -7 2) -1) ((mod -7 2) 1)
                   ((** 2 3) 8.0d0) ((^ 2 10) 1024) ((min 2 3) 2) ((max 2 3) 3)
                   ((abs -2) 2) ((sign -2) -1) ((float 2) 2.0d0)
                   ((float_integer_part -2.5d0) -2.0d0) ((float_fractional_part -2.5d0) -0.5d0)
                   ((floor -2.5d0) -3) ((ceiling -2.5d0) -2) ((truncate -2.5d0) -2) ((round -2.5d0) -3)
                   ((sin 0) 0.0d0) ((cos 0) 1.0d0) ((tan 0) 0.0d0) ((asin 0) 0.0d0) ((acos 1) 0.0d0)
                   ((atan 0) 0.0d0) ((atan2 0 1) 0.0d0) ((exp 0) 1.0d0) ((log 1) 0.0d0) ((sqrt 4) 2.0d0)
                   ((|\\| 1) -2) ((|/\\| 5 6) 4) ((|\\/| 5 6) 7) ((xor 5 6) 3) ((<< 2 3) 16) ((>> 16 3) 2)))
    (destructuring-bind (expression expected) entry
      (check (= expected (iso-value '?n (list (list 'is '?n expression)))) (format nil "arithmetic ~S" expression))))
  (check (< (abs (- pi (iso-value '?n '((is ?n pi))))) 1d-14))
  (check (iso-error-p '((is ?n (** -1 0.5d0))) "evaluation_error"))
  (check (iso-error-p '((is ?n (floor 2))) "type_error"))
  (check (iso-error-p '((is ?n (sin ?x))) "instantiation_error"))
  (let ((term 0))
    (dotimes (i 10000) (setf term (list '+ 1 term)))
    (check (= 10000 (iso-value '?n (list (list 'is '?n term)))) "deep arithmetic uses explicit stacks"))
  (check (iso-error-p '((atom_length a bad)) "type_error"))

  (check (iso-error-p '((atom_codes a ( bad))) "type_error"))

  )

(defun run-unification-spelling-tests ()
  (dolist (gc '(nil 1 8 4096))
    (check (query '((= ?x a) (= ?x ?y) (== ?x ?y)) :gc-threshold gc)
           "= binds and preserves variable aliases")
    (check (null (query '((= a b)) :gc-threshold gc)) "= mismatch")
    (check (query '((/= a b)) :gc-threshold gc) "/= tests nonunifiability")
    (check (null (query '((/= a a)) :gc-threshold gc)))
    (check (null (query '((/= ?x a)) :gc-threshold gc)) "/= is immediate, not a delayed constraint")
    (check (query '((/= ( f ?x ?x) ( f a b)) (var ?x)) :gc-threshold gc)
           "failed trial unification leaves no bindings")
    (check (query '((/= 1 1.0d0) (|=:=| 1 1.0d0)) :gc-threshold gc)
           "/= compares unifiability, not numeric values")
    (check (query '((/= (+ 1 1) 2)) :gc-threshold gc)
           "/= does not evaluate arithmetic expressions"))
  (<-- (alias-tail ?x) (= ?x a))
  (check (solutions (alias-tail a)))
  (check (solutions (call = ?x a) (== ?x a)) "meta-call =")
  (check (solutions (call /= a b)) "meta-call /=")
  (check (solutions (call /= ( f ?x ?x) ( f a b)) (var ?x)))
  (check (null (solutions (call /= ?x a))))
  (check (solutions (= ?x ( a  . ?x)) (ground ?x)) "= retains rational trees")
  (check (null (solutions (/= ?x ( a  . ?x)))) "/= uses rational-tree unifiability")
  (check (equal '(b) (mapcar (lambda (s) (value-of '?x s))
                            (solutions (|;| (|,| (= ?x a) fail) (= ?x b))))) "= rollback")

  (check (iso-error-p '((assertz (= a b))) "permission_error") "builtins cannot be overwritten")
  (check (iso-error-p '((assertz (/= a b))) "permission_error")))

(defun run-readable-spelling-tests ()
  (dolist (gc '(nil 1 8 4096))
    (check (query '((|\\+| (|,| ! fail))) :gc-threshold gc)
           "cut inside negated goal is opaque")
    (check (query '((and (= ?x a) (== ?x a))) :gc-threshold gc))
    (check (equal '(a b) (mapcar (lambda (s) (value-of '?x s))
                               (query '((or (= ?x a) (= ?x b))) :gc-threshold gc))))
    (check (query '((/+ fail)) :gc-threshold gc))
    (check (null (query '((/+ (= ?x a))) :gc-threshold gc)))
    (check (query '((/+ (and (= ?x a) fail)) (var ?x)) :gc-threshold gc))
    (check (query '((/== ?x ?y)) :gc-threshold gc))
    (check (null (query '((/== ?x ?x)) :gc-threshold gc)))
    (check (query '((=== (+ 1 2) 3.0d0) (=/= 1 2)) :gc-threshold gc))
    (check (null (query '((=/= 1 1.0d0)) :gc-threshold gc)))
    (check (query '((is ?x (logand 6 3)) (= ?x 2)
                   (is ?y (logior 6 3)) (= ?y 7)
                   (is ?z (lognot 0)) (= ?z -1)) :gc-threshold gc))
    (check (query '((call and (= ?x a) (== ?x a)) (call /+ fail)
                   (call /== a b) (call === 2 (+ 1 1)) (call =/= 1 2)) :gc-threshold gc))
    (check (= 2 (length (query '((call or (= ?x a) (= ?x b))) :gc-threshold gc))))
    (check (equal '(a) (mapcar (lambda (s) (value-of '?x s))
                              (query '((or (and (= ?x a) !) (= ?x b))) :gc-threshold gc))))
    (check (= 2 (length (query '((or (and (/+ (and ! fail)) (= ?x a)) (= ?x b)))
                                 :gc-threshold gc)))))
  (check (solutions (assertz (rule (readable-rule ?x) (and (= ?x a) (=== 1 1))))
             (readable-rule a)))
  (check (solutions (clause (readable-rule ?x) ?body) (call ?body) (== ?x a)))
  (check (solutions (retract (rule (readable-rule ?x) ?body)) (call ?body) (== ?x a)))
  (check (null (solutions (readable-rule a))))
  (check (iso-error-p '((assertz (=== 1 1))) "permission_error")))

(defun run-prolog-arrow-tests ()
  (check (null (macro-function '->)) "-> is no longer a DCG definition macro")
  (dolist (gc '(nil 1 8 4096))
    (check (equal '(a) (mapcar (lambda (s) (value-of '?x s))
                              (query '((-> (or (= ?x a) (= ?x b)) true)) :gc-threshold gc)))
           "condition commits to its first solution")
    (check (null (query '((-> fail true)) :gc-threshold gc)))
    (check (equal '(a b) (mapcar (lambda (s) (value-of '?x s))
                                (query '((-> true (or (= ?x a) (= ?x b)))) :gc-threshold gc)))
           "then preserves alternatives")
    (check (query '((or (-> fail (= ?x a)) (= ?x b)) (== ?x b)) :gc-threshold gc))
    (check (null (query '((or (-> true fail) true)) :gc-threshold gc))
           "then failure cannot enter else")
    (check (query '((call -> true (= ?x a)) (== ?x a)) :gc-threshold gc))
    (check (= 2 (length (query '((or (= ?y 1) (= ?y 2)) (-> true true)) :gc-threshold gc)))
           "condition commit preserves earlier choices"))
  (---> (arrow-dcg ?x) '(?x)
        (do (or (-> (=== ?x 1) (= ?kind one)) (= ?kind other))))
  (check (solutions (phrase (arrow-dcg 1) ( 1))))
  (check (solutions (phrase (arrow-dcg 2) ( 2)))))
