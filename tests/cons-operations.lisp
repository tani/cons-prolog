(uiop:define-package #:sprolog/tests/cons-operations
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/tests/tests #:check #:value-of)
  (:import-from #:sprolog/tests/builtins #:iso-error-p)
  (:export #:run-cons-operation-tests))
(in-package #:sprolog/tests/cons-operations)
(defun run-cons-operation-tests ()
  (let ((*database* (make-database)))
    (dolist (gc '(nil 1 8 4096))
      (dolist (goals '(((functor (f a b) cons 2) (arg 1 (f a b) f) (arg 2 (f a b) (a b)))
                       ((functor nil nil 0) (functor (f) cons 2))
                       ((functor ?x cons 2) (arg 1 ?x a) (arg 2 ?x b) (= ?x (a . b)))
                       ((=.. (f a b) (cons f (a b))))
                       ((=.. ?x (cons a b)) (= ?x (a . b)))
                       ((=.. nil (nil)))
                       ((= ?x (a . ?x)) (arg 2 ?x ?x) (functor ?x cons 2))
                       ((compare < 1 2) (@< 1 a) (@=< a a) (@>= (a) a) (@> (b) (a)))
                       ((compare = (a b) (a b)))
                       ((sort (3 1 2 1) (1 2 3)))
                       ((sort (?a ?a ?b) (?a ?b)))
                       ((keysort ((2 . b) (1 . a) (2 . c)) ((1 . a) (2 . b) (2 . c))))
                       ((op 500 xfy test_op) (current_op 500 xfy test_op) (op 0 xfy test_op) (/+ (current_op ?p ?s test_op)))
                       ((char_conversion a b) (current_char_conversion a b) (current_char_conversion c c))))
        (check (query goals :gc-threshold gc) "cons operations under GC")))
    (<-- (set-item b 3)) (<- (set-item b 1)) (<- (set-item b 3)) (<- (set-item a 2))
    (check (equal '((1 3) (2)) (mapcar (lambda (s) (value-of '?set s))
                        (query '((setof ?x (set-item ?key ?x) ?set))))) "setof groups and deduplicates")
    (check (query '((setof ?x (^ ?key (set-item ?key ?x)) (1 2 3)))))
    (check (null (query '((setof ?x fail ?set)))))
    (dolist (case '((((functor ?x f 2)) "domain_error")
                    (((arg -1 (a) ?x)) "domain_error")
                    (((arg ?n (a) ?x)) "instantiation_error")
                    (((=.. ?x ())) "domain_error")
                    (((sort (a . b) ?x)) "type_error")
                    (((= ?x (a . ?x)) (sort (?x) ?s)) "representation_error")
                    (((compare unknown a b)) "domain_error")
                    (((op 1201 xfy f)) "domain_error")
                    (((op 500 xyz f)) "domain_error")))
      (check (iso-error-p (first case) (second case))))
    (let ((input (make-string-input-stream "(f ?X ?X ? ?Y)")))
      (unwind-protect
           (check (query (list (list 'read_term input '?term '((variables ?vars) (variable_names ?names) (singletons ?single)))
                              '(= ?term (f ?x ?x ?anon ?y)) '(= ?vars (?x ?anon ?y))
                              (list '= '?single (list (cons (sprolog/src/adapters/term-ops:iso-atom "?Y") '?y)))
                              (list 'read input 'end_of_file))) "S-expression variables and EOF")
        (close input)))
    (let ((input (make-string-input-stream "#.(error)")))
      (unwind-protect (check (iso-error-p (list (list 'read input '?x)) "syntax_error")) (close input)))
    (let ((output (make-string-output-stream)))
      (check (query (list (list 'writeq output '(f ?x ?x)))) "writeq variables")
      (let ((input (make-string-input-stream (get-output-stream-string output))))
        (unwind-protect
             (check (query (list (list 'read input '?x) '(= ?x (f ?a ?a)))) "read/write roundtrip")
          (close input))) (close output))
    (let ((output (make-string-output-stream)))
      (check (query (list '(= ?x (f . ?x)) (list 'write_canonical output '?x))))
      (let ((input (make-string-input-stream (get-output-stream-string output))))
        (unwind-protect
             (check (query (list (list 'read input '?x) '(arg 2 ?x ?x))) "cyclic read/write roundtrip")
          (close input))) (close output))
    (check (query '((catch (read_term ?x ((bad true)))
                           (error ?kind (/ read_term 2)) true))) "public wrapper error context")
    (<-- (ordered-tabled ?x) (sort (3 1 3) ?x) (@< a (a)))
    (table 'ordered-tabled 1)
    (check (query '((ordered-tabled (1 3))) :gc-threshold 1) "ordering under SLG")
    (check (iso-error-p '((assertz (sort a b))) "permission_error"))
    (check (null (query '((op 400 xfx (left right)) (char_conversion x y) fail))) "state setup")
    (check (query '((current_op 400 xfx left) (current_char_conversion x y))) "state survives backtracking")
    (let ((*database* (make-database)))
      (check (null (query '((current_op ?p ?s left)))) "reader state is isolated")
      (check (query '((current_char_conversion x x)))))
    (clear-database)
    (check (query '((current_op 400 xfx left))) "clear retains reader state")
    (check (query '((current_char_conversion x y))))
    (dolist (term '(nil (a . b) (f ?x ?x) (cons a b)))
      (let ((output (make-string-output-stream)))
        (check (query (list (list 'writeq output term))))
        (let ((input (make-string-input-stream (get-output-stream-string output))))
          (unwind-protect (check (query (list (list 'read input term))) "native term roundtrip")
            (close input))) (close output)))
    (let ((output (make-string-output-stream)))
      (check (query (list (list 'write_term output '(?a ?b ?a)
                               (list '(quoted true) (list 'variable_names (list (cons (sprolog/src/adapters/term-ops:iso-atom "?G0") '?a))))))))
      (let ((input (make-string-input-stream (get-output-stream-string output))))
        (unwind-protect
             (check (query (list (list 'read input '(?a ?b ?a)) '(/== ?a ?b))) "writer variable names do not collide")
          (close input))) (close output))
    (let ((deep (loop repeat 20000 collect 'a)))
      (check (query (list (list 'compare '= deep (copy-list deep))) :gc-threshold 8) "deep comparison"))))
