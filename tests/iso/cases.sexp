(
 (:id "syntax.atom" :area "syntax" :goal "a = a." :expect :success :required t)
 (:id "syntax.quoted-atom" :area "syntax" :goal "'two words' = 'two words'." :expect :success)
 (:id "syntax.negative-integer" :area "syntax" :goal "X = -4, X < 0." :expect :success)
 (:id "syntax.compound" :area "syntax" :goal "f(a,b) = f(a,b)." :expect :success :required t)
 (:id "syntax.parentheses" :area "syntax" :goal "(a = a)." :expect :success)
 (:id "syntax.list" :area "syntax" :goal "[a,b,c] = [a|[b,c]]." :expect :success)
 (:id "syntax.list-tail" :area "syntax" :goal "[a,b|T] = [a,b,c], T = [c]." :expect :success)
 (:id "syntax.list-head-tail" :area "syntax" :goal "head_tail([a,b,c], a, [b,c])." :expect :success :required t)
 (:id "syntax.anonymous-variable" :area "syntax" :goal "f(_,_) = f(a,b)." :expect :success)
 (:id "syntax.comma" :area "syntax" :goal "a = a, b = b." :expect :success)
 (:id "syntax.disjunction" :area "syntax" :goal "a = b ; a = a." :expect :success)
 (:id "syntax.float" :area "syntax" :goal "float(1.5)." :expect :unsupported :reason "The .pl scanner currently tokenizes only integers")
 (:id "syntax.operator-declaration" :area "syntax" :goal "custom(a,b)." :expect :unsupported :reason "op/3 declarations and custom operator syntax are not supported")
 (:id "unification.reflexivity" :area "unification" :goal "X = X." :expect :success :required t)
 (:id "unification.distinct-atoms" :area "unification" :goal "a = b." :expect :failure :required t)
 (:id "unification.repeated-variable" :area "unification" :goal "same(a,a)." :expect :success)
 (:id "unification.repeated-variable-failure" :area "unification" :goal "same(a,b)." :expect :failure)
 (:id "unification.nested" :area "unification" :goal "f(g(X),X) = f(g(a),a)." :expect :success)
 (:id "unification.fail-rollback" :area "unification" :goal "(X = a, X = b) ; X = c." :expect :success)
 (:id "unification.nonunifiability" :area "unification" :goal "a \\= b." :expect :success)
 (:id "unification.nonunifiability-fail" :area "unification" :goal "a \\= a." :expect :failure)
 (:id "unification.occurs-check" :area "unification" :goal "unify_with_occurs_check(X,f(X))." :expect :failure)
 (:id "control.true" :area "control" :goal "true." :expect :success :required t)
 (:id "control.fail" :area "control" :goal "fail." :expect :failure :required t)
 (:id "control.conjunction" :area "control" :goal "true, true." :expect :success)
 (:id "control.disjunction-count" :area "control" :goal "X = a ; X = b." :expect (:count 2))
 (:id "control.disjunction-fail" :area "control" :goal "fail ; fail." :expect :failure)
 (:id "control.once" :area "control" :goal "once(pick(X))." :expect (:count 1))
 (:id "control.cut" :area "control" :goal "commit(X)." :expect (:count 1))
 (:id "control.cut-goal" :area "control" :goal "cut_choice(X)." :expect (:count 1))
 (:id "control.negation-success" :area "control" :goal "\\+ (a = b)." :expect :success)
 (:id "control.negation-failure" :area "control" :goal "\\+ (a = a)." :expect :failure)
 (:id "control.meta-call" :area "control" :goal "call(pick(red))." :expect :success)
 (:id "control.if-then-else" :area "control" :goal "(true -> X = 1 ; X = 2), X = 1." :expect :success)
 (:id "control.catch-throw" :area "control" :goal "catch(throw(ball), ball, true)." :expect :success)
 (:id "control.nontermination" :area "control" :goal "repeat." :expect :unsupported :reason "Infinite answer spaces need a per-case watchdog for portable test execution")
 (:id "clauses.fact" :area "clauses" :goal "edge(a,b)." :expect :success :required t)
 (:id "clauses.fact-failure" :area "clauses" :goal "edge(a,d)." :expect :failure)
 (:id "clauses.fact-count" :area "clauses" :goal "edge(X,Y)." :expect (:count 3))
 (:id "clauses.recursion" :area "clauses" :goal "path(a,d)." :expect :success)
 (:id "clauses.recursion-count" :area "clauses" :goal "path(a,Y)." :expect (:count 3))
 (:id "clauses.choice-count" :area "clauses" :goal "pick(X)." :expect (:count 3))
 (:id "clauses.distinct" :area "clauses" :goal "different(a,b)." :expect :success)
 (:id "clauses.distinct-failure" :area "clauses" :goal "different(a,a)." :expect :failure)
 (:id "arithmetic.is" :area "arithmetic" :goal "sum_seven(7)." :expect :success)
 (:id "arithmetic.precedence" :area "arithmetic" :goal "X is 1 + 2 * 3, X = 7." :expect :success :required t)
 (:id "arithmetic.add" :area "arithmetic" :goal "X is 2 + 5, X = 7." :expect :success)
 (:id "arithmetic.int-division" :area "arithmetic" :goal "X is -7 // 3, X = -2." :expect :success)
 (:id "arithmetic.equal" :area "arithmetic" :goal "3 =:= 1 + 2." :expect :success)
 (:id "arithmetic.not-equal" :area "arithmetic" :goal "2 =\\= 3." :expect :success)
 (:id "arithmetic.lt" :area "arithmetic" :goal "1 < 2." :expect :success)
 (:id "arithmetic.lte" :area "arithmetic" :goal "2 =< 2." :expect :success)
 (:id "arithmetic.gte" :area "arithmetic" :goal "3 >= 2." :expect :success)
 (:id "types.atom" :area "types" :goal "atom(a)." :expect :success)
 (:id "types.integer" :area "types" :goal "integer(3)." :expect :success)
 (:id "types.var" :area "types" :goal "var(X)." :expect :success)
 (:id "types.nonvar" :area "types" :goal "nonvar(a)." :expect :success)
 (:id "types.compound" :area "types" :goal "compound(f(a))." :expect :success)
 (:id "types.ground" :area "types" :goal "ground(f(a,b))." :expect :success)
 (:id "types.not-ground" :area "types" :goal "ground(f(X))." :expect :failure)
 (:id "types.atomic" :area "types" :goal "atomic(3)." :expect :success)
 (:id "exceptions.instantiation" :area "exceptions" :goal "X is Y." :expect (:error "instantiation_error"))
 (:id "exceptions.division-by-zero" :area "exceptions" :goal "X is 1 / 0." :expect (:error "evaluation_error"))
 (:id "exceptions.call-noncallable" :area "exceptions" :goal "call(42)." :expect (:error "type_error"))
 (:id "exceptions.unknown-predicate" :area "exceptions" :goal "never_declared(a)." :expect (:error "existence_error"))
 (:id "exceptions.static-predicate" :area "exceptions" :goal "assertz(integer(a))." :expect (:error "permission_error"))
 (:id "dcg.word" :area "dcg" :goal "phrase(color(red), [red])." :expect :success)
 (:id "dcg.word-fail" :area "dcg" :goal "phrase(color(red), [blue])." :expect :failure)
 (:id "dcg.sentence" :area "dcg" :goal "phrase(sentence(red), [red])." :expect :success)
 (:id "dcg.nonstandard" :area "dcg" :goal "phrase(sentence(X), [blue])." :expect :success)
 (:id "io.current-input" :area "io" :goal "current_input(Stream)." :expect :success)
 (:id "io.term-reading" :area "io" :goal "read_term(X, [])." :expect :unsupported :reason "Depends on a controlled input stream fixture; not yet wired")
 (:id "io.term-writing" :area "io" :goal "writeq(f(a))." :expect :unsupported :reason "Requires stream capture and canonical ISO read/write comparison")
 (:id "syntax.char-conversion" :area "syntax" :goal "char_conversion(a,b)." :expect :unsupported :reason "Character conversion is not provided by this loader")
)
