;;; Execute the checked-in plain Prolog port. No importer or external runtime.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(uiop:define-package #:sprolog/iso-test-worker
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom #:iso-atom-name))
(in-package #:sprolog/iso-test-worker)
(defun object (&rest pairs)
  (let ((table (make-hash-table :test 'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key table) value)) table))
(defun json-string (value stream)
  (write-char #\" stream)
  (loop for c across value for code = (char-code c) do
    (case c (#\" (write-string "\\\"" stream)) (#\\ (write-string "\\\\" stream))
      (otherwise (if (< code 32) (format stream "\\u~4,'0X" code) (write-char c stream)))))
  (write-char #\" stream))
(defun json (value stream)
  (typecase value
    (hash-table (write-char #\{ stream)
      (let ((first t)) (maphash (lambda (k v) (unless first (write-char #\, stream)) (setf first nil)
                                (json-string k stream) (write-char #\: stream) (json v stream)) value))
      (write-char #\} stream))
    (string (json-string value stream))
    (vector (write-char #\[ stream)
      (loop for v across value for i from 0 do (when (plusp i) (write-char #\, stream)) (json v stream))
      (write-char #\] stream))
    (number (princ value stream))
    (null (write-string "null" stream))
    (t (error "Not a JSON value: ~S" value))))
(defun write-json (path value)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (json value out) (terpri out)))
(defun printable (term)
  (let ((*print-circle* t) (*print-pretty* nil) (*print-length* 100) (*print-level* 40))
    (write-to-string term :readably nil)))

(defun read-job (path)
  (with-open-file (in path) (let ((*read-eval* nil)) (read in))))
(defun run-job (job)
  (let* ((*database* (make-database))
         (*standard-input* (make-string-input-stream ""))
         (*standard-output* (make-string-output-stream))
         (*package* (find-package :sprolog/iso-test-worker))
         (stage "LOAD") (outcome nil))
    (handler-case
        (progn
          (query '((set_prolog_flag read_syntax prolog) (set_prolog_flag write_syntax prolog)))
          (load-prolog-file (getf job :harness))
          (load-prolog-file (getf job :program))
          (<-- (conf_report ?value) (lisp (setf outcome ?value)))
          (setf stage "SETUP")
          (when (query '((current_predicate (/ conf_suite_setup 0))))
            (unless (query '((conf_suite_setup)) :limit 1) (error "Suite setup failed")))
          (dolist (previous (getf job :predecessors))
            (setf outcome nil)
            (query (list (list 'conf_execute (iso-atom previous) '?result) '(conf_report ?result)) :limit 1)
            (unless (and (symbolp outcome) (string= (iso-atom-name outcome) "pass"))
              (error "Predecessor failed: ~A: ~A" previous (printable outcome))))
          (setf stage "RUN" outcome nil)
          (write-json "started.json" (object "id" (getf job :id)))
          (let ((answers (query (list (list 'conf_execute (iso-atom (getf job :id)) '?result)
                                     '(conf_report ?result)) :limit 1)))
            (unless answers (setf outcome 'check_failed)))
          (setf stage "CLEANUP")
          (when (query '((current_predicate (/ conf_suite_cleanup 0))))
            (unless (query '((conf_suite_cleanup)) :limit 1) (error "Suite cleanup failed")))
          (let ((name (and (symbolp outcome) (iso-atom-name outcome))))
            (cond ((equal name "pass") (object "status" "PASS" "observation" "(:OBSERVED PASS)"))
                  ((equal name "skipped_condition")
                   (object "status" "SKIP" "observation" "Runtime applicability condition is false"))
                  (t (object "status" "FAIL" "observation" (printable (list :observed outcome)))))))
      (iso-exception (e) (object "status" "FAIL" "stage" stage
                                "observation" (printable (list stage :prolog-error (iso-exception-term e)))))
      (error (e) (object "status" "FAIL" "stage" stage
                        "observation" (format nil "~A HOST_ERROR: ~A" stage e))))))
(let ((args (uiop:command-line-arguments)))
  (when args (write-json (second args) (run-job (read-job (first args))))))
