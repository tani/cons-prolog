;;; Native reader/compiler only: no Logtalk, SWI-Prolog or third-party test runtime.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(uiop:define-package #:sprolog/iso-test-worker
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/src/prolog/lexer #:make-lexer #:peek-token #:lexer-token-line)
  (:import-from #:sprolog/src/prolog/reader #:read-prolog-term)
  (:import-from #:sprolog/src/prolog/writer #:write-prolog-term)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom #:iso-atom-name)
  (:import-from #:sprolog/src/kernel/engine #:map-term)
  (:import-from #:sprolog/src/kernel/model #:%make-var #:logic-var-binding)
  (:import-from #:sprolog/src/kernel/runtime #:iso-goal)
  (:import-from #:sprolog/src/syntax/compiler #:variable-symbol-p #:add-clause))
(in-package #:sprolog/iso-test-worker)

(defun object (&rest pairs)
  (let ((table (make-hash-table :test 'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key table) value)) table))
(defun json-string (value stream)
  (write-char #\" stream)
  (loop for c across value for code = (char-code c) do
    (case c (#\" (write-string "\\\"" stream)) (#\\ (write-string "\\\\" stream))
      (otherwise (if (< code 32) (format stream "\\u~4,'0X" code) (write-char c stream)))))
  (write-char #\" stream))
(defun json (value stream)
  (typecase value
    (hash-table (write-char #\{ stream)
      (let ((first t)) (maphash (lambda (k v) (unless first (write-char #\, stream)) (setf first nil)
                                (json-string k stream) (write-char #\: stream) (json v stream)) value))
      (write-char #\} stream))
    (string (json-string value stream))
    (vector (write-char #\[ stream)
      (loop for v across value for i from 0 do (when (plusp i) (write-char #\, stream)) (json v stream))
      (write-char #\] stream))
    (number (princ value stream))
    (null (write-string "null" stream))
    (t (error "Not a JSON value: ~S" value))))
(defun write-json (path value)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (json value out) (terpri out)))
(defun named (term name &optional arity)
  (and (consp term) (symbolp (car term))
       (string-equal (symbol-name (car term)) name)
       (or (null arity) (= (length (cdr term)) arity))))
(defun printable (term)
  (let ((*print-circle* t) (*print-pretty* nil) (*print-length* 100) (*print-level* 40))
    (write-to-string term :readably nil)))
(defun source-text (term)
  (let ((vars (make-hash-table :test 'eq)))
    (with-output-to-string (out)
      (write-prolog-term out
        (map-term term (lambda (x)
                        (if (variable-symbol-p x)
                            (or (gethash x vars)
                                (let ((v (%make-var (hash-table-count vars))))
                                  (setf (logic-var-binding v) v (gethash x vars) v))) x)))
        *database* :quoted t :ignore-ops t))))
(defun read-source (path)
  (with-open-file (in path :external-format :utf-8)
    (let ((lexer (make-lexer :stream in :source (namestring path))) (rows nil))
      (loop
        (peek-token lexer)
        (let ((line (lexer-token-line lexer)))
          (multiple-value-bind (term present) (read-prolog-term in :lexer lexer)
            (unless present (return))
            (push (list line term) rows)
            (when (and (named term ":-" 1) (named (second term) "OP" 3))
              (query (list (second term)))))))
      (nreverse rows))))
(defun write-forms (path forms)
  (with-open-file (out path :direction :output :if-exists :supersede)
    (let ((*print-circle* t) (*print-readably* t) (*print-pretty* nil)) (write forms :stream out))))
(defun read-forms (path)
  (with-open-file (in path) (let ((*read-eval* nil)) (read in))))
(defun formal-error-p (value)
  (let ((name (if (consp value) (car value) value)))
    (and (symbolp name)
         (member (iso-atom-name name)
                 '("instantiation_error" "type_error" "domain_error" "existence_error"
                   "permission_error" "representation_error" "evaluation_error"
                   "resource_error" "syntax_error" "system_error" "unexpected_ball") :test #'string=))))
(defun adapt-inria (form)
  ;; Error recognition is a harness operation, not a call under test. UNIV on
  ;; arbitrary lists assumes ISO list-cell functors and cannot serve this role
  ;; with sprolog's native finite applications.
  (if (and (named form ":-" 2)
           (or (named (second form) "SPECIAL_ANS_FORMS" 2)
               (named (second form) "MAKE_SUBS_LIST1" 3))
           (named (third form) "," 2) (named (second (third form)) "=.." 2))
      (let ((head (second form)) (value (second (second (third form)))))
        (list (car form) head (list '|,| (list 'suite_error_form value) '!)))
      form))

(defvar *cases* nil)
(defun vanilla-forms (path relative)
  (let ((forms nil) (ordinal 0))
    (dolist (row (read-source path))
      (destructuring-bind (line term) row
        (incf ordinal)
        ;; Alpha-rename a private helper that collides with sprolog's protected AND/2.
        (when (string= relative "sec74.pl")
          (setf term (map-term term (lambda (x) (if (eq x 'and) 'hodgson_and x)))))
        (if (named term ":-" 2)
            (let ((head (second term)) (check-index 0))
              (labels ((lower (goal)
                         (cond
                           ((and (consp goal) (symbolp (car goal))
                                 (member (string-downcase (symbol-name (car goal)))
                                         '("test_true" "test_false" "test_val" "error_test") :test #'string=))
                            (incf check-index)
                            (let* ((id (format nil "examples/~A:~D:~D" relative ordinal check-index))
                                   (parent (if (consp head) (car head) head))
                                   (entry (if (and (string= relative "sec89.pl")
                                                   (not (member parent '(verify_assertas verify_assertzs))))
                                              'test_89 parent))
                                   (case (object "id" id "suite" "examples" "source" relative "line" line
                                                 "kind" (string-downcase (symbol-name (car goal)))
                                                 "entry" (string-downcase (symbol-name entry))
                                                 "goal" (source-text goal))))
                              (push case *cases*)
                              (list 'suite_check (iso-atom id) goal)))
                           ((and (consp goal) (symbolp (car goal))
                                 (member (symbol-name (car goal)) '("|,|" "," ";" "->") :test #'string=))
                            (list (car goal) (lower (second goal)) (lower (third goal))))
                           ((or (named goal "\\+" 1) (named goal "ONCE" 1) (named goal "CALL" 1))
                            (list (car goal) (lower (second goal))))
                           ((named goal "CATCH" 3) (list (car goal) (lower (second goal)) (third goal) (lower (fourth goal))))
                           (t goal))))
                (push (list (car term) head (lower (third term))) forms)))
            (push term forms))))
    (nreverse forms)))
(defun inventory (root output)
  (ensure-directories-exist (merge-pathnames "programs/" output))
  (let ((*cases* nil) (*database* (make-database)))
    (let* ((directory (merge-pathnames "inriasuite/inriasuite/" root))
           (driver (read-source (merge-pathnames "inriasuite.pl" directory)))
           (forms (mapcar (lambda (row) (adapt-inria (second row))) driver))
           (files (loop for term in forms when (named term "FILE" 1) collect (iso-atom-name (second term)))))
      (let ((prefix (mapcar #'second
                           (with-input-from-string (in
                             "compare_subst_lists(F,S,Extra,Missing) :- (suite_error_form(F);suite_error_form(S)),!, (F=S -> Extra=[],Missing=[];Extra=F,Missing=S).")
                             (loop for term = (read-prolog-term in) while term collect (list 0 term))))))
        (write-forms (merge-pathnames "programs/inria.sexp" output) (append prefix forms)))
      (dolist (file files)
        (loop for row in (read-source (merge-pathnames file directory)) for ordinal from 1 do
          (destructuring-bind (line term) row
            (unless (member (length term) '(2 3)) (error "Malformed INRIA case: ~A" file))
            (let ((id (format nil "inria/~A:~D" file ordinal)))
              (push (object "id" id "suite" "inria" "source" file "line" line
                            "kind" "substitutions" "entry" "result" "goal" (source-text term)
                            "program" "inria.sexp" "ordinal" ordinal) *cases*))))))
    (let* ((directory (merge-pathnames "prologsuite/vanilla/" root))
           (common (append (mapcar #'second (read-source (merge-pathnames "utils_so.pl" directory)))
                           (mapcar #'second (read-source (merge-pathnames "db.pl" directory))))))
      (dolist (path (sort (directory (merge-pathnames "sec*.pl" directory)) #'string< :key #'namestring))
        (let* ((name (file-namestring path)) (before *cases*) (forms (vanilla-forms path name)))
          (loop for cases on *cases* until (eq cases before) do
            (setf (gethash "program" (car cases)) (concatenate 'string name ".sexp")))
          (write-forms (merge-pathnames (concatenate 'string "programs/" name ".sexp") output)
                       (append common forms)))))
    (write-json (merge-pathnames "cases.json" output) (coerce (nreverse *cases*) 'vector))))

(defvar *selected* nil)
(defvar *active* nil)
(defvar *started* nil)
(defvar *outcome* nil)
(defvar *loading* nil)
(defvar *executed-goal* nil)
(defvar *job-root* nil)
(defvar *fixture-directory* nil)
(defvar *loaded* nil)
(defvar *initializations* nil)
(defun observed (outcome)
  (let ((pass (and (symbolp outcome) (string-equal (symbol-name outcome) "PASS"))))
    (object "status" (if pass "PASS" "FAIL") "executed_goal" *executed-goal*
            "observation" (if pass "(:OBSERVED PASS)" (printable (list :observed outcome))))))
(defun install-hooks ()
  (<-- (suite_check ?id ?goal)
    (lisp (progn
            (setf *active* (and (not *loading*) (string= (iso-atom-name ?id) *selected*)))
            (when *active* (setf *started* t *outcome* nil)
                  (write-json (merge-pathnames "started.json" *job-root*) (object "id" *selected*)))))
    (call ?goal)
    (lisp (when *active* (throw 'finished (observed *outcome*)))))
  (<-- (suite_result ?outcome) (lisp (when *active* (setf *outcome* ?outcome))))
  ;; Log messages are diagnostics, never the result protocol. The original suite
  ;; also calls LOG inside tested goals; these calls must not imply failure.
  (<-- (log ?text) (true))
  (<-- (log_nl) (true))
  (<-- (suite_error_form ?value) (lispp (formal-error-p ?value)))
  ;; The initialization directive misspells the existing GO_74 helper.
  (<-- (go7_4) (go_74))
  (load-prolog-string
    "append([],Y,Y). append([X|Xs],Y,[X|Zs]) :- append(Xs,Y,Zs).
     member(X,[X|_]). member(X,[_|Xs]) :- member(X,Xs).
     length([],0). length([_|Xs],N) :- length(Xs,M),N is M+1.
     test_true(G) :- copy_term(G,C), catch((call(C) -> suite_result(pass);suite_result(unexpected_failure)), E, suite_result(exception(E))).
     test_false(G) :- copy_term(G,C), catch((call(C) -> suite_result(unexpected_success);suite_result(pass)), E, suite_result(exception(E))).
     test_val(G,A,Expected) :- copy_term(G/A,C/V), catch((call(C) -> (V=Expected -> suite_result(pass);suite_result(wrong_value(Expected,V)));suite_result(unexpected_failure)), E, suite_result(exception(E))).
     error_test(G,Expected) :- copy_term(G,C), copy_term(Expected,Pattern), catch(catch((call(C) -> suite_result(missing_error);suite_result(missing_error)), error(Pattern,_), suite_result(pass)), E, suite_result(wrong_error(Expected,E)))."))
(defun directive (goal)
  (cond
    ((or (named goal "INCLUDE" 1) (named goal "ENSURE_LOADED" 1))
     (let* ((name (iso-atom-name (second goal)))
            (path (merge-pathnames name *fixture-directory*)))
       (unless (probe-file path) (setf path (merge-pathnames (concatenate 'string name ".pl") *fixture-directory*)))
       (when (or (named goal "INCLUDE" 1) (not (gethash (namestring path) *loaded*)))
         (setf (gethash (namestring path) *loaded*) t)
         (load-forms (mapcar #'second (read-source path))))))
    ((named goal "INITIALIZATION" 1) (push (second goal) *initializations*))
    (t (load-prolog-string (concatenate 'string ":- " (source-text goal) ". ")))))
(defun load-forms (forms)
  (dolist (term forms)
    (cond ((named term ":-" 1) (directive (second term)))
          (t (let* ((head (if (named term ":-" 2) (second term) term))
                    (body (and (named term ":-" 2) (third term))))
               (add-clause (iso-goal head) (and body (list (if (variable-symbol-p body) body (iso-goal body)))) nil *database*))))))
(defun execute-job (job)
  (let* ((*selected* (getf job :id)) (*active* nil) (*started* nil) (*outcome* nil) (*executed-goal* nil)
         (*loading* t) (*job-root* *default-pathname-defaults*)
         (*fixture-directory* *job-root*)
         (*loaded* (make-hash-table :test 'equal)) (*initializations* nil)
         (*database* (make-database)) (*standard-input* (make-string-input-stream ""))
         (*standard-output* (make-string-output-stream)) (stage "LOAD"))
    (handler-case
        (catch 'finished
          (query '((set_prolog_flag read_syntax prolog) (set_prolog_flag write_syntax prolog)))
          (setf (gethash (namestring (merge-pathnames "utils_so.pl" *fixture-directory*)) *loaded*) t)
          (load-forms (read-forms (getf job :program)))
          (install-hooks)
          (dolist (goal (reverse *initializations*)) (query (list (iso-goal goal)) :limit 1))
          (setf stage "SETUP" *loading* nil)
          (cond
            ((string= (getf job :suite) "inria")
             (when (and (member *selected* '("inria/abolish:4" "inria/functor:17") :test #'string=)
                        (query '((current_prolog_flag max_arity unbounded))))
               (throw 'finished (object "status" "SKIP" "observation" "Requires a finite max_arity; this implementation has unbounded arity")))
             (when (and (member *selected* '("inria/atom_codes:11" "inria/number_codes:14") :test #'string=)
                        (query '((char_code ?char 1000))))
               (throw 'finished (object "status" "SKIP" "observation" "Assumes character code 1000 is unavailable; sprolog supports Unicode scalar values")))
             ;; Original READ happens between tests, so previous flag changes affect
             ;; subsequent double-quoted data. Replay the file prefix in this worker.
             (with-open-file (in (merge-pathnames (getf job :source) *fixture-directory*) :external-format :utf-8)
               (loop for n from 1 to (parse-integer (getf job :ordinal)) do
                 (let* ((data (read-prolog-term in)) (goal (first data)) (expected (car (last data)))
                        (a (make-symbol "?ACTUAL")) (extra (make-symbol "?EXTRA")) (missing (make-symbol "?MISSING")))
                   (when (= (length data) 3)
                     (let ((file (merge-pathnames (iso-atom-name (second data)) *fixture-directory*)))
                       (load-forms (mapcar #'second (read-source file)))))
                   (if (< n (parse-integer (getf job :ordinal)))
                       (query (list '(reset_flags) (list 'result goal a)) :limit 1)
                       (progn
                         (setf *started* t stage "RUN" *executed-goal* (source-text data))
                         (write-json (merge-pathnames "started.json" *job-root*) (object "id" *selected*))
                         (<-- (suite_substitutions ?actual ?expected ?extra ?missing)
                           (lisp (throw 'finished
                                   (if (and (null ?extra) (null ?missing)) (observed 'pass)
                                       (observed (list 'substitutions ?expected ?actual ?extra ?missing))))))
                         (query (list '(reset_flags) (list 'result goal a) (list 'compare_subst_lists a expected extra missing)
                                      (list 'suite_substitutions a expected extra missing)) :limit 1)
                         (throw 'finished (object "status" "FAIL" "observation" "INRIA_CHECK_FAILED")))))))
             (object "status" "FAIL" "observation" "INRIA_CASE_NOT_READ"))
            (t
             (when (and (string= *selected* "examples/sec816.pl:17:3") (query '((char_code ?char 9999))))
               (throw 'finished (object "status" "SKIP" "observation" "Assumes character code 9999 is unavailable; sprolog supports Unicode scalar values")))
             (when (string= (getf job :source) "sec92.pl")
               (unless (query '((current_prolog_flag bounded true)))
                 (throw 'finished (object "status" "SKIP" "observation" "Requires bounded integers; this implementation has unbounded integers"))))
             (setf stage "RUN")
             (when (member (getf job :entry) '("verify_assertas" "verify_assertzs") :test #'string=)
               (query (list (list (if (string= (getf job :entry) "verify_assertas") 'test_asserta 'test_assertz))) :limit 1))
             (query (list (list (intern (string-upcase (getf job :entry)) *package*))) :limit 1)
             (object "status" "FAIL" "observation" (if *started* "MISSING_CHECK_RESULT" "CHECK_NOT_REACHED")))))
      (iso-exception (e) (object "status" (if *started* "FAIL" "BLOCKED")
                                "observation" (printable (list stage :prolog-error (iso-exception-term e)))))
      (error (e) (object "status" (if *started* "FAIL" "BLOCKED")
                        "observation" (format nil "~A HOST_ERROR: ~A" stage e))))))

(let ((*package* (find-package :sprolog/iso-test-worker)) (args (uiop:command-line-arguments)))
  (cond ((null args) nil)
        ((string= (first args) "inventory")
         (inventory (uiop:ensure-directory-pathname (second args)) (uiop:ensure-directory-pathname (third args))))
        ((string= (first args) "run") (write-json (third args) (execute-job (read-forms (second args)))))
        (t (error "Unknown worker mode"))))
