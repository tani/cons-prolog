;;; One fresh SBCL process per case; the parent enforces a wall-clock timeout.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")
(unless (uiop:command-line-arguments) (uiop:quit 0))
(uiop:define-package #:sprolog/iso-test-worker
  (:use #:cl #:sprolog)
  (:import-from #:sprolog/src/adapters/term-ops #:iso-atom-name #:iso-atomic-equal))
(in-package #:sprolog/iso-test-worker)

(defvar *input-streams* nil)
(defun approximately-equal-p (a b)
  ;; lgtunit's fallback epsilon for other backends is 1e-12.
  (cond ((and (numberp a) (numberp b))
         (or (< (abs (- a b)) 1d-10)
             (< (abs (- a b)) (* 0.00001d0 (max (abs a) (abs b))))))
        ((and (consp a) (consp b))
         (and (approximately-equal-p (car a) (car b)) (approximately-equal-p (cdr a) (cdr b))))
        ((and (null a) (null b)) t)))
(defun exported-variable-p (x)
  (and (symbolp x) (null (symbol-package x))
       (plusp (length (symbol-name x))) (char= (char (symbol-name x) 0) #\?)))
(defun variant-p (a b)
  (let ((forward (make-hash-table :test 'eq)) (backward (make-hash-table :test 'eq))
        (seen (make-hash-table :test 'eq)) (work (list (cons a b))))
    (loop while work do
      (let* ((pair (pop work)) (a (car pair)) (b (cdr pair)))
        (cond ((or (exported-variable-p a) (exported-variable-p b))
               (unless (and (exported-variable-p a) (exported-variable-p b)
                            (eq (gethash a forward b) b) (eq (gethash b backward a) a))
                 (return-from variant-p nil))
               (setf (gethash a forward) b (gethash b backward) a))
              ((and (consp a) (consp b))
               (let ((partners (or (gethash a seen)
                                   (setf (gethash a seen) (make-hash-table :test 'eq)))))
                 (unless (gethash b partners)
                   (setf (gethash b partners) t)
                   (push (cons (cdr a) (cdr b)) work) (push (cons (car a) (car b)) work))))
              ((not (iso-atomic-equal a b)) (return-from variant-p nil))))) t))
(defun fixture-text (term)
  (cond ((symbolp term) (iso-atom-name term))
        ((stringp term) term)
        ((listp term) (if (every #'integerp term) (map 'string #'code-char term)
                          (format nil "~{~A~}" (mapcar #'fixture-text term))))
        (t (error "Unsupported lgtunit text fixture: ~S" term))))

(let* ((args (uiop:command-line-arguments))
       (job (with-open-file (s (first args))
              (let ((*read-eval* nil)) (read s))))
       (*package* (find-package :sprolog/iso-test-worker))
       (*standard-input* (make-string-input-stream ""))
       (*standard-output* (make-string-output-stream))
       (*database* (make-database))
       (*iso-halt-function* (lambda (status) (error "Test attempted halt(~A)" status)))
       (stage :load) (result nil))
  (unwind-protect
       (handler-case
           (progn
             (<-- (iso_test_result ?result) (lisp (setf result ?result)))
             (<-- (iso_test_variant ?a ?b) (lispp (variant-p ?a ?b)))
             (<-- (iso_test_approximately_equal ?a ?b) (lispp (approximately-equal-p ?a ?b)))
             (<-- (forall ?a ?b) (/+ (and (call ?a) (/+ (call ?b)))))
             (<-- (iso_test_set_text_input ?text)
               (lisp ?stream (let ((s (make-string-input-stream (fixture-text ?text))))
                               (push s *input-streams*) s))
               (set_input ?stream))
             (load-prolog-string
              "iso_test_error_member(error(F,_),[F|_]). iso_test_error_member(E,[_|Fs]) :- iso_test_error_member(E,Fs).
               iso_test_assertion(G) :- (call(G) -> true ; throw(iso_test_assertion_failed)).")
             (query '((set_prolog_flag read_syntax prolog)))
             (load-prolog-string (getf job :program))
             (setf stage :setup)
             (dolist (setup (getf job :setup))
               (setf result nil)
               (query (list (first (parse-prolog-string setup))) :limit 1)
               (unless (eq result 'pass) (error "Fixture predecessor failed: ~S" result)))
             (setf result nil)
             (setf stage :parse)
             (let ((goal (first (parse-prolog-string (getf job :query)))))
               (setf stage :run)
               (unless (query (list goal) :limit 1) (setf result :no-protocol-result)))
             (setf result (list :observed result)))
         (iso-exception (c) (setf result (list stage :prolog-error (iso-exception-term c))))
         (error (c) (setf result (list stage :host-error (princ-to-string c)))))
    (dolist (s *input-streams*) (ignore-errors (close s))))
  (with-open-file (s (second args) :direction :output :if-exists :supersede)
    (let ((*print-circle* t) (*print-length* 100) (*print-level* 30) (*print-pretty* nil))
      (write result :stream s :readably nil))))
