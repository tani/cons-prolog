;;; Verify ISO meta-control semantics and cut effects under native WAM.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog/iso")

(defpackage #:sprolog/iso/controls-test (:use #:cl))
(in-package #:sprolog/iso/controls-test)

(defvar *checks* 0)
(defun check (value description)
  (incf *checks*)
  (unless value (error "FAILED: ~A" description)))
(defun results (runtime expression &optional limit)
  (sprolog/iso:query expression :runtime runtime :limit limit))
(defun binding (solution name)
  (cdr (find name solution :key (lambda (x) (symbol-name (car x))) :test #'string=)))
(defun values-of (runtime expression name)
  (mapcar (lambda (solution)
            (let ((value (binding solution name)))
              (cond ((or (sprolog/iso:atom-p value)
                         (sprolog/iso:compound-p value))
                     (sprolog/iso:term-functor value))
                    (t value))))
          (results runtime expression)))
(defun rejected (runtime expression)
  (handler-case (progn (results runtime expression) nil)
    (sprolog/iso:unsupported-iso-goal () t)))

(defun main ()
  (let ((db (sprolog/iso:make-runtime)))
    (sprolog/iso:consult (merge-pathnames "controls.pl" *load-truename*)
                         :runtime db)
    (check (equal (values-of db "prefix(X)." "?X") '("a" "b" "c"))
           "ordinary clauses retain source order")
    (check (equal (values-of db "without_cut(X)." "?X")
                  '("a" "b" "c" "fallback"))
           "normal multi-clause backtracking")
    (check (equal (values-of db "stop(X)." "?X") '("a"))
           "cut commits to the first prefix solution and removes later clauses")
    (check (null (results db "cut_then_fail(X)."))
           "failure after cut cannot fall back to later clauses")
    (check (equal (values-of db "cut_after_guard(X)." "?X") '("a"))
           "cut prunes later clauses even if guard itself succeeds")
    (check (equal (values-of db "double_cut(X)." "?X") '("a"))
           "multiple cuts in one conjunction")
    (check (equal (values-of db "before_cut(X)." "?X") '("previous" "a"))
           "cut does not retract answers from earlier clauses")
    (check (equal (values-of db "after_cut(X)." "?X") '("a" "fallback"))
           "cut in callee never prunes caller clause alternatives")
    (check (equal (values-of db "disjunction_cut(X)." "?X") '("a"))
           "cut commits to first solution of preceding disjunction")
    (check (equal (values-of db "once_pick(X)." "?X") '("a"))
           "once/1 is opaque and commits only locally")
    (check (equal (values-of db "call_pick(X)." "?X") '("a" "b" "c"))
           "call/1 remains nondeterministic")
    (check (results db "not_pick(z).") "negation-as-failure succeeds when goal fails")
    (check (null (results db "not_pick(a).")) "negation-as-failure fails when goal succeeds")
    (check (equal (values-of db "choose(X)." "?X") '("a" "c"))
           "if-then-else commits condition but does not prune a later clause")
    (check (equal (values-of db "cut_after_then(X)." "?X") '("a"))
           "a cut before a conditional prunes later clauses")
    (check (equal (values-of db "X = a ; X = b." "?X") '("a" "b"))
           "ordinary top-level disjunction")
    (check (equal (values-of db "X = a -> X = a ; X = b." "?X") '("a"))
           "top-level if-then-else")
    (check (equal (values-of db "fail -> X = a ; X = b." "?X") '("b"))
           "else is visited if condition fails")
    (check (null (results db "true -> fail ; true."))
           "after successful condition, failed then does not visit else")
    (check (equal (values-of db "once(prefix(X))." "?X") '("a"))
           "top-level once")
    (check (equal (values-of db "call(prefix(X))." "?X") '("a" "b" "c"))
           "top-level meta call")
    (check (results db "\\+ (prefix(z)).") "top-level negation")
    (check (rejected db "!") "top-level cut requires explicit query choice barrier")
    (check (rejected db "call(!)") "cut through meta-call is not silently misinterpreted")
    (check (rejected db "catch(true, _, true)") "exceptions remain explicitly unsupported")
    (format t "~D ISO control checks passed.~%" *checks*)))
(main)
