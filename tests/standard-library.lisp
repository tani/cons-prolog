(defpackage #:sprolog/tests/standard-library (:use #:cl #:sprolog/tests/let))
(in-package #:sprolog/tests)

(defun run-standard-library-tests ()
  (let ((*database* (make-database)))
    (dolist (entry '((nonvar . 1) (number . 1) (callable . 1) (ground . 1)
                     (once . 1) (repeat . 0) (|\\+| . 1) (|\\=| . 2) (|\\==| . 2)))
      (check (not (sprolog::iso-primitive-p (car entry) (cdr entry))) "derived dispatch")
      (check (sprolog::standard-predicate (car entry) (cdr entry)) "compiled base library"))
    (dolist (gc '(nil 1 8 4096))
      (check (= 1000 (length (query '((repeat)) :limit 1000 :gc-threshold gc)))
             "repeat runs on VM stack")
      (check (query '((or (and (once (or (= ?x a) (= ?x b))) fail) (= ?x c)))
                    :gc-threshold gc) "once cut preserves caller choices")
      (check (query '((/= (f ?x ?x) (f a b)) (var ?x)) :gc-threshold gc)
             "partial trial bindings roll back")
      (check (query '((atomic 1/2)) :gc-threshold gc) "Lisp rational atomic")
      (check (query '((atomic #C(1 2))) :gc-threshold gc) "Lisp complex atomic"))
    (check (iso-error-p '((assertz (once a))) "permission_error"))
    (check (iso-error-p '((abolish (/ /+ 1))) "permission_error"))
    (check (iso-error-p '((clause (nonvar ?x) ?body)) "permission_error"))
    (clear-database)
    (check (query '((nonvar a) (call /+ fail))) "clear preserves base library")
    (check (not (query '((current_predicate (/ nonvar 1))))) "base library remains private")))
