(in-package #:cl-user)
(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<)) (n (length sorted)))
    (if (oddp n) (nth (floor n 2) sorted)
        (/ (+ (nth (1- (/ n 2)) sorted) (nth (/ n 2) sorted)) 2))))
(let ((groups (make-hash-table :test 'equal)) (order nil))
  (with-open-file (stream "benchmarks/results/baseline.sexp")
    (loop for row = (read stream nil nil) while row do
      (let ((name (getf row :case)))
        (unless (gethash name groups) (push name order))
        (push row (gethash name groups)))))
  (with-open-file (stream "benchmarks/results/baseline.csv" :direction :output :if-exists :supersede)
    (format stream "case,compile_ms,run_ms,export_ms,run_min_ms,run_max_ms,compile_MiB,run_MiB,export_MiB,host_gc_ms,max_managed_cells,vm_gc_count,answers~%")
    (dolist (name (nreverse order))
      (let* ((rows (gethash name groups)) (row (car rows))
             (stats (getf row :statistics)))
        (flet ((med (key) (median (mapcar (lambda (r) (getf r key)) rows))))
          (format stream "~A,~,3F,~,3F,~,3F,~,3F,~,3F,~,3F,~,3F,~,3F,~,3F,~D,~D,~D~%"
                  name (med :compile-ms) (med :run-ms) (med :export-ms)
                  (reduce #'min rows :key (lambda (r) (getf r :run-ms)))
                  (reduce #'max rows :key (lambda (r) (getf r :run-ms)))
                  (/ (med :compile-bytes) 1048576d0) (/ (med :run-bytes) 1048576d0)
                  (/ (med :export-bytes) 1048576d0) (med :host-gc-ms)
                  (getf stats :max-heap-cells) (getf stats :gc-count) (getf row :answers)))))))
(when (probe-file "benchmarks/results/diagnostics.sexp")
  (let ((groups (make-hash-table :test 'equal)) (order nil))
    (with-open-file (stream "benchmarks/results/diagnostics.sexp")
      (loop for row = (read stream nil nil) while row do
        (let ((key (list (getf row :variant) (getf row :case))))
          (unless (gethash key groups) (push key order))
          (push row (gethash key groups)))))
    (with-open-file (stream "benchmarks/results/diagnostics.csv" :direction :output :if-exists :supersede)
      (format stream "variant,case,run_ms,run_MiB~%")
      (dolist (key (nreverse order))
        (let ((rows (gethash key groups)))
          (format stream "~A,~A,~,3F,~,3F~%" (first key) (second key)
                  (median (mapcar (lambda (r) (getf r :run-ms)) rows))
                  (/ (median (mapcar (lambda (r) (getf r :run-bytes)) rows)) 1048576d0)))))))
