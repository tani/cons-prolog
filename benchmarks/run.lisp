(require :asdf)
(asdf:load-asd (merge-pathnames "../cons-prolog.asd" *load-truename*))
(asdf:load-system "cons-prolog")
(defpackage #:cons-prolog/bench (:use #:cl #:prolog))
(in-package #:cons-prolog/bench)

(defstruct bench-case name goals (gc 4096) all expected)
(defun setup-cases ()
  (clear-database)
  (<-- (host-down 0) !)
  (<- (host-down ?n) (lispp (plusp ?n)) (lisp ?m (1- ?n)) (host-down ?m))
  (<-- (arith-down 0) !)
  (<- (arith-down ?n) (> ?n 0) (is ?m (- ?n 1)) (arith-down ?m))
  (<-- (let-down 0) !)
  (<- (let-down ?n) (lispp (plusp ?n)) (let next (1- ?n)) (lisp ?m next) (let-down ?m))
  (<-- (walk ()))
  (<- (walk (? . ?tail)) (walk ?tail))
  (<-- (discard ?))
  (<-- (waste 0) !)
  (<- (waste ?n) (lispp (plusp ?n)) (discard (payload ?n (nested ?n)))
      (lisp ?m (1- ?n)) (waste ?m))
  (<-- (append () ?ys ?ys))
  (<- (append (?x . ?xs) ?ys (?x . ?zs)) (append ?xs ?ys ?zs))
  (---> (many) '(a) (many)) (--> (many))
  (table 'path 2)
  (<-- (path ?x ?y) (path ?x ?z) (edge ?z ?y))
  (<- (path ?x ?y) (edge ?x ?y))
  (dotimes (i 1000) (cons-prolog/src/syntax/compiler:add-clause (list 'edge i (1+ i)) nil nil))
  (loop for name in '(fact) do
    (dotimes (i 1000) (cons-prolog/src/syntax/compiler:add-clause (list name i) nil nil)))
  (<-- (fact-scan 0) !)
  (<- (fact-scan ?n) (fact 999) (lisp ?m (1- ?n)) (fact-scan ?m))
  (let ((items (make-list 10000 :initial-element 'a))
        (large (make-list 100000 :initial-element 'a)))
    (list
      (make-bench-case :name "host-tail-100k" :goals '((host-down 100000)))
      (make-bench-case :name "arith-tail-100k" :goals '((arith-down 100000)))
      (make-bench-case :name "let-tail-100k" :goals '((let-down 100000)))
      (make-bench-case :name "walk-10k" :goals (list (list 'walk items)))
      (make-bench-case :name "append-10k" :goals (list (list 'append items nil '?out)))
      (make-bench-case :name "unify-100k" :goals (list (list '= '?out large)))
      (make-bench-case :name "dcg-10k" :goals (list (list 'phrase '(many) items)))
      (make-bench-case :name "waste-50k-gc64" :gc 64 :goals '((waste 50000)))
      (make-bench-case :name "waste-50k-gc4096" :goals '((waste 50000)))
      (make-bench-case :name "waste-50k-no-gc" :gc nil :goals '((waste 50000)))
      (make-bench-case :name "fact-last-1000x1000" :goals '((fact-scan 1000)))
      (make-bench-case :name "slg-path-1000" :goals '((path 0 ?out)) :all t :expected 1000)
      (make-bench-case :name "append-all-1000" :goals (list (list 'append '?left '?right (subseq items 0 1000)))
                       :all t :expected 1001))))
(defun milliseconds (ticks) (* 1000.0d0 (/ ticks internal-time-units-per-second)))
(defun export-answer (vm)
  (let ((names (make-hash-table :test 'eq)))
    (mapcar (lambda (entry) (cons (car entry) (cons-prolog/src/kernel/engine:reify (cdr entry) names)))
            (cons-prolog/src/kernel/model:machine-variables vm))))
(defun run-case (case &optional report)
  (sb-ext:gc :full t)
  (let* ((t0 (get-internal-real-time)) (b0 (sb-ext:get-bytes-consed)) (g0 sb-ext:*gc-run-time*)
         (vm (make-query (bench-case-goals case) :gc-threshold (bench-case-gc case)))
         (t1 (get-internal-real-time)) (b1 (sb-ext:get-bytes-consed))
         (count 0) stats)
    (unwind-protect
         (progn
           (if (bench-case-all case)
               (loop while (nth-value 1 (next-solution vm)) do (incf count))
               (unless (cons-prolog/src/kernel/engine:run-machine vm) (error "Benchmark failed: ~A" (bench-case-name case))))
           (let ((t2 (get-internal-real-time)) (b2 (sb-ext:get-bytes-consed)))
             (unless (bench-case-all case) (export-answer vm))
             (setf stats (query-statistics vm))
             (when (bench-case-expected case)
               (unless (= count (bench-case-expected case)) (error "Wrong answer count: ~D" count)))
             (let* ((t3 (get-internal-real-time)) (b3 (sb-ext:get-bytes-consed))
                    (row (list :case (bench-case-name case) :compile-ms (milliseconds (- t1 t0))
                               :run-ms (milliseconds (- t2 t1)) :export-ms (milliseconds (- t3 t2))
                               :compile-bytes (- b1 b0) :run-bytes (- b2 b1) :export-bytes (- b3 b2)
                               :host-gc-ms (milliseconds (- sb-ext:*gc-run-time* g0))
                               :answers (if (bench-case-all case) count 1) :statistics stats)))
               (when report (format t "~S~%" row) (finish-output)) row)))
      (close-query vm))))
(defvar *cases* (setup-cases))
(defun benchmark-main ()
  (let ((path (or (sb-ext:posix-getenv "BENCH_RESULTS") "benchmarks/results/baseline.sexp")))
    ;; Warm each workload once, then record five isolated runs in rotating order.
    (dolist (case *cases*) (run-case case))
    (with-open-file (stream path :direction :output :if-exists :supersede)
      (let ((*print-pretty* nil))
        (dotimes (iteration 5)
          (dolist (case (if (evenp iteration) *cases* (reverse *cases*)))
            (let ((row (run-case case t)))
              (format stream "~S~%" (list* :iteration iteration row)) (finish-output stream))))))))
(unless (sb-ext:posix-getenv "BENCH_LOAD_ONLY") (benchmark-main))
