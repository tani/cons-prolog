;; Benchmark-only substitutions. None are installed in the production runtime.
(load (merge-pathnames "run.lisp" *load-truename*))
(in-package #:sprolog/bench)
(defvar *original-unify* (symbol-function 'sprolog/src/kernel/engine:unify))
(defvar *original-map* (symbol-function 'sprolog/src/kernel/engine:map-term))
(defvar *original-resolve* (symbol-function 'sprolog/src/kernel/engine:resolve-code))
(defun scalar-unify (vm left right)
  (let ((a (sprolog/src/kernel/engine:deref left)) (b (sprolog/src/kernel/engine:deref right)))
    (cond ((eq a b) t)
          ((sprolog/src/kernel/model:logic-var-p a)
           (if (and (sprolog/src/kernel/model:logic-var-p b) (< (sprolog/src/kernel/model:logic-var-id a) (sprolog/src/kernel/model:logic-var-id b)))
               (sprolog/src/kernel/engine:bind-var vm b a) (sprolog/src/kernel/engine:bind-var vm a b)) t)
          ((sprolog/src/kernel/model:logic-var-p b) (sprolog/src/kernel/engine:bind-var vm b a) t)
          ((and (consp a) (consp b)) (funcall *original-unify* vm a b))
          (t (sprolog/src/adapters/term-ops:iso-atomic-equal a b)))))
(defun scalar-map (root atom-function &optional allocator)
  (if (consp root) (funcall *original-map* root atom-function allocator)
      (let ((value (funcall atom-function root)))
        ;; Current internal scalar mappings are side-effect-free for bound cons roots.
        (if (consp value) (funcall *original-map* root atom-function allocator) value))))
(defvar *indexes* (make-hash-table :test 'eq))
(dolist (name '(edge fact))
  (let ((index (make-hash-table :test 'eql))
        (predicate (gethash (cons name (if (eq name 'edge) 2 1))
                            (sprolog/src/kernel/model:database-predicates *database*))))
    ;; This diagnostic has only unique, ground numeric heads, not general clauses.
    (dolist (clause (sprolog/src/kernel/model:predicate-clauses predicate))
      (setf (gethash (second (car clause)) index) (sprolog/src/syntax/compiler:compile-predicate (list clause))))
    (setf (gethash name *indexes*) index)))
(defun indexed-resolve (vm name arity)
  (let* ((index (gethash name *indexes*))
         (arg (and index (sprolog/src/kernel/engine:deref (aref (sprolog/src/kernel/model:machine-args vm) 0)))))
    (or (and index (integerp arg) (gethash arg index))
        (funcall *original-resolve* vm name arity))))
(defun select-substitutions (variant)
  (setf (symbol-function 'sprolog/src/kernel/engine:unify)
        (if (member variant '("scalar-unify" "both") :test #'equal) #'scalar-unify *original-unify*)
        (symbol-function 'sprolog/src/kernel/engine:map-term)
        (if (member variant '("scalar-map" "both") :test #'equal) #'scalar-map *original-map*)
        (symbol-function 'sprolog/src/kernel/engine:resolve-code)
        (if (equal variant "numeric-index") #'indexed-resolve *original-resolve*)))
(unwind-protect
     (let ((*print-pretty* nil))
       (with-open-file (stream "benchmarks/results/diagnostics.sexp" :direction :output :if-exists :supersede)
         (dolist (variant '("baseline" "scalar-unify" "scalar-map" "both" "numeric-index"))
           (select-substitutions variant)
           (dolist (name (if (equal variant "numeric-index") '("fact-last-1000x1000" "slg-path-1000")
                            '("host-tail-100k" "let-tail-100k" "waste-50k-gc4096")))
             (let ((case (find name *cases* :key #'bench-case-name :test #'equal)))
               (run-case case)
               (dotimes (iteration 5)
                 (let ((row (list* :variant variant :iteration iteration (run-case case))))
                   (format stream "~S~%" row) (finish-output stream)))))
           (format t "~A complete~%" variant) (finish-output))))
  (select-substitutions "baseline"))
